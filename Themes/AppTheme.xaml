<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:CameywareOrder.Localization"
                    xmlns:ctrl="clr-namespace:CameywareOrder.Controls">
    <ResourceDictionary.MergedDictionaries>
        <!-- Merged HERE rather than in App.xaml so that anything pulling in the theme gets the flags
             with it — the assertion harnesses merge this one dictionary by hand, and a picker whose
             flag resource resolved only inside the running app would throw in every one of them.

             The URI is ABSOLUTE, naming this assembly, and that is load-bearing. A relative
             "/Themes/Flags.xaml" resolves against the application that is LOADING the dictionary, not
             the assembly that declares it — so the moment a harness exe merged this file it went
             looking for Themes/Flags.xaml inside ITSELF and threw "Cannot locate resource" before a
             single window opened. -->
        <ResourceDictionary Source="pack://application:,,,/CameywareOrder;component/Themes/Flags.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- The application's single visual language, merged in App.xaml so every window inherits it.
         Three copies of a button template drift, and they drift silently — nothing fails when only
         two of them get a fix.

         WHAT LIVES HERE: the palette, implicit styles for the controls every screen uses, and the
         keyed card/label/heading styles the forms are built from. A window that needs a variant
         should base its own style on one of these, never restate the colours.

         WHAT DOES NOT: anything that encodes MEANING rather than chrome. Balance-status colours
         (green / orange / red) and the refunded-order strike are deliberately left as literals at
         their use sites — re-theming must never quietly change what a colour tells the user. -->

    <!-- ══ Palette ══════════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryColor">#FF4F46E5</Color>
    <Color x:Key="PrimaryDarkColor">#FF4338CA</Color>
    <Color x:Key="AccentColor">#FF7C3AED</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#FFEEF2FF"/>
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="#FFC7D2FE"/>
    <SolidColorBrush x:Key="PrimaryHoverBorderBrush" Color="#FFA5B4FC"/>
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#FF3730A3"/>

    <!-- The header band every top-level screen wears. -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF4F5F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FFF9FAFB"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE5E7EB"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFD1D5DB"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#FFF3F4F6"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF111827"/>
    <SolidColorBrush x:Key="TextBodyBrush" Color="#FF374151"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6B7280"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9CA3AF"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnHeaderSubtleBrush" Color="#FFDDD6FE"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#FFB91C1C"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFFCA5A5"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFEE2E2"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF047857"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FFD1FAE5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF92400E"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFEF3C7"/>

    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFF3F4F6"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF9CA3AF"/>

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>

    <!-- ══ Type ═════════════════════════════════════════════════════════════════════════════
         ONE family and SIX sizes for the whole application. An audit found seventeen sizes in use,
         including 11.5 / 12.5 / 13.5 — differences too small to read as intent and too many to keep
         straight, so the same kind of label ended up a different size on two screens.

         Latin first, CJK second: WPF walks this list per glyph, so Segoe UI renders the Latin and
         Microsoft YaHei UI the Chinese, the same way on an English and a Chinese Windows. Left to the
         system default the two locales pick different fonts for the same screen — and the printed
         receipt already pins Segoe UI, so the app disagreed with its own output. -->
    <!-- THREE families, one per job:
         · AppFontFamily     — everything a person reads as prose or a label.
         · NumericFontFamily — figures that sit in a column and get compared: money, order numbers,
           counts, dates. Same face, but the styles below switch on TABULAR numerals so every digit
           takes the same width and the decimal points line up down the list. Proportional digits
           are what makes a column of prices look ragged.
         · IconFontFamily    — the Segoe MDL2 glyph set. Named here so a screen never hard-codes it
           and nobody has to remember which of the two font names it is. -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="NumericFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeCaption" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizePageTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>

    <!-- Off the scale above on purpose. A date drop-down is a GRID of ~40 numbers read at a glance
         and clicked at, not a paragraph, so it is sized like a control surface rather than like body
         text. Named rather than spelled into the three calendar styles that use it so they cannot
         drift apart, and kept moderate: the panel grows sideways, not down, so this has to stay
         comfortable inside a row height that did not change. -->
    <sys:Double x:Key="FontSizeCalendar" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>

    <!-- Inherited by everything in a window that does not say otherwise. -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- ══ Buttons ══════════════════════════════════════════════════════════════════════════
         Built as a template rather than Background setters: the WPF default button chrome paints
         its own gradient over any Background you set, and hover reverts to the system blue. -->
    <Style x:Key="ThemedButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every plain Button in the app picks the shape up. -->
    <Style TargetType="Button" BasedOn="{StaticResource ThemedButton}"/>

    <!-- A ToolBar substitutes its OWN button style for its children, so the implicit style above
         never reaches them. Re-pointing the toolbar's key is what puts the theme on the toolbar. -->
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
        <Setter Property="Margin" Value="2"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,8"/>
    </Style>

    <!-- Irreversible actions are the one control that does not look like the others. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- Sits on a coloured header band, so it is outlined rather than filled. -->
    <Style x:Key="OnHeaderButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ThemedToggleButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Text inputs ══════════════════════════════════════════════════════════════════════
         Templated for the rounded corner (TextBox has no CornerRadius) and so focus can show the
         primary colour instead of the system blue. -->
    <Style x:Key="ThemedTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <!-- A read-only box must read as locked, not merely as a box that ignores
                             you. The app uses IsReadOnly (not IsEnabled) wherever a value has to
                             stay selectable and copyable. -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}"/>

    <Style x:Key="ThemedPasswordBox" TargetType="PasswordBox">
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource ThemedPasswordBox}"/>

    <!-- ══ Drop-downs ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}" Margin="3,1" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ThemedComboBoxItem}"/>

    <!-- Borderless inner editor for an editable ComboBox: the rounded chrome belongs to the combo,
         so the text box must not draw a second border inside it. -->
    <Style x:Key="ComboBoxEditor" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full template this time, covering the two things that made the first attempt a regression:
           * IsEditable — the branding editor's font-size box needs a PART_EditableTextBox, and a
             template without one silently stops accepting typed input;
           * the selection FACE and `DisplayMemberPath`. THE PART THAT IS EASY TO MISS: a ComboBox
             does NOT turn DisplayMemberPath into `SelectionBoxItemTemplate` — `ItemsControl`
             installs an internal template SELECTOR instead, so the face must bind
             `ContentTemplateSelector` to `ItemTemplateSelector` as well. Without it the face falls
             back to ToString() and renders "LanguageOption { Code = …, Name = English }". The stock
             template does exactly this; two earlier attempts here did not, and looked broken. -->
    <!-- Bindings use RelativeSource rather than TemplateBinding on purpose: a TemplateBinding
         re-resolves against the nearest templated parent, which is the wrong element for anything
         nested inside the ToggleButton's own template. -->
    <Style x:Key="ThemedComboBox" TargetType="ComboBox">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Behind everything and full size, so a click anywhere on the face opens
                             the list (except over the editable box, which takes its own input). -->
                        <ToggleButton x:Name="PART_ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,11,0" Width="9" Height="5" Stretch="Fill"
                                              Data="M 0 0 L 4.5 5 L 9 0"
                                              Fill="{StaticResource TextMutedBrush}" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Face" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>

                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboBoxEditor}"
                                 Margin="{TemplateBinding Padding}" Visibility="Collapsed"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, ElementName=PART_ToggleButton}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,8" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Color="#FF111827"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Face" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}"/>

    <!-- A time of day, with a clock so the field reads as a time at a glance rather than as one
         more anonymous drop-down. Same behaviour as a ComboBox — only the face changes. -->
    <Style x:Key="TimePickerComboBox" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryDeepBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{StaticResource PrimarySoftBrush}"
                                            BorderBrush="{StaticResource PrimaryMutedBrush}"
                                            BorderThickness="1" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Clock: a ring and two hands. -->
                                            <Canvas Grid.Column="0" Width="16" Height="16" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Ellipse Width="13.5" Height="13.5" Canvas.Left="1.2" Canvas.Top="1.2"
                                                         Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.4"/>
                                                <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 8 4.6 L 8 8.2 L 10.6 9.8"/>
                                            </Canvas>

                                            <ContentPresenter Grid.Column="1" Margin="8,7,6,7" VerticalAlignment="Center"/>

                                            <Path Grid.Column="2" Data="M 0 0 L 4.5 5 L 9 0" Width="9" Height="5"
                                                  Stretch="Fill" Margin="0,0,11,0" VerticalAlignment="Center"
                                                  Fill="{StaticResource PrimaryBrush}" SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <ContentPresenter
                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource PrimaryMutedBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, ElementName=PART_ToggleButton}"
                                    MaxHeight="260" Margin="0,4,0,8" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#FF4F46E5"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Date picker ══════════════════════════════════════════════════════════════════════
         The stock watermark ("Select a date") comes from PresentationFramework's own resources and
         stays English whatever the app language is, so it is replaced here with a string-table
         value. The calendar's month and day names follow FrameworkElement.Language, which each
         window carrying a picker sets from the current UI language. -->
    <Style x:Key="ThemedDatePickerTextBox" TargetType="DatePickerTextBox">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                        <TextBlock x:Name="Watermark" IsHitTestVisible="False" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Common.SelectDate], Mode=OneWay}"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The stock template keys its watermark off this same part name. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource ThemedDatePickerTextBox}"/>

    <Style x:Key="ThemedDatePicker" TargetType="DatePicker">
        <Setter Property="MinHeight" Value="38"/>
        <!-- DatePicker BINDS its Calendar.Style to this property, and a bound null Style suppresses
             implicit lookup entirely — which is why the themed Calendar style never applied until it
             was named here. Same reason CalendarDayButtonStyle has to be set on the Calendar style. -->
        <Setter Property="CalendarStyle" Value="{DynamicResource ThemedCalendar}"/>
        <Setter Property="ctrl:CalendarSizing.MatchOwnerWidth" Value="True"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Chrome" CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Margin="{TemplateBinding Padding}"
                                               Focusable="{TemplateBinding Focusable}"/>

                            <!-- Calendar glyph doubles as the drop-down button. -->
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Margin="0,0,6,0" Padding="6" Background="Transparent"
                                    BorderBrush="Transparent" Cursor="Hand">
                                <Canvas Width="16" Height="16">
                                    <Border Width="14" Height="12.5" Canvas.Left="1" Canvas.Top="2.2"
                                            CornerRadius="2" BorderThickness="1.4"
                                            BorderBrush="{StaticResource PrimaryBrush}"/>
                                    <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          Data="M 1 6.2 L 15 6.2 M 5 1 L 5 3.4 M 11 1 L 11 3.4"/>
                                </Canvas>
                            </Button>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Chrome}" StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBackgroundBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource ThemedDatePicker}"/>

    <!-- Calendar: recoloured and resized, but NOT re-templated — the month/year/decade navigation is
         intricate and works. The stock panel is ~185px of 10pt text, which reads as an afterthought
         next to the rest of the app.

         WIDTH: bound to the DatePicker that owns it, so the drop-down is exactly as wide as the box
         it belongs to. The Calendar is created in code and lives inside a Popup — a separate visual
         tree — so the binding walks out through the Popup's LOGICAL parent to reach the DatePicker.
         It resolves; if a future WPF change breaks it the binding fails silently to the natural
         width, and the harness's binding-error count is what catches that.

         HEIGHT, and only height: the drop-down is sized up by the day cells and the type, never by a
         ScaleTransform on the Calendar. A transform would double the WIDTH too, and the width is the
         one dimension already spoken for — it is bound to the box the drop-down belongs to. Nor is a
         MinWidth set on the day buttons: the day grid's columns are star-sized inside that bound
         width, so a fixed cell width would overflow and clip on the narrower pickers in Store
         Members while looking fine on the wide one in the order editor. -->
    <Style x:Key="ThemedCalendar" TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <!-- Set EXPLICITLY, not left to the implicit style: Calendar hands each day button whatever
             CalendarDayButtonStyle holds, so relying on the implicit lookup left the stock grey
             selection in place. DynamicResource because the style is declared further down. -->
        <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource ThemedCalendarDayButton}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCalendar}"/>
    </Style>

    <Style TargetType="Calendar" BasedOn="{StaticResource ThemedCalendar}"/>

    <Style TargetType="CalendarItem">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCalendar}"/>
    </Style>

    <!-- The one part of the calendar worth re-templating: the stock day button paints its selection
         in the system grey-blue, which is the only place the app still looked like stock WPF.
         The month/year navigation above it is left alone — it is intricate and it works. -->
    <Style x:Key="ThemedCalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCalendar}"/>
        <!-- WIDE, not tall. The month grid is content-sized rather than stretched, so a day cell
             was only about as wide as its two digits; MinWidth is what actually opens the panel out,
             and it is set to twice that. The row height is left where it was — a calendar that gets
             taller as well pushes the drop-down past the bottom of the window on a small screen. -->
        <Setter Property="MinWidth" Value="58"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Margin="1"
                            BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                        <!-- The wrapper sizes itself to the DIGITS, which is what gives the blackout
                             bar below the width of the number rather than of the whole cell. -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- The stock day button draws a strike for a blacked-out day; this
                                 template replaces the stock one, so it has to draw it too. Without
                                 it an unavailable day is merely grey — near enough to the grey of a
                                 day spilling in from a neighbouring month, which IS selectable.
                                 A horizontal rule rather than the stock diagonal: at this cell size
                                 a corner-to-corner line reads as a stroke across the whole panel. -->
                            <Border x:Name="Blackout" Height="1.6" Margin="-3,0,-3,0"
                                    VerticalAlignment="Center" IsHitTestVisible="False"
                                    Background="{StaticResource DisabledForegroundBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Days spilling in from the neighbouring month: present, but not competing. -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                        </Trigger>
                        <!-- Selection last, so it wins over hover and today. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                            <Setter TargetName="Blackout" Property="Visibility" Value="Visible"/>
                            <Setter Property="IsEnabled" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarDayButton" BasedOn="{StaticResource ThemedCalendarDayButton}"/>

    <!-- The month and year buttons in the drill-up views. Sized with the day buttons — four columns
         against seven, so the same panel width divides into wider cells — because dropping from days
         to months must not resize the panel it is inside. -->
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCalendar}"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ══ Selection controls: recoloured, NOT re-templated ═════════════════════════════════
         The order editor drives dozens of radios and checkboxes through code (payment methods,
         cleared flags, the not-applicable strike) and swaps templates on some of them. Restyling
         the box itself here would fight that; only the text follows the theme. -->
    <!-- ══ Checkboxes ═══════════════════════════════════════════════════════════════════════
         The radio's twin, and drawn the same way for the same reason: these two sit next to each
         other on the payment cards ("deposit received", "clear all balances"), so a themed radio
         beside a stock checkbox reads as an unfinished screen.

         Square rather than round, with a drawn tick — the difference in SHAPE is what tells a user
         "one of these" from "any of these", so the two templates deliberately share their colours and
         their states while keeping their outlines distinct. -->
    <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Padding" Value="9,0,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Halo" Width="26" Height="26" CornerRadius="6"
                                    Background="{StaticResource PrimarySoftBrush}" Opacity="0"/>
                            <Border x:Name="Box" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{TemplateBinding Background}"/>
                            <!-- Drawn rather than a glyph: Segoe MDL2 is not on every machine this
                                 ships to, and a missing tick is indistinguishable from an unticked box. -->
                            <Path x:Name="Tick" Width="11" Height="9" Stretch="Uniform" Opacity="0"
                                  Stroke="{StaticResource TextOnPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 0,4.5 L 3.6,8 L 10,1"/>
                            <!-- The indeterminate state, which the "clear all balances" master uses. -->
                            <Rectangle x:Name="Dash" Width="9" Height="2" RadiusX="1" RadiusY="1"
                                       Fill="{StaticResource TextOnPrimaryBrush}" Opacity="0"/>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Dash" Property="Opacity" Value="1"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                            <Setter TargetName="Halo" Property="Background" Value="{StaticResource PrimaryMutedBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DisabledBackgroundBrush}"/>
                            <Setter TargetName="Tick" Property="Stroke" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="Dash" Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="Halo" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>

                        <!-- A ticked box that is disabled keeps its fill, or a confirmed payment reads
                             as one nobody ever confirmed. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryMutedBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryMutedBrush}"/>
                            <Setter TargetName="Tick" Property="Stroke" Value="{StaticResource SurfaceBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource ThemedCheckBox}"/>

    <!-- ══ Radios ═══════════════════════════════════════════════════════════════════════════
         The stock WPF radio is a small grey ring with a black dot and no hover state at all, which
         made a row of payment methods read as static text until one was clicked. This one is drawn:
         a ring that answers the pointer, a brand-coloured dot on selection, and a disabled state that
         says "locked" rather than "faded".

         Keyed AND implicit, like ThemedTextBox below it. That is not decoration: a keyed style with a
         TargetType does NOT inherit the implicit one, so every keyed variant in the application (the
         payment-method rows, the split toggles) must say BasedOn — and would silently keep the stock
         template if it did not. -->
    <Style x:Key="ThemedRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Padding" Value="9,0,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Transparent background on the root so the whole row is a hit target, not just
                         the 18px ring — a radio you have to hit precisely is the commonest complaint
                         about this control. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <!-- A soft halo behind the ring, revealed on hover and focus. It sits
                                 OUTSIDE the ring rather than tinting its fill, so the control never
                                 looks half-selected while the pointer is merely passing over. -->
                            <Ellipse x:Name="Halo" Width="26" Height="26" Fill="{StaticResource PrimarySoftBrush}"
                                     Opacity="0"/>
                            <Ellipse x:Name="Ring" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"
                                     Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource PrimaryBrush}"
                                     Opacity="0"/>
                        </Grid>

                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryDarkBrush}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PrimaryDarkBrush}"/>
                        </MultiTrigger>

                        <!-- Keyboard focus only. A mouse click would otherwise leave a ring behind on
                             every radio the user merely clicked, which reads as a second selection. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                            <Setter TargetName="Halo" Property="Fill" Value="{StaticResource PrimaryMutedBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BorderBrush}"/>
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource DisabledBackgroundBrush}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="Halo" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource ThemedRadioButton}"/>

    <!-- ══ Menus ════════════════════════════════════════════════════════════════════════════
         ONE template for every MenuItem role. The stock style swaps between four templates by Role,
         so a single Template setter has to cover them all — the differences (submenu arrow, popup
         placement) are handled by the Role triggers at the bottom rather than by separate styles. -->
    <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="3,1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                                <!-- Only a submenu header shows it; see the Role trigger below. -->
                                <Path x:Name="Arrow" Grid.Column="2" Data="M 0 0 L 4 3.5 L 0 7" Width="4" Height="7"
                                      Stretch="Fill" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.3"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right"
                               HorizontalOffset="-6" VerticalOffset="-6" Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="0,5" Margin="6,4,10,10" MinWidth="170" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#FF111827"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-6"/>
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="2"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem" BasedOn="{StaticResource ThemedMenuItem}"/>


    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
    </Style>

    <!-- Destructive entries. The stock highlight washes the one item you most want to hesitate over
         into the same colour as its harmless neighbours, so the red is stated at rest AND kept on
         hover. The hover setter has to live in Style.Triggers rather than the template: style
         triggers outrank template triggers, which is the only way to beat ThemedMenuItem's own
         IsHighlighted setter without copying its whole template to change one brush. -->
    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource ThemedMenuItem}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Context menus ════════════════════════════════════════════════════════════════════
         Given the same skin as the submenu popups above — same surface, same 8px radius, same
         shadow — because a right-click menu and a menu-bar submenu are the same object to the
         person using them, and until now they visibly were not.

         Templated rather than merely recoloured: the stock ContextMenu wraps its items in a
         square-cornered Border behind a legacy offset-rectangle "shadow", and no combination of
         property setters rounds that off.

         Grid.IsSharedSizeScope is load-bearing, not decoration. ThemedMenuItem puts its icon in a
         column with SharedSizeGroup="MenuIcon"; with no scope to share inside, every row measures
         its own gutter and the labels step in and out down the menu.

         The margin is deliberately asymmetric. A context menu opens AT the cursor, so padding the
         top and left would shove it away from the pointer; right and bottom get the room the 16px
         blur needs, top and left get just enough not to clip it. -->
    <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <!-- Stated, not inherited: a ContextMenu lives in its own popup, so leaving these to flow
             down from the Window style is not something to rely on. -->
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Padding" Value="0,5"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <!-- The template below draws its own shadow; this switches off the stock one so the two
             do not stack into a double edge. -->
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="8" MinWidth="190" Margin="3,3,12,12"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#FF111827"/>
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        SnapsToDevicePixels="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource ThemedContextMenu}"/>

    <!-- Used in toolbars and panels, where it stays a plain hairline. Separators inside a MENU do
         not arrive here — see the keyed style below. -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>

    <!-- A Separator inside a menu never picks up the implicit style above, and does so silently:
         MenuItem's container preparation calls SetResourceReference(StyleProperty,
         MenuItem.SeparatorStyleKey) on it, and a resource reference is a LOCAL value — which
         outranks every implicit style. Answering to that key is the only way to reach it.
         Inset past the icon gutter so the rule reads as dividing the labels, not the whole slab. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="11,5"/>
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Cards and typography ═════════════════════════════════════════════════════════════ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="MutedCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
    </Style>

    <Style x:Key="AccentCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryMutedBrush}"/>
    </Style>

    <!-- ══ Semantic text styles ═════════════════════════════════════════════════════════════
         Screens should say WHAT a piece of text is, not how big it is. Every style below sets size,
         weight and colour together, because those three are what make a role recognisable — a
         12pt grey label and a 12pt black value are different things and should not be written the
         same way. Reach for a raw FontSize only when none of these fits, and if that happens twice,
         add a style here instead. -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
    </Style>

    <!-- A stored value, as opposed to the label naming it. -->
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <!-- Figures meant to be compared down a column. Tabular numerals give every digit the same
         advance width, so decimal points and order numbers line up instead of drifting. -->
    <Style x:Key="NumericText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="MoneyText" TargetType="TextBlock" BasedOn="{StaticResource NumericText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ONE line, ellipsized, for any cell in a records list.

         Every column in the orders list is built from this or from NumericCellText below it, and
         the reason is row height: a cell that wraps makes its own row taller than the rest, so a
         list that is meant to be scanned down a column stops lining up. Overflow is answered with
         "…" and the full value in the tooltip rather than with a second line.

         NO size and NO colour, deliberately: a row takes its size from the font-size slider and its
         colour from the gray-out trigger for completed and refunded orders. Setting either here
         would override both. -->
    <Style x:Key="ListCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- The same, plus the tabular treatment that lets figures be compared down a column. -->
    <Style x:Key="NumericCellText" TargetType="TextBlock" BasedOn="{StaticResource ListCellText}">
        <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Segoe MDL2 glyph. Screens reference this instead of naming the font. -->
    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CardHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Wraps, because a field label is translated: "Cancellation / Return Reason" is one word in
         Chinese and three lines in French, and a label column sized for the short reading clips the
         long one. Wrapping only bites where the PARENT imposes a width — see the DockPanel note in
         context.md — so the label blocks that use this dock their icon rather than stacking it. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ══ List rows ════════════════════════════════════════════════════════════════════════
         The whole row is the hit target, and the selected one reads as an accent rather than the
         system highlight colour. -->
    <Style x:Key="RosterCardContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="11,9" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                            <Setter TargetName="Card" Property="Padding" Value="10,8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
