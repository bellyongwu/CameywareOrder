<Window x:Class="CameywareOrder.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CameywareOrder.Converters"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:model="clr-namespace:CameywareOrder.Models"
    Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.NewTitle], Mode=OneWay}" Height="1160" Width="1240"
        WindowStartupLocation="CenterOwner"
    MinHeight="900"
    MinWidth="1040"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:LocalizationLookupConverter x:Key="LocalizationLookupConverter"/>
        <conv:CustomMadeRecordSummaryConverter x:Key="CustomMadeRecordSummaryConverter"/>

        <!-- Locked inputs (IsReadOnly) look grayed out like a disabled box. -->
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#808080"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "Not applicable" checkbox for refunded (cancelled/returned) orders: the box
             and label turn red. The strikethrough LINE itself is NOT drawn here — see
             NotApplicableCheckBoxStrike below and its usages, which bind Width to this
             checkbox's own ActualWidth via ElementName so it only ever spans the box +
             label, never the whole row (a Line with Stretch="Fill" inside this template
             used to measure itself against the available width of the whole row instead
             of the checkbox's own content, which is what made the strike span too wide). -->
        <Style x:Key="NotApplicableCheckBox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="15" Height="15" CornerRadius="2"
                                        BorderBrush="#C62828" BorderThickness="1.5" Background="#FDECEA"
                                        VerticalAlignment="Center"/>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="#C62828">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay "strike" line for a not-applicable checkbox. Placed as a sibling of the
             checkbox inside a shared wrapper Grid (see usages), with Width bound to that
             checkbox's ActualWidth — an explicit numeric Width is measured/arranged at
             exactly that size regardless of how much room the row offers, unlike
             Stretch="Fill" which inflates to the available width. Toggled by
             OrderEditWindow.ApplyNotApplicableCheckboxStyle alongside the Style swap above. -->
        <Style x:Key="NotApplicableCheckBoxStrike" TargetType="Border">
            <Setter Property="Height" Value="1.5"/>
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Card container for a top-level form section. -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Highlighted card variant used for the order totals summary. -->
        <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
            <Setter Property="Background" Value="#F4F8FB"/>
            <Setter Property="BorderBrush" Value="#D3E1EC"/>
        </Style>

        <!-- Heading text for a section card. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Nested payment sub-card inside a service card. -->
        <Style x:Key="PaymentCard" TargetType="Border">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderBrush" Value="#E1E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Payment card title (sits next to the accent bar). -->
        <Style x:Key="PaymentTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Sub-step label (deposit / final payment method). -->
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#516074"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Payment method radio button. -->
        <Style x:Key="MethodRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- The tax rate is a store-wide rule, not a per-order figure, so it is shown as a fixed
             value rather than an input. Deliberately NOT a disabled TextBox: a greyed-out box
             invites clicking and reads as broken, where a plain bold value reads as settled. -->
        <Style x:Key="LockedRateBox" TargetType="Border">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="BorderBrush" Value="#DCE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="ToolTip" Value="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.TaxRateLocked], Mode=OneWay}"/>
        </Style>

        <Style x:Key="LockedRateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Thin horizontal divider between payment steps. -->
        <Style x:Key="StepDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E4E9F0"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <!-- Small print under the section total tax: one line per payment portion showing
             which method settled it and how much tax it carried. -->
        <Style x:Key="TaxBreakdownLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7A8698"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Small colored accent bar shown before a payment title. -->
        <Style x:Key="AccentBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Small glyph shown before a basic-info field label. -->
        <Style x:Key="FieldIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2980B9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Basic-info field label (paired with a FieldIcon glyph). -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#3B4859"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.NewTitle], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FormRoot">
                <Border Style="{StaticResource SectionCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.BasicInfo], Mode=OneWay}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,8">
                                <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE8EC;"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderNumber], Mode=OneWay}"/>
                            </StackPanel>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="OrderNumberBox" Margin="0,8,14,8" Padding="6,4"/>

                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,8">
                                <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE7C1;"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Status], Mode=OneWay}"/>
                            </StackPanel>
                            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="StatusBox" Margin="0,8" Padding="6,4" SelectionChanged="OnStatusChanged">
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Status.Processing], Mode=OneWay}" Tag="{x:Static model:OrderStatus.Processing}"/>
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Status.Shipped], Mode=OneWay}" Tag="{x:Static model:OrderStatus.Shipped}"/>
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Status.Completed], Mode=OneWay}" Tag="{x:Static model:OrderStatus.Completed}"/>
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Status.Cancelled], Mode=OneWay}" Tag="{x:Static model:OrderStatus.Cancelled}"/>
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Status.Returned], Mode=OneWay}" Tag="{x:Static model:OrderStatus.Returned}"/>
                            </ComboBox>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8">
                                <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE77B;"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.CustomerName], Mode=OneWay}"/>
                            </StackPanel>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CustomerNameBox" Margin="0,8,14,8" Padding="6,4"/>

                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,8">
                                <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE717;"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PhoneNumber], Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,8">
                                <TextBox x:Name="PhoneNumberBox" Padding="6,4" LostFocus="OnPhoneNumberBoxLostFocus"/>
                                <TextBlock x:Name="PhoneErrorText" Foreground="#E74C3C" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8">
                                <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE715;"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Email], Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,14,8">
                                <TextBox x:Name="EmailBox" Padding="6,4" LostFocus="OnEmailBoxLostFocus"/>
                                <TextBlock x:Name="EmailErrorText" Foreground="#E74C3C" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,8" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE707;" Margin="0,2,6,0"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Address], Mode=OneWay}"/>
                            </StackPanel>
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="AddressBox" Margin="0,8" Padding="6,4"
                                     Height="68" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                            <StackPanel Grid.Row="4" Grid.Column="0" x:Name="StatusReasonLabelPanel" Orientation="Horizontal" Margin="0,10,0,8" VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE7C1;" Margin="0,2,6,0"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.StatusReason], Mode=OneWay}"/>
                            </StackPanel>
                            <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="StatusReasonCategoryBox" Margin="0,8" Padding="6,4"
                                      HorizontalAlignment="Left" MinWidth="260" Visibility="Collapsed" SelectionChanged="OnStatusReasonCategoryChanged">
                                <ComboBoxItem Tag="CustomerDoesNotWant" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ReturnReason.CustomerDoesNotWant], Mode=OneWay}"/>
                                <ComboBoxItem Tag="ServiceUnsatisfactory" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ReturnReason.ServiceUnsatisfactory], Mode=OneWay}"/>
                                <ComboBoxItem Tag="ProductIssue" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ReturnReason.ProductIssue], Mode=OneWay}"/>
                                <ComboBoxItem Tag="PriceTooHigh" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ReturnReason.PriceTooHigh], Mode=OneWay}"/>
                                <ComboBoxItem Tag="Other" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ReturnReason.Other], Mode=OneWay}"/>
                            </ComboBox>

                            <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="StatusReasonContainer" Margin="0,8" Visibility="Collapsed">
                                <TextBox x:Name="StatusReasonBox" Padding="6,4" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextChanged="OnStatusReasonTextChanged"/>
                                <TextBlock x:Name="StatusReasonHint" IsHitTestVisible="False" Foreground="#9FB0C0" Margin="9,7,0,0" VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Order totals summary -->
                <Border Style="{StaticResource SummaryCard}">
                    <!-- IsSharedSizeScope + SummaryLabel lets the code-built breakdown lines
                         below size their label column to this grid's, so their labels and
                         amounts line up with 全部服务总金额 and its figure. -->
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SummaryLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.AllServicesTotalAmount], Mode=OneWay}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalAmountText" FontWeight="Bold" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Which services make up the total above; filled in code-behind (needs the
                             live section totals and their category / garment detail). Spans the
                             label + amount columns so each line can align with the row above. -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ServicesTotalBreakdownPanel" Margin="0,0,0,6"/>

                        <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Margin="0,4" HorizontalAlignment="Left">
                                <CheckBox x:Name="ClearAllBalancesCheck" HorizontalAlignment="Left" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.ClearAllBalances], Mode=OneWay}" FontWeight="Bold" Foreground="#1F6F43" VerticalAlignment="Center" Checked="OnClearAllBalancesChanged" Unchecked="OnClearAllBalancesChanged"/>
                                <Border x:Name="ClearAllBalancesStrike" Style="{StaticResource NotApplicableCheckBoxStrike}" Width="{Binding ActualWidth, ElementName=ClearAllBalancesCheck}"/>
                            </Grid>
                            <Grid Margin="22,4,0,4" HorizontalAlignment="Left">
                                <CheckBox x:Name="PickedUpCheck" HorizontalAlignment="Left" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.PickedUp], Mode=OneWay}" FontWeight="Bold" Foreground="#1F6F43" VerticalAlignment="Center" Checked="OnPickedUpChanged" Unchecked="OnPickedUpChanged"/>
                                <Border x:Name="PickedUpStrike" Style="{StaticResource NotApplicableCheckBoxStrike}" Width="{Binding ActualWidth, ElementName=PickedUpCheck}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ReceivedDownpayment], Mode=OneWay}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PrepaidDownpaymentText" FontWeight="SemiBold" Foreground="#27AE60" VerticalAlignment="Center" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ReceivedFinalBalance], Mode=OneWay}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="ReceivedFinalBalanceText" FontWeight="SemiBold" Foreground="#27AE60" VerticalAlignment="Center" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.FinalBalance], Mode=OneWay}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SummaryFinalBalanceText" FontWeight="SemiBold" Foreground="#C0392B" VerticalAlignment="Center" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.BalanceStatus], Mode=OneWay}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" x:Name="BalanceStatusText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="FinalBalanceBreakdownPanel" Margin="12,2,0,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ServiceType], Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AlterationsRadio" Style="{StaticResource MethodRadio}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ServiceType.Alterations], Mode=OneWay}" Checked="OnServiceTypeChanged"/>
                            <RadioButton x:Name="CustomMadeRadio" Style="{StaticResource MethodRadio}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ServiceType.CustomMade], Mode=OneWay}" Checked="OnServiceTypeChanged"/>
                            <RadioButton x:Name="ReadyMadeRadio" Style="{StaticResource MethodRadio}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ServiceType.ReadyMade], Mode=OneWay}" Checked="OnServiceTypeChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AlterationsPanel" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.Alterations], Mode=OneWay}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ServiceDetails], Mode=OneWay}"/>
                        <ComboBox x:Name="AlterationCategoryBox" Margin="0,6,0,12" Padding="6,4" HorizontalAlignment="Left" MinWidth="240" SelectionChanged="OnServiceCategoryChanged">
                            <!-- "None" switches the whole alteration service off: its notes and payment
                                 inputs lock and it contributes nothing to the order total. Listed FIRST
                                 because it is the default for a new order (most orders start without
                                 alteration work); see the first-option default convention in the skill.
                                 A saved order whose category matches nothing falls back to
                                 GarmentAdjustments instead, so legacy free-text values never switch a
                                 charged alteration service off. -->
                            <ComboBoxItem Tag="None" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Alteration.Category.None], Mode=OneWay}"/>
                            <ComboBoxItem Tag="GarmentAdjustments" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Alteration.Category.GarmentAdjustments], Mode=OneWay}"/>
                            <ComboBoxItem Tag="Others" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Alteration.Category.Others], Mode=OneWay}"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.AdditionalNotes], Mode=OneWay}"/>
                        <TextBox x:Name="AlterationAdditionalNotesBox" Margin="0,6,0,12" Padding="6,4" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <Border Style="{StaticResource PaymentCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource AccentBar}"/>
                                    <TextBlock x:Name="AlterationPaymentTitle" Style="{StaticResource PaymentTitle}"/>
                                </StackPanel>

                                <!-- Always-visible service pricing: pre-tax total + current tax rate. Moved above
                                     the deposit payment method so both are visible before a deposit method is chosen. -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PreTaxServiceTotal], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                                    <TextBox Grid.Column="1" x:Name="AlterationPriceBox" Margin="0,8,14,8" Padding="6,4" TextChanged="OnAlterationValuesChanged" PreviewTextInput="OnDecimalTextBoxPreviewTextInput"/>

                                    <!-- Text is set in code-behind: the box edits the deposit rate until the
                                         deposit is received, then the final-balance rate, and the label says which. -->
                                    <TextBlock Grid.Column="2" x:Name="AlterationTaxLabel" VerticalAlignment="Center" Margin="0,8" TextWrapping="Wrap"/>
                                    <Border Grid.Column="3" Style="{StaticResource LockedRateBox}">
                                        <TextBlock x:Name="AlterationTaxValueText" Style="{StaticResource LockedRateText}"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="AlterationDownMethodLabel" Style="{StaticResource StepLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AlterationDownCash" Style="{StaticResource MethodRadio}" GroupName="AlterationDownMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.Cash], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                    <RadioButton x:Name="AlterationDownDebit" Style="{StaticResource MethodRadio}" GroupName="AlterationDownMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.DebitCard], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                    <RadioButton x:Name="AlterationDownCredit" Style="{StaticResource MethodRadio}" GroupName="AlterationDownMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.CreditCard], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                    <RadioButton x:Name="AlterationDownEtransfer" Style="{StaticResource MethodRadio}" GroupName="AlterationDownMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.Etransfer], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
