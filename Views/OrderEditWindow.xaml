                                    <RadioButton x:Name="ClothingDownCredit" Style="{StaticResource MethodRadio}" GroupName="ClothingDownMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.CreditCard], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                    <RadioButton x:Name="ClothingDownEtransfer" Style="{StaticResource MethodRadio}" GroupName="ClothingDownMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.Etransfer], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                    <RadioButton x:Name="ClothingDownNone" Style="{StaticResource MethodRadio}" GroupName="ClothingDownMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.None], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                </StackPanel>

                                <StackPanel x:Name="ClothingPricingPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                    <!-- Input field: pre-tax deposit -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PreTaxDownpayment], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                                        <TextBox Grid.Column="1" x:Name="ClothingDownpaymentBox" Margin="0,8,14,8" Padding="6,4" TextChanged="OnDownpaymentAmountChanged" PreviewTextInput="OnDecimalTextBoxPreviewTextInput"/>
                                    </Grid>

                                    <!-- Deposit-stage price breakdown (hidden once deposit is marked received) -->
                                    <StackPanel x:Name="ClothingDepositBreakdownPanel" Margin="0,8,0,0">
                                        <Border Height="1" Background="#E4E9F0" Margin="0,4,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PreTaxSubtotal], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4" Foreground="#516074"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ClothingSubtotalText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PreTaxFinalBalance], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4" Foreground="#516074"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ClothingPreTaxBalanceText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ServiceStageTax], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4" Foreground="#516074"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ClothingDepositTaxText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PostTaxTotal], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4" Foreground="#516074"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ClothingSumTotalText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>

                                    <Grid Margin="0,12,0,0" HorizontalAlignment="Left">
                                        <CheckBox x:Name="ClothingDownCompletedCheck" HorizontalAlignment="Left" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.DownpaymentCompleted], Mode=OneWay}" Checked="OnPaymentOptionChanged" Unchecked="OnPaymentOptionChanged"/>
                                        <Border x:Name="ClothingDownCompletedStrike" Style="{StaticResource NotApplicableCheckBoxStrike}" Width="{Binding ActualWidth, ElementName=ClothingDownCompletedCheck}"/>
                                    </Grid>

                                    <StackPanel x:Name="ClothingFinalBlock" Visibility="Collapsed">
                                        <Border Style="{StaticResource StepDivider}"/>
                                        <TextBlock x:Name="ClothingFinalMethodLabel" Style="{StaticResource StepLabel}" Margin="0,14,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ClothingFinalCash" Style="{StaticResource MethodRadio}" GroupName="ClothingFinalMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.Cash], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                            <RadioButton x:Name="ClothingFinalDebit" Style="{StaticResource MethodRadio}" GroupName="ClothingFinalMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.DebitCard], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                            <RadioButton x:Name="ClothingFinalCredit" Style="{StaticResource MethodRadio}" GroupName="ClothingFinalMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.CreditCard], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                            <RadioButton x:Name="ClothingFinalEtransfer" Style="{StaticResource MethodRadio}" GroupName="ClothingFinalMethod" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PaymentMethod.Etransfer], Mode=OneWay}" Checked="OnPaymentOptionChanged"/>
                                        </StackPanel>
                                        <!-- Full price breakdown shown once deposit is received -->
                                        <StackPanel x:Name="ClothingFinalBreakdownPanel" Margin="0,10,0,4" Visibility="Collapsed">
                                            <Border Height="1" Background="#E4E9F0" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PreTaxServiceTotal], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4" Foreground="#808080"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ClothingFinalPriceDisplayText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#808080"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PreTaxDownpayment], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4" Foreground="#808080"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ClothingFinalDownpaymentDisplayText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#808080"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PreTaxFinalBalance], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4" Foreground="#808080"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ClothingFinalPreTaxBalanceText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#808080"/>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ServiceTotalTax], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ClothingFinalTotalTaxText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <!-- Per-portion split of the tax above; text set in code-behind (needs the live payment methods). -->
                                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,14,6">
                                                    <TextBlock x:Name="ClothingDepositTaxLineText" Style="{StaticResource TaxBreakdownLine}"/>
                                                    <TextBlock x:Name="ClothingFinalTaxLineText" Style="{StaticResource TaxBreakdownLine}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PostTaxTotal], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ClothingFinalTotalText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.FinalBalance], Mode=OneWay}" VerticalAlignment="Center" Margin="0,4"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ClothingResidualText" Margin="8,4,14,4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#C0392B"/>
                                            </Grid>
                                        </StackPanel>
                                        <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                            <CheckBox x:Name="ClothingBalanceClearedCheck" HorizontalAlignment="Left" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.BalanceCleared], Mode=OneWay}" Checked="OnPaymentOptionChanged" Unchecked="OnPaymentOptionChanged"/>
                                            <Border x:Name="ClothingBalanceClearedStrike" Style="{StaticResource NotApplicableCheckBoxStrike}" Width="{Binding ActualWidth, ElementName=ClothingBalanceClearedCheck}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Notes], Mode=OneWay}"/>
                        <TextBox x:Name="NotesBox" Margin="0,6,0,0" Padding="6,4" Height="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="#E74C3C" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ReadOnlyNotice" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#E67E22" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.ReadOnlyNotice], Mode=OneWay}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Cancel], Mode=OneWay}" Width="82" Height="32" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick"/>
                <Button x:Name="SaveButton" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Save], Mode=OneWay}" Width="82" Height="32" IsDefault="True" Click="OnSaveClick"
                        Background="#2980B9" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
