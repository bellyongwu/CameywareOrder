<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The shared visual language of the management screens (选择店铺 / 用户管理 / 店铺成员).
         Extracted the moment a third window needed it: three copies of a button template drift, and
         they drift silently, because nothing fails when only two of them get a fix. -->

    <!-- One rounded-button shape, recoloured per role. Built as a template rather than a Background
         setter because the WPF default button chrome paints its own gradient over any Background you
         set, and hover would otherwise revert to the system blue. -->
    <Style x:Key="RoundedButton" TargetType="Button">
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
        <Setter Property="Background" Value="#4F46E5"/>
        <Setter Property="BorderBrush" Value="#4F46E5"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,8"/>
    </Style>

    <!-- Irreversible actions are the one control that does not look like the others. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#FCA5A5"/>
        <Setter Property="Foreground" Value="#B91C1C"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="CardHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#4F46E5"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- TargetType is Control so the one style covers TextBox, PasswordBox, ComboBox and DatePicker. -->
    <Style x:Key="InputBox" TargetType="Control">
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <!-- List rows are cards: the whole row is the hit target, and the selected one reads as an
         accent rather than the system highlight colour. -->
    <Style x:Key="RosterCardContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" CornerRadius="8" Background="White"
                            BorderBrush="#E5E7EB" BorderThickness="1"
                            Padding="11,9" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="#A5B4FC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="#4F46E5"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Card" Property="Background" Value="#EEF2FF"/>
                            <Setter TargetName="Card" Property="Padding" Value="10,8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
