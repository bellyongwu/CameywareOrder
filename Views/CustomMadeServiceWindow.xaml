<Window x:Class="CameywareOrder.Views.CustomMadeServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:conv="clr-namespace:CameywareOrder.Converters"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:model="clr-namespace:CameywareOrder.Models"
        xmlns:ctrl="clr-namespace:CameywareOrder.Controls"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.CustomMade], Mode=OneWay}"
        Height="1120" Width="1200"
        MinHeight="900" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:DocumentThumbnailConverter x:Key="DocumentThumbnailConverter"/>
        <!-- Locked inputs (IsReadOnly) look grayed out like a disabled box. -->
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectionToggleButtonStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B8C2CC"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <Border x:Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEF3F7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Text-link styled button: no chrome, blue underlined label, hand cursor -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1F5F8B"/>
                    <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#B8C2CC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#96281B"/>
                    <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#B8C2CC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DocumentItemTemplate">
            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,8">
                <DockPanel LastChildFill="True">
                    <!-- Square thumbnail: center-cropped via UniformToFill + rounded clip; click to view -->
                    <Border DockPanel.Dock="Left" Width="60" Height="60" Margin="0,0,12,0"
                            Background="#F0F2F5" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                            ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.View], Mode=OneWay}"
                            MouseLeftButtonUp="OnViewDocumentClick">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,60,60" RadiusX="8" RadiusY="8"/>
                        </Border.Clip>
                        <Image Source="{Binding StoredFileName, Converter={StaticResource DocumentThumbnailConverter}}"
                               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource LinkButtonStyle}" Margin="0,0,14,0" Click="OnViewDocumentClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE890;" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.View], Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkButtonStyle}" Margin="0,0,14,0" Click="OnDownloadDocumentClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE896;" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Download], Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkButtonStyle}" Margin="0,0,14,0" Click="OnReplaceDocumentClick"
                                IsEnabled="{Binding CanEditDocuments, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Replace], Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkDangerButtonStyle}" Click="OnDeleteDocumentClick"
                                IsEnabled="{Binding CanEditDocuments, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Delete], Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.CustomMade], Mode=OneWay}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FormRoot">
                <Border Padding="14" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Customer.Measurements.Title], Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.CustomerName], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomerNameBox" Margin="0,8,14,8" Padding="6,4"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PhoneNumber], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                            <ctrl:PhoneNumberField Grid.Row="0" Grid.Column="3" x:Name="PhoneField" Margin="0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Email], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmailBox" Margin="0,8,14,8" Padding="6,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.MeasurementMode], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,8">
                                <RadioButton x:Name="CustomFromScratchRadio" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.CustomFromScratch], Mode=OneWay}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0" Checked="OnModeChanged"/>
                                <RadioButton x:Name="MeasurementsOnlyRadio" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.MeasurementsOnly], Mode=OneWay}" VerticalAlignment="Center" Checked="OnModeChanged"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.AgeType], Mode=OneWay}" VerticalAlignment="Top" Margin="0,10,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <RadioButton x:Name="AdultRadio" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.Adult], Mode=OneWay}" GroupName="AgeGroup" IsChecked="True" Margin="0,0,12,0" Checked="OnAgeGroupChanged"/>
                                    <RadioButton x:Name="TeenRadio" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.Teen], Mode=OneWay}" GroupName="AgeGroup" Margin="0,0,12,0" Checked="OnAgeGroupChanged"/>
                                    <RadioButton x:Name="ChildRadio" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.Child], Mode=OneWay}" GroupName="AgeGroup" Checked="OnAgeGroupChanged"/>
                                </StackPanel>

                                <StackPanel x:Name="GenderButtonsPanel" Orientation="Horizontal" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Measure.Unit.Label], Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <RadioButton x:Name="CmRadio" GroupName="MeasureUnit" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Measure.Unit.Cm], Mode=OneWay}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnUnitChanged"/>
                                <RadioButton x:Name="InchRadio" GroupName="MeasureUnit" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Measure.Unit.Inch], Mode=OneWay}" VerticalAlignment="Center" Checked="OnUnitChanged"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.Measures], Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="MeasurementContextText" Foreground="#4F46E5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Measure.SelectGarments], Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="GarmentSelectorPanel"/>
                            <TextBlock x:Name="NoGarmentText" Foreground="#9AA6B2" FontStyle="Italic" Margin="0,10,0,0"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Measure.NoGarmentSelected], Mode=OneWay}"/>
                            <StackPanel x:Name="GarmentMeasurementsPanel" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.CustomPrice], Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Price], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomPriceBox" Margin="0,8,14,8" Padding="6,4" TextChanged="OnPriceValuesChanged" PreviewTextInput="OnMoneyPreviewTextInput"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Subtotal], Mode=OneWay}" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="CustomSubtotalText" Margin="0,8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Title], Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Border Margin="0,0,0,12" Padding="12" Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="HandwritingUploadButton" DockPanel.Dock="Right"
                                            Tag="{x:Static model:CustomMadeDocumentCategory.HandwritingReceipt}"
                                            Style="{StaticResource LinkButtonStyle}" Click="OnUploadDocumentClick"
                                            IsEnabled="{Binding CanEditDocuments, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="HandwritingUploadText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Category.HandwritingReceipt], Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="HandwritingDocsList" ItemTemplate="{StaticResource DocumentItemTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12" Padding="12" Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="FabricUploadButton" DockPanel.Dock="Right"
                                            Tag="{x:Static model:CustomMadeDocumentCategory.Fabric}"
                                            Style="{StaticResource LinkButtonStyle}" Click="OnUploadDocumentClick"
                                            IsEnabled="{Binding CanEditDocuments, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="FabricUploadText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Category.Fabric], Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="FabricDocsList" ItemTemplate="{StaticResource DocumentItemTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12" Padding="12" Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="PhotoUploadButton" DockPanel.Dock="Right"
                                            Tag="{x:Static model:CustomMadeDocumentCategory.Photo}"
                                            Style="{StaticResource LinkButtonStyle}" Click="OnUploadDocumentClick"
                                            IsEnabled="{Binding CanEditDocuments, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="PhotoUploadText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Category.Photo], Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="PhotoDocsList" ItemTemplate="{StaticResource DocumentItemTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="OtherUploadButton" DockPanel.Dock="Right"
                                            Tag="{x:Static model:CustomMadeDocumentCategory.Other}"
                                            Style="{StaticResource LinkButtonStyle}" Click="OnUploadDocumentClick"
                                            IsEnabled="{Binding CanEditDocuments, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="OtherUploadText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CustomMade.Documents.Category.Other], Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="OtherDocsList" ItemTemplate="{StaticResource DocumentItemTemplate}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.DownloadMeasurement], Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DownloadLanguageLabel" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Download.Language.Label], Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <!-- Filled at run time from the languages this session may export in.
                                 Two fixed radios lived here and a third language was simply
                                 undownloadable. Label and options collapse together when the shop
                                 runs in a single language. -->
                            <ItemsControl x:Name="DownloadLanguagePanel" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button x:Name="DownloadSubmitButton" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.DownloadSubmit], Mode=OneWay}" Width="110" Height="30" Padding="12,5" Click="OnDownloadSubmitClick" Background="#4F46E5" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="ReadOnlyNotice" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#E67E22" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"
                       Margin="0,0,10,0"
                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.ReadOnlyNotice], Mode=OneWay}"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Cancel], Mode=OneWay}" Width="82" Height="32" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="SaveButton" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Save], Mode=OneWay}" Width="82" Height="32" IsDefault="True" Click="OnSaveClick" Background="#4F46E5" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
