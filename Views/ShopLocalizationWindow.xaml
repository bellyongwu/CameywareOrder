<Window x:Class="CameywareOrder.Views.ShopLocalizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.Title], Mode=OneWay}"
        Height="640" Width="900"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="{StaticResource PageBackgroundBrush}">
    <!-- Opened from ShopSetupWindow's "Languages and currencies" link. It exists because the two
         settings had grown into two tick lists and two pickers inside an already long form, and
         because they are ONE decision: a language brings the currencies of its market, so choosing
         them apart from each other hides the relationship.

         Left is what the shop runs in, right is what each of those languages brings. A currency
         appearing under two languages (EUR under both Français and Español) is ONE row object shared
         between them — see BuildCurrencyRows — so ticking it in either place ticks it in both. Two
         independent checkboxes for one currency would let the panel contradict itself. -->
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PaneHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="AccentBarStyle" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PickerStyle" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- One language on the left. The whole row is the hit target rather than just the tick box:
             at 13px a bare checkbox is a small thing to aim at, and this list is the panel's primary
             control. -->
        <DataTemplate x:Key="LanguageRowTemplate">
            <Border Background="Transparent" Padding="10,8" CornerRadius="6" Margin="0,0,0,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <CheckBox IsChecked="{Binding IsInstalled}" VerticalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#111827"/>
                        <TextBlock Text="{Binding CurrencySummary}" FontSize="11" Foreground="#9CA3AF"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </CheckBox>
            </Border>
        </DataTemplate>

        <!-- One currency inside a language's card. Symbol first so the column scans, then the code. -->
        <DataTemplate x:Key="CurrencyRowTemplate">
            <CheckBox IsChecked="{Binding IsSupported}" Margin="0,0,0,7" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="22" CornerRadius="4" Background="#EEF2FF" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Symbol}" FontSize="12" FontWeight="Bold" Foreground="#4F46E5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- One language's card on the right: its name, then the currencies it brings. -->
        <DataTemplate x:Key="CurrencyGroupTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource AccentBarStyle}" Background="#4F46E5"/>
                        <TextBlock Text="{Binding LanguageName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Currencies}"
                                  ItemTemplate="{StaticResource CurrencyRowTemplate}"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.NoCurrencyForLanguage], Mode=OneWay}"
                               Style="{StaticResource HintStyle}"
                               Visibility="{Binding EmptyNoticeVisibility}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The same gradient band every other top-level screen wears. -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="26,18">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.Title], Mode=OneWay}"
                           FontSize="19" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.Subtitle], Mode=OneWay}"
                           FontSize="12" Foreground="#DDD6FE" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: the languages this shop runs in ───────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource PaneHeadingStyle}"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.LanguagesHeading], Mode=OneWay}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <ItemsControl x:Name="LanguageItems" ItemTemplate="{StaticResource LanguageRowTemplate}"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.PreferredLanguage], Mode=OneWay}"/>
                        <ComboBox x:Name="LanguageBox" Style="{StaticResource PickerStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Right: what each of those languages brings ──────────────── -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource PaneHeadingStyle}"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.CurrenciesHeading], Mode=OneWay}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <Grid>
                            <ItemsControl x:Name="CurrencyGroupItems"
                                          ItemTemplate="{StaticResource CurrencyGroupTemplate}"/>
                            <!-- Shown when no language is ticked, so the empty right pane explains
                                 itself instead of reading as a control that failed to load. -->
                            <TextBlock x:Name="CurrenciesEmptyNotice"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.CurrenciesEmpty], Mode=OneWay}"
                                       Style="{StaticResource HintStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Currency], Mode=OneWay}"/>
                        <ComboBox x:Name="CurrencyBox" Style="{StaticResource PickerStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="ErrorText" Foreground="#DC2626" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Style="{StaticResource ThemedButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Cancel], Mode=OneWay}"
                            MinWidth="96" Padding="16,7" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick"/>
                    <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Localization.Done], Mode=OneWay}"
                            MinWidth="96" Padding="16,7" IsDefault="True" Click="OnDoneClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
