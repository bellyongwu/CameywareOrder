<Window x:Class="CameywareOrder.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Title], Mode=OneWay}"
        Height="600" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="#F4F5F9">
    <!-- Runs before the DI host exists, so this window is constructed by hand and reaches the
         localization singleton directly, exactly like the language picker it replaces.
         CenterScreen and an explicit Icon because there is no Owner window yet.

         CanMinimize rather than NoResize: NoResize leaves Close as the only title-bar button, so a
         sign-in screen could not be put aside for a moment. ShowInTaskbar had to change with it —
         minimising a window that has no taskbar button hides it with nothing left to click, which
         would be a worse bug than the one being fixed. The window still cannot be resized. -->
    <Window.Resources>
        <Style x:Key="EnterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- The three fields are a size up from the rest of the app — this is the one screen with
             nothing else on it to read. Based on the THEMED styles rather than declared fresh: an
             explicit Style with no BasedOn replaces the implicit one outright, which is how these
             boxes once ended up as the only unthemed inputs in the application.

             Height is STATED rather than left to measurement, and that is the point of the shared
             value: a TextBox and a ComboBox do not measure to the same height from the same font
             and padding. The TextBox's border is on the element that wraps its content, so it adds
             2px; the ComboBox's border lives on a ToggleButton sitting BESIDE the content in a
             Grid, overlaying it, so it adds nothing. Left to themselves they came out 40 and 38 —
             invisible on a form where they sit in different rows, a visible step here where all
             three are stacked in one column. Pinning the height makes them equal by construction
             instead of by a coincidence of font metrics. -->
        <sys:Double x:Key="FieldHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">40</sys:Double>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
        </Style>

        <Style x:Key="FieldPasswordStyle" TargetType="PasswordBox" BasedOn="{StaticResource ThemedPasswordBox}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
        </Style>

        <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Welcome banner, carried over from the language picker this window replaces. -->
        <Border Grid.Row="0" Height="170" ClipToBounds="True">
            <Grid>
                <Image Source="/Assets/WELCOME%20PANEL/welcome_header_enter_system.jpg" Stretch="UniformToFill"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33000000" Offset="0"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,16">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Welcome], Mode=OneWay}"
                               Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.WelcomeMessage], Mode=OneWay}"
                               Foreground="#F3F4F6" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="32,24,32,0">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.UserName], Mode=OneWay}"
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="UserNameBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Password], Mode=OneWay}"
                       Style="{StaticResource FieldLabelStyle}"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FieldPasswordStyle}"/>

            <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,10,0,0"/>

            <!-- Language lives here because this is now the first screen. Without it a fresh
                 install on a new machine would be stuck in the default language with no way to
                 change it before signing in.

                 Stacked label-over-input like the two fields above it, not set side by side. It is
                 a third field on this form and now looks like one: as a horizontal pair with a
                 smaller, greyer label it read as a footnote hanging off the password box. -->
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Language], Mode=OneWay}"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="LanguageBox" Style="{StaticResource FieldComboStyle}"
                          SelectionChanged="OnLanguageChanged"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="2" x:Name="SignInButton"
                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.SignIn], Mode=OneWay}"
                Style="{StaticResource EnterButtonStyle}"
                Height="46" Margin="32,18,32,26"
                IsDefault="True"
                Click="OnSignInClick"/>
    </Grid>
</Window>
