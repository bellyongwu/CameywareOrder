<Window x:Class="CameywareOrder.Views.StoreMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:anim="clr-namespace:CameywareOrder.Animations"
        xmlns:ctrl="clr-namespace:CameywareOrder.Controls"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Title], Mode=OneWay}"
        Height="760" Width="1060"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="#F4F5F9">
    <!-- The OPEN shop's roster: who works here, in what role, on what shift, and whether they are
         still active. Manager or administrator only. Members come from credentials.json, so unlike
         User Management this window needs no database access at all — only the shop it was opened for. -->
    <!-- Styles come from Themes/AppTheme.xaml, merged application-wide in App.xaml. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header band: title, shop, and the head-count ────────────── -->
        <Border Grid.Row="0" Padding="28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Title], Mode=OneWay}"
                               Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <!-- Which shop's roster this is. Set in code — it is the shop's own name. -->
                    <TextBlock x:Name="ShopNameText" Foreground="#DDD6FE" FontSize="13"
                               Margin="0,6,24,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- "How many work here" is a headline number, not something to count by hand. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#26FFFFFF" Padding="16,9" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="TotalCountText" Foreground="White" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Total], Mode=OneWay}"
                                       Foreground="#DDD6FE" FontSize="11" Margin="0,2,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="#26FFFFFF" Padding="16,9" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="ActiveCountText" Foreground="White" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Active], Mode=OneWay}"
                                       Foreground="#DDD6FE" FontSize="11" Margin="0,2,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="#26FFFFFF" Padding="16,9">
                        <StackPanel>
                            <TextBlock x:Name="InactiveCountText" Foreground="White" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Deactivated], Mode=OneWay}"
                                       Foreground="#DDD6FE" FontSize="11" Margin="0,2,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body: roster | detail ───────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="326"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource CardHeading}"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Roster], Mode=OneWay}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox"
                                 TextChanged="OnSearchTextChanged"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Search], Mode=OneWay}"
                                   IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="#9CA3AF" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="MemberList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RosterCardContainer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnMemberSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding RowOpacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#6B7280"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3"
                                            Background="{Binding StatusBackground}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusForeground}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" x:Name="AddMemberButton"
                            Margin="0,12,0,0" HorizontalAlignment="Stretch"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Add], Mode=OneWay}"
                            Click="OnAddMemberClick"/>
                </Grid>
            </Border>

            <!-- Exactly one of these three is visible at a time. -->
            <Grid Grid.Column="1" Margin="18,0,0,0">
                <TextBlock x:Name="EmptySelectionText" anim:PanelTransition.Mode="FadeSlide"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.SelectPrompt], Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" MaxWidth="340"
                           TextAlignment="Center"/>

                <!-- Add a member: the account and its place in this shop are created together. -->
                <ScrollViewer x:Name="CreatePanel" anim:PanelTransition.Mode="FadeSlide" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeading}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.NewMember], Mode=OneWay}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,14">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.UserName], Mode=OneWay}"/>
                                    <TextBox x:Name="NewUserNameBox" TextChanged="OnNewUserNameTextChanged"/>
                                    <!-- Answered at the keystroke. The same courtesy as the account
                                         screen, because the same mistake costs the same re-typing. -->
                                    <TextBlock x:Name="NewUserNameTakenText" Foreground="#B91C1C" FontSize="12"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Error.NameTaken], Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.FirstName], Mode=OneWay}"/>
                                            <TextBox x:Name="NewFirstNameBox" MaxLength="60"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.LastName], Mode=OneWay}"/>
                                            <TextBox x:Name="NewLastNameBox" MaxLength="60"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,14">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Password], Mode=OneWay}"/>
                                    <PasswordBox x:Name="NewPasswordBox"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,14">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ConfirmPassword], Mode=OneWay}"/>
                                    <PasswordBox x:Name="NewPasswordConfirmBox"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,14">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Birthday], Mode=OneWay}"/>
                                    <DatePicker x:Name="NewBirthDatePicker"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,14">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.JoinedOn], Mode=OneWay}"/>
                                    <DatePicker x:Name="NewJoinedDatePicker"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,14">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Phone], Mode=OneWay}"/>
                                    <ctrl:PhoneNumberField x:Name="NewPhoneField"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,14">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Email], Mode=OneWay}"/>
                                    <TextBox x:Name="NewEmailBox"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,6"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.RoleInShop], Mode=OneWay}"/>
                            <ctrl:RoleCheckList x:Name="NewRoleList" Margin="0,0,0,14"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Shift], Mode=OneWay}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ComboBox x:Name="NewShiftStartBox" Width="146" Style="{StaticResource TimePickerComboBox}"
                                          />
                                <TextBlock Text="—" VerticalAlignment="Center" Margin="10,0" Foreground="#9CA3AF"/>
                                <ComboBox x:Name="NewShiftEndBox" Width="146" Style="{StaticResource TimePickerComboBox}"
                                          />
                            </StackPanel>

                            <TextBlock x:Name="CreateErrorText" Foreground="#B91C1C" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Create], Mode=OneWay}"
                                        Click="OnCreateConfirmClick"/>
                                <Button
                                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Cancel], Mode=OneWay}"
                                        Click="OnCreateCancelClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Edit a member -->
                <ScrollViewer x:Name="DetailPanel" anim:PanelTransition.Mode="FadeSlide" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="46" CornerRadius="23"
                                        Background="{Binding ElementName=MemberList, Path=SelectedItem.AvatarBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ElementName=MemberList, Path=SelectedItem.Initial}"
                                               Foreground="White" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailNameText" FontSize="18" FontWeight="Bold"
                                               Foreground="#111827"/>
                                    <TextBlock x:Name="DetailSubtitleText" FontSize="12" Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Shown instead of the editors for the administrator, who is not a member
                             anybody's roster gets to edit. -->
                        <Border x:Name="AdminNoticePanel" anim:PanelTransition.Mode="FadeSlide" CornerRadius="10" Background="#EEF2FF"
                                BorderBrush="#C7D2FE" BorderThickness="1" Padding="16,14"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.AdminNotice], Mode=OneWay}"
                                       Foreground="#3730A3" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel x:Name="EditorPanels" anim:PanelTransition.Mode="FadeSlide">
                            <!-- Person -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeading}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Profile], Mode=OneWay}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.FirstName], Mode=OneWay}"/>
                                            <TextBox x:Name="FirstNameBox" MaxLength="60"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.LastName], Mode=OneWay}"/>
                                            <TextBox x:Name="LastNameBox" MaxLength="60"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Birthday], Mode=OneWay}"/>
                                            <DatePicker x:Name="BirthDatePicker"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Phone], Mode=OneWay}"/>
                                            <ctrl:PhoneNumberField x:Name="PhoneField"/>
                                            <TextBlock x:Name="PhoneErrorText" Foreground="#B91C1C" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Email], Mode=OneWay}"/>
                                            <TextBox x:Name="EmailBox" LostFocus="OnEmailBoxLostFocus"/>
                                            <TextBlock x:Name="EmailErrorText" Foreground="#B91C1C" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Role and standing in THIS shop -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeading}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.RoleAndStatus], Mode=OneWay}"/>

                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.RoleInShop], Mode=OneWay}"/>
                                    <ctrl:RoleCheckList x:Name="RoleList" Margin="0,0,0,16"/>

                                    <CheckBox x:Name="ActiveCheck" Margin="0,0,0,6" Checked="OnActiveChanged"
                                              Unchecked="OnActiveChanged"
                                              Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.IsActive], Mode=OneWay}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.IsActiveHint], Mode=OneWay}"
                                               FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap"
                                               Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.JoinedOn], Mode=OneWay}"/>
                                            <DatePicker x:Name="JoinedDatePicker"/>
                                        </StackPanel>
                                        <!-- Read-only: when someone was delisted is a record of what
                                             happened, not a field anyone types. -->
                                        <StackPanel x:Name="DeactivatedPanel" anim:PanelTransition.Mode="FadeSlide" Grid.Column="1" Margin="10,0,0,0"
                                                    Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.DeactivatedOn], Mode=OneWay}"/>
                                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    CornerRadius="4" Padding="9,8">
                                                <TextBlock x:Name="DeactivatedOnText" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="#B91C1C"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Shift -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeading}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Shift], Mode=OneWay}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.ShiftFrom], Mode=OneWay}"/>
                                            <ComboBox x:Name="ShiftStartBox" Width="146" Style="{StaticResource TimePickerComboBox}"
                                                      />
                                        </StackPanel>
                                        <StackPanel Margin="16,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.ShiftUntil], Mode=OneWay}"/>
                                            <ComboBox x:Name="ShiftEndBox" Width="146" Style="{StaticResource TimePickerComboBox}"
                                                      />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.ShiftHint], Mode=OneWay}"
                                               FontSize="12" Foreground="#9CA3AF" Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Password. Hidden when this manager's remit does not cover the whole
                                 account — see AuthenticationService.CanSetPasswordFor. -->
                            <Border x:Name="PasswordPanel" anim:PanelTransition.Mode="FadeSlide" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeading}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Password], Mode=OneWay}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NewPassword], Mode=OneWay}"/>
                                            <PasswordBox x:Name="ResetPasswordBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}"
                                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ConfirmPassword], Mode=OneWay}"/>
                                            <PasswordBox x:Name="ResetPasswordConfirmBox"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.PasswordHint], Mode=OneWay}"
                                               FontSize="12" Foreground="#9CA3AF" Margin="0,9,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="24,13" Margin="0,18,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Administrator only: deleting the ACCOUNT reaches every shop, while a manager's
                         tool for "they no longer work here" is deactivation. -->
                    <Button x:Name="DeleteAccountButton" Style="{StaticResource DangerButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.DeleteAccount], Mode=OneWay}"
                            Click="OnDeleteAccountClick"/>
                    <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="#047857" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Save], Mode=OneWay}"
                            Click="OnSaveClick"/>
                    <Button
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Close], Mode=OneWay}"
                            Click="OnCloseClick" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
