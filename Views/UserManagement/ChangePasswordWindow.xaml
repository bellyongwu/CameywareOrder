<Window x:Class="CameywareOrder.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="{StaticResource PageBackgroundBrush}">
    <!-- Changing your OWN password, from inside the application.

         Until v9.3.0 the only route to a new password was to ask a manager to set one — and a
         manager who sets your password knows it, which is the one thing a password may not be. The
         forced-change step on the sign-in screen covered only the case where the application
         DEMANDS a change; wanting one is a different thing, and it is the ordinary one.

         It asks for the current password even though there is a live session, and that is not
         ceremony: the session proves somebody signed in earlier, not that the person now at the
         keyboard is that somebody. A machine left unlocked at a counter is exactly the case this
         guards, and AuthenticationService.ChangeOwnPassword requires it for the same reason.

         The window's Title is set from CODE, not bound: a Window's own properties are set before its
         Resources exist, so a binding here fails at parse time. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="26,22">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextOnPrimaryBrush}"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Password.Change.Title], Mode=OneWay}"/>
                <TextBlock x:Name="AccountText" FontSize="12" Foreground="{StaticResource TextOnHeaderSubtleBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,22,26,22">
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Password.Change.Current], Mode=OneWay}"/>
            <PasswordBox x:Name="CurrentPasswordBox" Margin="0,5,0,14" Padding="10,8" FontSize="14"
                         PasswordChanged="OnPasswordTyped"/>

            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NewPassword], Mode=OneWay}"/>
            <PasswordBox x:Name="NewPasswordBox" Margin="0,5,0,14" Padding="10,8" FontSize="14"
                         PasswordChanged="OnPasswordTyped"/>

            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ConfirmPassword], Mode=OneWay}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,5,0,0" Padding="10,8" FontSize="14"
                         PasswordChanged="OnPasswordTyped"/>

            <!-- The rule, stated before it is broken rather than only after. -->
            <TextBlock x:Name="RuleText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Margin="0,0,10,0" Padding="16,7" IsCancel="True"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Cancel], Mode=OneWay}"/>
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Padding="16,9"
                        FontSize="14" IsDefault="True" Click="OnSaveClick"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Password.Change.Save], Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
