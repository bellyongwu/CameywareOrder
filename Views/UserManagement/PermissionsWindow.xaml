<Window x:Class="CameywareOrder.Views.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:views="clr-namespace:CameywareOrder.Views"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Permissions], Mode=OneWay}"
        Height="780" Width="1180"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="#F4F5F9">
    <!-- Administrator-only. Reached from the shop picker and from Local Configuration → Permissions.

         Two trees, answering the two halves of the question separately. On the left: who holds which
         role, in which shop — an assignment. On the right: what each role actually MEANS — a
         definition. Keeping them apart is what stops the panel becoming a per-person permission list,
         which is the shape that eventually cannot be reasoned about at all.

         Styles come from Themes/AppTheme.xaml, merged application-wide in App.xaml. -->
    <Window.Resources>

        <!-- ── Left tree: account → shop → the roles held there ─────────────
             An avatar tile and a name, the same way the shop picker and the
             account manager draw a person. A permission screen is where somebody
             is most likely to act on the wrong row, so the person has to be
             recognisable at a glance rather than read letter by letter. -->
        <HierarchicalDataTemplate DataType="{x:Type views:AccountNode}" ItemsSource="{Binding Shops}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                        Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Details}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type views:AccountShopNode}" ItemsSource="{Binding Roles}">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ShopName}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type views:RoleToggle}">
            <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay}" Margin="0,3"
                      VerticalContentAlignment="Center">
                <StackPanel Margin="2,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- ── Right tree: shop → role → capability ─────────────────────── -->
        <HierarchicalDataTemplate DataType="{x:Type views:ShopNode}" ItemsSource="{Binding Roles}">
            <StackPanel Margin="0,3">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#9CA3AF" Margin="0,1,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type views:RoleNode}" ItemsSource="{Binding Groups}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <Border CornerRadius="9" Background="#EEF2FF" Padding="9,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#3730A3"/>
                </Border>
                <!-- Recomputed as boxes are ticked: the count is the shortest honest description of
                     what a role is, and it has to move while the administrator is deciding. -->
                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#9CA3AF"
                           VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type views:CapabilityGroupNode}" ItemsSource="{Binding Capabilities}">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource PrimaryBrush}"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type views:CapabilityNode}">
            <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"
                      Margin="0,2" VerticalContentAlignment="Center">
                <!-- HorizontalAlignment=Left on the detail, and it is load-bearing: a stretched
                     element that cannot use its whole slot because of MaxWidth is CENTRED in what
                     is left, so the explanation drifted a hundred pixels right of the name it
                     belongs to and read as a second column. -->
                <StackPanel Margin="2,0,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Name}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" HorizontalAlignment="Left"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" MaxWidth="520" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header band ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Permissions], Mode=OneWay}"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Subtitle], Mode=OneWay}"
                           Foreground="#DDD6FE" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Body: accounts | shops and roles ────────────────────────── -->
        <Grid Grid.Row="1" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource CardHeading}"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Accounts], Mode=OneWay}"/>

                    <TextBlock Grid.Row="1" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.AccountsHint], Mode=OneWay}"/>

                    <TreeView Grid.Row="2" x:Name="AccountTree" BorderThickness="0" Background="Transparent"
                              VirtualizingPanel.IsVirtualizing="False"/>
                </Grid>
            </Border>

            <!-- Shops → roles → capabilities -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource CardHeading}" VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Roles], Mode=OneWay}"/>
                        <!-- Defining a role is its own act, so it has its own box and its own button
                             rather than an empty row appearing in the tree. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Watermark: WPF has no placeholder, so the caption sits behind the
                                 box and hides as soon as anything is typed. An unlabelled box beside
                                 a button reads as a search field, which is the one thing it is not. -->
                            <Grid Width="200" Margin="0,0,8,0">
                                <TextBox x:Name="NewRoleNameBox" Padding="8,5" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.NewRoleName], Mode=OneWay}"
                                           IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewRoleNameBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="AddRoleButton" Padding="14,7" Click="OnAddRoleClick"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.AddRole], Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.RolesHint], Mode=OneWay}"/>

                    <TreeView Grid.Row="2" x:Name="ShopTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="OnShopTreeSelectionChanged"
                              VirtualizingPanel.IsVirtualizing="False"/>

                    <!-- Acts on whichever role is selected in the tree above. Hidden entirely when
                         nothing is selected: a row of buttons that would act on nothing reads as a
                         screen that has failed to load. -->
                    <Border Grid.Row="3" x:Name="RoleActionBar" Background="#F9FAFB" BorderBrush="#E5E7EB"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedRoleLabel" FontSize="12" Foreground="#6B7280"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="RoleNameBox" Width="180" Padding="6,4"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="RenameRoleButton" Padding="12,6" Margin="8,0,0,0"
                                        Click="OnRenameRoleClick"
                                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Rename], Mode=OneWay}"/>
                                <Button x:Name="RestoreRoleButton" Padding="12,6" Margin="8,0,0,0"
                                        Click="OnRestoreRoleClick"
                                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.RestoreDefaults], Mode=OneWay}"/>
                            </StackPanel>
                            <Button x:Name="DeleteRoleButton" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6"
                                    Click="OnDeleteRoleClick"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.DeleteRole], Mode=OneWay}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="24,13" Margin="0,18,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="#047857" TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Save], Mode=OneWay}"
                            Click="OnSaveClick"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Close], Mode=OneWay}"
                            Click="OnCloseClick" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
