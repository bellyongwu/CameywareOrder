<Window x:Class="CameywareOrder.Views.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Permissions], Mode=OneWay}"
        Height="800" Width="1180"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="{StaticResource PageBackgroundBrush}">
    <!-- Redesigned in v9.0. It used to be two TREES — accounts→shops→roles on one side and
         shops→roles→capabilities on the other — so the shop was the thing you navigated, a role was
         something you found underneath one, and you found it twice in two different shapes. That is
         the sprawl this replaces.

         Three columns now, each answering one question, left to right in the order the work is done:

           1. WHICH ROLES EXIST         the installation's catalogue. Add, rename, delete.
           2. WHERE IS THIS ONE VARIED  the shops the selected role has its own set in. A role is
                                        DRAGGED from column 1 onto this list to give it one.
           3. WHAT DOES IT ALLOW        one capability editor, editing either the role's default or
                                        its instance in the shop picked in column 2.

         Accounts are gone from this screen. Putting a person into a role is User Management's job and
         having two screens do it was half of what made this one feel long.

         Everything is from Themes/AppTheme.xaml. -->
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="ColumnHeading" TargetType="TextBlock" BasedOn="{StaticResource CardHeading}">
                <Setter Property="Margin" Value="2,0,0,2"/>
            </Style>

            <Style x:Key="ColumnHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="2,0,0,10"/>
            </Style>

            <!-- ONE card shape for both lists, so a role dragged out of the left column is
                 recognisably the same object when it lands in the right one. -->
            <Style x:Key="ListCard" TargetType="ListBoxItem" BasedOn="{StaticResource RosterCardContainer}">
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" CornerRadius="9" Background="White"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="13,10" SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryHoverBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter TargetName="Card" Property="Padding" Value="12,9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Permissions], Mode=OneWay}"
                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Subtitle], Mode=OneWay}"
                           FontSize="12" Foreground="{StaticResource TextOnHeaderSubtleBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 1. The catalogue ─────────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource ColumnHeading}"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Roles], Mode=OneWay}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource ColumnHint}"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.RolesHint], Mode=OneWay}"/>

                <Border Grid.Row="2" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                    <ListBox x:Name="RoleList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ListCard}"
                             SelectionChanged="OnRoleSelectionChanged"
                             PreviewMouseLeftButtonDown="OnRoleDragStart"
                             PreviewMouseMove="OnRoleDragMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- Says a role cannot be changed at all, rather than leaving the
                                         reader to discover it by trying. -->
                                    <Border Grid.Column="1" CornerRadius="9" Padding="9,3"
                                            Background="{StaticResource PrimarySoftBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding LockedVisibility}">
                                        <TextBlock Text="{Binding LockedText}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryDeepBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddRoleButton" Padding="12,6" Margin="0,0,8,0"
                            Style="{StaticResource AccentIndigoButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.AddRole], Mode=OneWay}"
                            Click="OnAddRoleClick"/>
                    <Button x:Name="RenameRoleButton" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Rename], Mode=OneWay}"
                            Click="OnRenameRoleClick"/>
                    <Button x:Name="DeleteRoleButton" Padding="12,6" IsEnabled="False"
                            Style="{StaticResource DangerButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.DeleteRole], Mode=OneWay}"
                            Click="OnDeleteRoleClick"/>
                </StackPanel>
            </Grid>

            <!-- ── 2. Where it is varied ────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource ColumnHeading}"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Shops], Mode=OneWay}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource ColumnHint}"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.ShopsHint], Mode=OneWay}"/>

                <!-- The drop target is the BORDER, not the list. A drop onto the empty space below the
                     last shop still has to land somewhere, and a target that only accepts its rows is
                     one people conclude is broken. -->
                <Border x:Name="ShopDropTarget" Grid.Row="2" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12"
                        AllowDrop="True"
                        DragEnter="OnShopDragOver" DragOver="OnShopDragOver"
                        DragLeave="OnShopDragLeave" Drop="OnShopDrop">
                    <Grid>
                        <ListBox x:Name="ShopList" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ListCard}"
                                 SelectionChanged="OnShopSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="9" Padding="9,3"
                                                Background="{Binding StateBackground}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding StateForeground}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="ShopEmptyText" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="230" TextAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button x:Name="RemoveInstanceButton" Grid.Row="3" Margin="0,10,0,0" Padding="12,6"
                        HorizontalAlignment="Left" IsEnabled="False"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.RemoveInstance], Mode=OneWay}"
                        Click="OnRemoveInstanceClick"/>
            </Grid>

            <!-- ── 3. What it allows ────────────────────────────────────────── -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Written from code: it names whichever of the two things is being edited, and
                     getting that wrong means somebody narrows every branch when they meant one. -->
                <TextBlock x:Name="EditorHeading" Grid.Row="0" Style="{StaticResource ColumnHeading}"/>
                <TextBlock x:Name="EditorHint" Grid.Row="1" Style="{StaticResource ColumnHint}"/>

                <Border Grid.Row="2" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CapabilityGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding GroupName}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDeepBrush}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Toggles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsGranted}"
                                                                  IsEnabled="{Binding IsEditable}"
                                                                  Margin="0,4,0,4">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextWrapping="Wrap" MaxWidth="380"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EditorEmptyText"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.PickARole], Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SaveCapabilitiesButton" Padding="16,7" Margin="0,0,8,0" IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.Apply], Mode=OneWay}"
                            Click="OnSaveCapabilitiesClick"/>
                    <Button x:Name="RestoreDefaultsButton" Padding="12,7" IsEnabled="False"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Permission.RestoreDefaults], Mode=OneWay}"
                            Click="OnRestoreDefaultsClick"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" MaxWidth="760"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" Padding="16,7" IsCancel="True"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Store.Manage.Close], Mode=OneWay}"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
