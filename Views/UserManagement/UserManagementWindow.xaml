<Window x:Class="CameywareOrder.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:anim="clr-namespace:CameywareOrder.Animations"
        xmlns:ctrl="clr-namespace:CameywareOrder.Controls"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.UserManagement], Mode=OneWay}"
        Height="720" Width="1020"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="#F4F5F9">
    <!-- Administrator-only. Reached from the shop picker and from Local Configuration → User Management.
         Accounts live in credentials.json, outside the database, but the SHOPS they are assigned to
         are read from it — hence the scope factory. -->
    <!-- Styles come from Themes/AppTheme.xaml, merged application-wide in App.xaml. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header band ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.UserManagement], Mode=OneWay}"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Subtitle], Mode=OneWay}"
                           Foreground="#DDD6FE" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Body: account list | detail ─────────────────────────────── -->
        <Grid Grid.Row="1" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource CardHeading}"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Accounts], Mode=OneWay}"/>

                    <!-- Watermark: WPF has no placeholder, so the caption sits behind the box and
                         hides as soon as anything is typed. -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox"
                                 TextChanged="OnSearchTextChanged"
                                 ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Search], Mode=OneWay}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Search], Mode=OneWay}"
                                   IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="#9CA3AF" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="UserList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RosterCardContainer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnUserSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- The person, then what they can reach. The label is
                                         "Name (Manager, Staff)" — built in code because it
                                         interleaves stored text with localized role names. -->
                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#6B7280"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3" Background="#E0E7FF"
                                            VerticalAlignment="Center" Visibility="{Binding AdminBadgeVisibility}">
                                        <TextBlock Text="{Binding AdminBadgeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#3730A3"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" x:Name="AddUserButton"
                            Margin="0,12,0,0" HorizontalAlignment="Stretch"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Add], Mode=OneWay}"
                            Click="OnAddUserClick"/>
                </Grid>
            </Border>

            <!-- Detail: exactly one of these three panels is visible at a time. -->
            <Grid Grid.Column="1" Margin="18,0,0,0">
                <!-- Nothing selected -->
                <TextBlock x:Name="EmptySelectionText" anim:PanelTransition.Mode="FadeSlide"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.SelectPrompt], Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" MaxWidth="320"
                           TextAlignment="Center"/>

                <!-- Create -->
                <Border x:Name="CreatePanel" anim:PanelTransition.Mode="FadeSlide" Style="{StaticResource CardBorder}" VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeading}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NewUser], Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.UserName], Mode=OneWay}"/>
                        <TextBox x:Name="NewUserNameBox" MaxWidth="360"
                                 HorizontalAlignment="Left" Width="360"
                                 TextChanged="OnNewUserNameTextChanged"/>
                        <!-- Answered while the name is being typed. Finding out only on submit means
                             re-typing a password as well, for a mistake the screen already knew
                             about at the first keystroke. -->
                        <TextBlock x:Name="NewUserNameTakenText" Foreground="#B91C1C" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Error.NameTaken], Mode=OneWay}"/>
                        <Border Height="14"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Password], Mode=OneWay}"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     HorizontalAlignment="Left" Width="360" Margin="0,0,0,14"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ConfirmPassword], Mode=OneWay}"/>
                        <PasswordBox x:Name="NewPasswordConfirmBox"
                                     HorizontalAlignment="Left" Width="360" Margin="0,0,0,6"/>

                        <TextBlock x:Name="CreateErrorText" Foreground="#B91C1C" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Create], Mode=OneWay}"
                                    Click="OnCreateConfirmClick"/>
                            <Button
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Cancel], Mode=OneWay}"
                                    Click="OnCreateCancelClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Edit -->
                <ScrollViewer x:Name="DetailPanel" anim:PanelTransition.Mode="FadeSlide" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Identity -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                                        Background="{Binding ElementName=UserList, Path=SelectedItem.AvatarBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ElementName=UserList, Path=SelectedItem.Initial}"
                                               Foreground="White" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Name first, then the login underneath it. Which account this is
                                     matters here in a way it does not in the list: this is the pane
                                     that resets a password and reassigns shops. -->
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailNameText" FontSize="18" FontWeight="Bold"
                                               Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailLoginText" FontSize="12" Foreground="#4B5563"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailSummaryText" FontSize="12" Foreground="#6B7280"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Take over this account's session. Sits WITH the person it acts
                                     on rather than in the footer, where it would read as another
                                     thing the Save button does. -->
                                <Button x:Name="SignInAsButton" Grid.Column="2" Click="OnSignInAsClick"
                                        VerticalAlignment="Center" Padding="12,7"
                                        ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.SignInAsHint], Mode=OneWay}"
                                        AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.SignInAs], Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Vector geometry, in SVG path syntax: a person, and an
                                             arrow entering from the left. WPF renders Path data
                                             natively; an .svg file would need a rasterizer that is
                                             not installed on this machine (see context.md), and a
                                             bitmap would not stay crisp at every DPI. -->
                                        <Canvas Width="18" Height="16" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <!-- The person: head and shoulders. -->
                                            <Ellipse Canvas.Left="10.0" Canvas.Top="1.6" Width="5.6" Height="5.6"
                                                     Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5"/>
                                            <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M 8.2 14.4 C 8.2 10.9 10.6 9.4 12.8 9.4 C 15.0 9.4 17.4 10.9 17.4 14.4"/>
                                            <!-- The arrow: entering, not leaving. -->
                                            <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M 0.8 8 L 6.4 8 M 3.9 5.2 L 6.7 8 L 3.9 10.8"/>
                                        </Canvas>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.SignInAs], Mode=OneWay}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Shown instead of the assignment matrix for the locked administrator. -->
                        <Border x:Name="AdminNoticePanel" CornerRadius="10" Background="#EEF2FF"
                                BorderBrush="#C7D2FE" BorderThickness="1" Padding="16,14"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.AdminNotice], Mode=OneWay}"
                                       Foreground="#3730A3" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Who this person is and what they sign in as. Account-level, so an
                             account that belongs to no shop — which the roster screen cannot reach —
                             is still editable here, and so the administrator's own details are too:
                             none of this grants anybody anything. One Save for the whole card,
                             because a rename that landed while a bad phone number was rejected would
                             leave the pane describing an account that no longer answers to it. -->
                        <Border x:Name="ContactPanel" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeading}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Profile], Mode=OneWay}"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.FirstName], Mode=OneWay}"/>
                                        <TextBox x:Name="FirstNameBox" MaxLength="60"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.LastName], Mode=OneWay}"/>
                                        <TextBox x:Name="LastNameBox" MaxLength="60"/>
                                    </StackPanel>
                                </Grid>

                                <!-- The login. Editable for every account EXCEPT the administrator's,
                                     whose box is disabled in code with the reason under it — that
                                     account must stay identifiable and can never be deleted or
                                     demoted, so its login is not the user's to lose. Availability is
                                     reported as the name is typed: being told after filling in the
                                     whole card is a worse answer than being told at the keystroke. -->
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.UserName], Mode=OneWay}"/>
                                <TextBox x:Name="LoginBox" MaxLength="60" HorizontalAlignment="Left" Width="300"
                                         TextChanged="OnLoginTextChanged"/>
                                <!-- Anything wrong with the LOGIN is reported here, under the login.
                                     Its text is set in code because the same line carries both
                                     "already taken" (live, as it is typed) and whatever the save
                                     came back with — one message per field beats one shared line at
                                     the bottom of the card that says which field only by implication. -->
                                <TextBlock x:Name="LoginErrorText" Foreground="#B91C1C" FontSize="12"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <TextBlock x:Name="LoginHintText"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.LoginHint], Mode=OneWay}"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,12" TextWrapping="Wrap"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Phone], Mode=OneWay}"/>
                                        <ctrl:PhoneNumberField x:Name="ContactPhoneField"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Email], Mode=OneWay}"/>
                                        <TextBox x:Name="ContactEmailBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ContactErrorText" Foreground="#B91C1C" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <!-- No Save of its own. This card used to carry one, labelled with
                                     the same string as the footer's — and the footer's saved only
                                     the password and the shop roles, so anybody who edited a name or
                                     a login and pressed the obvious button watched their edit
                                     silently revert on the reload. One screen, one Save. -->
                            </StackPanel>
                        </Border>

                        <!-- Password -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeading}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Password], Mode=OneWay}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NewPassword], Mode=OneWay}"/>
                                        <PasswordBox x:Name="ResetPasswordBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ConfirmPassword], Mode=OneWay}"/>
                                        <PasswordBox x:Name="ResetPasswordConfirmBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.PasswordHint], Mode=OneWay}"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Shop × role matrix -->
                        <Border x:Name="AssignmentsPanel" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeading}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Assignments], Mode=OneWay}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.AssignmentsHint], Mode=OneWay}"
                                           FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- Column captions. The roles are no longer two fixed columns — an
                                     installation defines as many as it likes — so the right-hand
                                     caption names the QUESTION and each row answers it with the
                                     roles that actually exist. -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="2,0,0,0"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ShopColumn], Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.RoleInShop], Mode=OneWay}"/>
                                </Grid>

                                <ItemsControl x:Name="AssignmentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,10,0">
                                                        <TextBlock Text="{Binding ShopName}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="#111827"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ShopDetails}" FontSize="11"
                                                                   Foreground="#9CA3AF" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- One tick box per defined role. A WrapPanel, so an
                                                         installation with six roles moves onto a second
                                                         line instead of off the edge of the card. -->
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Roles}"
                                                                  VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                                          Content="{Binding Name}" Margin="0,2,18,2"
                                                                          VerticalContentAlignment="Center"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoShopsText"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NoShops], Mode=OneWay}"
                                           FontSize="13" Foreground="#9CA3AF" Visibility="Collapsed"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="24,13" Margin="0,18,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="DeleteUserButton" Style="{StaticResource DangerButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Delete], Mode=OneWay}"
                            Click="OnDeleteUserClick"/>
                    <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="#047857" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Save], Mode=OneWay}"
                            Click="OnSaveClick"/>
                    <Button
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Close], Mode=OneWay}"
                            Click="OnCloseClick" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
