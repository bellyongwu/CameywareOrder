<Window x:Class="LeeYongeOrdering.Views.MeasurementTermLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LeeYongeOrdering.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Title], Mode=OneWay}"
        SizeToContent="Height" Width="420"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="White" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF2B7;" FontSize="18" Foreground="#2980B9" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Title], Mode=OneWay}"
                           FontSize="16" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="TermNameText" Foreground="#7F8C8D" Margin="0,0,0,14"/>

            <!-- Gender classification: shown only when editing a measurement term (not a garment) -->
            <StackPanel Grid.Row="2" x:Name="GenderPanel" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Gender], Mode=OneWay}"
                           VerticalAlignment="Center" Foreground="#2C3E50" Margin="0,0,10,0"/>
                <RadioButton x:Name="GenderCommonRadio" GroupName="TermGender" Margin="0,0,14,0" VerticalAlignment="Center"
                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.GenderCommon], Mode=OneWay}"/>
                <RadioButton x:Name="GenderMaleRadio" GroupName="TermGender" Margin="0,0,14,0" VerticalAlignment="Center"
                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.GenderMale], Mode=OneWay}"/>
                <RadioButton x:Name="GenderFemaleRadio" GroupName="TermGender" VerticalAlignment="Center"
                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.GenderFemale], Mode=OneWay}"/>
            </StackPanel>

            <ItemsControl Grid.Row="3" x:Name="LanguageRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LanguageName}" VerticalAlignment="Center" Foreground="#2C3E50"/>
                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7,5" BorderBrush="#CBD3DA" BorderThickness="1"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Cancel], Mode=OneWay}"
                        Width="90" Height="32" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick"/>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Save], Mode=OneWay}"
                        Width="90" Height="32" IsDefault="True" Click="OnSaveClick"
                        Background="#2980B9" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
