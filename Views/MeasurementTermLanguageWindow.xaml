<Window x:Class="CameywareOrder.Views.MeasurementTermLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Title], Mode=OneWay}"
        SizeToContent="Height" Width="420"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="White" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xF2B7;" FontSize="18" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Title], Mode=OneWay}"
                           FontSize="15" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="TermNameText" Foreground="#9CA3AF" Margin="0,0,0,14"/>

            <!-- Gender classification: shown only when editing a measurement term (not a garment).

                 A drop-down rather than three radios in a row. Radios put every option on screen at
                 once, which only works while every option is SHORT — true of the Chinese labels
                 and of nothing else. "Common (both genders)" and "Mixte (les deux genres)" do not
                 fit three-abreast in a 420px dialog, and any alphabetic language will be the same.
                 A drop-down costs one click and is indifferent to label length.

                 Label above the control, not beside it, for the same reason: a long label plus a
                 control on one line reintroduces the width problem it was meant to solve. -->
            <!-- Laid out as one of the language rows below: a 120px label column and the control in
                 the remaining width. That is what makes the gender box line up with, and measure the
                 same as, the per-language name boxes — the two blocks read as one form rather than
                 as a header stuck above a list. -->
            <Grid Grid.Row="2" x:Name="GenderPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#4F46E5"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Gender], Mode=OneWay}"/>

                <!-- The item template drives the closed face too: WPF copies ItemTemplate into
                     SelectionBoxItemTemplate, which the themed ComboBox's face presenter binds to.
                     So the symbol shows both in the list and on the collapsed control. -->
                <ComboBox Grid.Column="1" x:Name="GenderBox" SelectedValuePath="Value"
                          Grid.IsSharedSizeScope="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The symbol sits in a SHARED-SIZE column, not one of a fixed width.
                                 The three marks are different widths — "♂♀" is twice "♂" — so the
                                 labels only line up if the column takes the widest, and a guessed
                                 fixed width CLIPS: at 26px the pair lost its second glyph and read
                                 as a missing-glyph box. Auto + SharedSizeGroup measures it instead
                                 of guessing, and covers the closed face as well as the open list
                                 because the scope is declared on the ComboBox itself. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="GenderSymbol"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="14"
                                           Foreground="#4F46E5" VerticalAlignment="Center"
                                           Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <ItemsControl Grid.Row="3" x:Name="LanguageRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LanguageName}" VerticalAlignment="Center" Foreground="#4F46E5"/>
                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7,5" BorderBrush="#CBD3DA" BorderThickness="1"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- MinWidth, not Width. At a fixed 90px the French "Enregistrer" rendered as
                 "Enregistre" — the same fixed-size-for-the-shortest-language fault as the radios
                 above, just on a button. A minimum keeps the two buttons evenly matched in Chinese
                 while letting either grow for a longer label. -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Cancel], Mode=OneWay}"
                        MinWidth="90" Height="32" Padding="14,0" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick"/>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[TermLanguage.Save], Mode=OneWay}"
                        MinWidth="90" Height="32" Padding="14,0" IsDefault="True" Click="OnSaveClick"
                        Background="#4F46E5" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
