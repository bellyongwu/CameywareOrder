<Window x:Class="CameywareOrder.Views.DataProtectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.Title], Mode=OneWay}"
        Height="760" Width="960"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="{StaticResource PageBackgroundBrush}">
    <!-- What happens if something goes wrong: how often the application copies itself, how many
         copies it keeps, how long a deleted order can be recovered, and the copies themselves.

         Installation-wide, not per shop — a backup covers every shop at once and a restore replaces
         every shop at once, which is why the restore button carries the typed-phrase confirmation
         that the shop-deletion buttons do.

         Every brush and style is from Themes/AppTheme.xaml. -->
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="SettingCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <Style x:Key="SettingHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
            </Style>

            <Style x:Key="BackupCardContainer" TargetType="ListBoxItem" BasedOn="{StaticResource RosterCardContainer}">
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" CornerRadius="8" Background="White"
                                    BorderBrush="#E5E7EB" BorderThickness="1"
                                    Padding="14,10" SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#A5B4FC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#4F46E5"/>
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Card" Property="Background" Value="#EEF2FF"/>
                                    <Setter TargetName="Card" Property="Padding" Value="13,9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.Title], Mode=OneWay}"
                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.Subtitle], Mode=OneWay}"
                           FontSize="12" Foreground="#DDD6FE" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── The settings ─────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeading}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.BackupSection], Mode=OneWay}"/>

                            <CheckBox x:Name="AutomaticBackupCheck" Margin="0,10,0,0"
                                      Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.Automatic], Mode=OneWay}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SettingCaption}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.Interval], Mode=OneWay}"/>
                                <ComboBox x:Name="IntervalBox" Grid.Column="1"
                                          SelectionChanged="OnSettingChanged"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SettingCaption}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.Keep], Mode=OneWay}"/>
                                <ComboBox x:Name="RetentionBox" Grid.Column="1"
                                          SelectionChanged="OnSettingChanged"/>
                            </Grid>

                            <!-- Written from code: it interleaves a real timestamp, and it is the one
                                 place a schedule that is silently failing becomes visible. -->
                            <TextBlock x:Name="LastBackupText" Style="{StaticResource SettingHint}"/>

                            <Button x:Name="BackupNowButton" Margin="0,12,0,0" Padding="12,8"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.BackupNow], Mode=OneWay}"
                                    Click="OnBackupNowClick"/>

                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.BackupHint], Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeading}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.BinSection], Mode=OneWay}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SettingCaption}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.BinRetention], Mode=OneWay}"/>
                                <ComboBox x:Name="BinRetentionBox" Grid.Column="1"
                                          SelectionChanged="OnSettingChanged"/>
                            </Grid>

                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.BinHint], Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── The copies ───────────────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource CardHeading}" Margin="2,0,0,10"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.CopiesSection], Mode=OneWay}"/>

                <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E5E7EB"
                        BorderThickness="1" Padding="14">
                    <Grid>
                        <ListBox x:Name="BackupList" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource BackupCardContainer}"
                                 SelectionChanged="OnBackupSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Headline}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#6B7280"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="10,3"
                                                Background="#E0E7FF" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindText}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#3730A3"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="NoBackupsText" Visibility="Collapsed"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.NoCopies], Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" MaxWidth="340"
                                   TextAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="10" BorderBrush="#FECACA"
                        BorderThickness="1" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RestoreButton" Style="{StaticResource DangerButton}"
                                    Padding="12,8" Margin="0,0,8,0" IsEnabled="False"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.Restore], Mode=OneWay}"
                                    Click="OnRestoreClick"/>
                            <Button x:Name="RevealButton" Padding="12,8" Margin="0,0,8,0"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.OpenFolder], Mode=OneWay}"
                                    Click="OnOpenFolderClick"/>
                            <Button x:Name="DeleteBackupButton" Padding="12,8" IsEnabled="False"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.DeleteCopy], Mode=OneWay}"
                                    Click="OnDeleteBackupClick"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingHint}" Foreground="#B91C1C"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataProtection.RestoreHint], Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" MaxWidth="620"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" Padding="16,7" IsCancel="True"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Store.Manage.Close], Mode=OneWay}"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
