<Window x:Class="CameywareOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:CameywareOrder.Converters"
        xmlns:ctrl="clr-namespace:CameywareOrder.Controls"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:svc="clr-namespace:CameywareOrder.Services"
        xmlns:local="clr-namespace:CameywareOrder"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.MainTitle], Mode=OneWay}"
        Height="1440" Width="2560"
        MinHeight="720" MinWidth="1180"
        Icon="/Assets/ICONS/app-icon.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnMainWindowPreviewKeyDown">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:OrderStatusToLocalizedTextConverter x:Key="OrderStatusToLocalizedTextConverter"/>
        <conv:SearchFieldNameConverter x:Key="SearchFieldName"/>
        <conv:LocalizationLookupConverter x:Key="LocalizationLookupConverter"/>
        <conv:CustomMadeRecordSummaryConverter x:Key="CustomMadeRecordSummaryConverter"/>
        <conv:CurrencyAmountConverter x:Key="CurrencyAmountConverter"/>
        <conv:OrderPaymentSummaryConverter x:Key="OrderPaymentSummaryConverter"/>
        <conv:BalanceStatusColorConverter x:Key="BalanceStatusColorConverter"/>
        <conv:PickupDueBrushConverter x:Key="PickupDueBrush"/>
        <conv:LastItemBorderThicknessConverter x:Key="LastItemBorderThickness"/>
        <conv:OrderServicesSummaryConverter x:Key="OrderServicesSummaryConverter"/>
        <conv:PositiveAmountToVisibilityConverter x:Key="PositiveAmountToVisibility"/>
        <conv:TaxLabelConverter x:Key="TaxLabel"/>
        <conv:CustomMadeServiceFlagConverter x:Key="CustomMadeServiceFlagConverter"/>
        <conv:ReturnReasonSummaryConverter x:Key="ReturnReasonSummaryConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- The right-click menu deliberately declares NO local styles. It used to carry a
             ContextMenu style and a MenuItem style, neither with BasedOn — and an explicit style
             without BasedOn REPLACES the implicit one rather than adding to it, so both quietly
             opted the menu out of the theme: the items fell back to the stock Windows template
             while the menu bar overhead used the themed one, and the ContextMenu style dropped
             Grid.IsSharedSizeScope, which is what lines the icon gutter up. Leaving the styles off
             entirely lets AppTheme's implicit ContextMenu/MenuItem styles apply, which is the
             behaviour that was wanted in the first place. -->

        <!-- Card container used to lift the detail sections off the flat background -->
        <Style x:Key="DetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Column header styling for the orders ListView/GridView -->
        <Style x:Key="OrderListHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#6D68EA"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#DDD6FE"
                                       Text="{Binding Column.(local:OrderColumnSort.SortGlyph), RelativeSource={RelativeSource AncestorType=GridViewColumnHeader}}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Orders row: taller rows, hover, animated selection highlight, gray-out completed -->
        <Style x:Key="OrderListItemStyle" TargetType="ListViewItem">
            <Setter Property="FontSize" Value="{Binding Value, ElementName=RecordFontSizeSlider}"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnOrderRowRightClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Selection/focus color that fades in and out (Requirement D) -->
                                <Border x:Name="Highlight" Background="#EEF2FF" Opacity="0" SnapsToDevicePixels="True"/>
                                <!-- How close this order is to the day it was promised for: amber
                                     inside two weeks, red once that day has gone.

                                     ABOVE the selection highlight, and semi-transparent, so the two
                                     mix rather than one hiding the other. Rendering it the other way
                                     round showed why that matters: the list opens with the FIRST row
                                     selected, the first row is the most overdue one, and the opaque
                                     selection colour painted over the only warning on screen. Below
                                     the accent bar, which still has to read as "this row is the one
                                     selected". -->
                                <Border x:Name="DueTint" Background="{Binding Converter={StaticResource PickupDueBrush}}"
                                        SnapsToDevicePixels="True"/>
                                <Border x:Name="Accent" Width="4" HorizontalAlignment="Left" Background="#4F46E5" Opacity="0"/>
                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                      Columns="{TemplateBinding GridView.ColumnCollection}"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.30"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Gray out completed records; shipped counts as completed/picked up (Accessibility B) -->
                            <DataTrigger Binding="{Binding IsPickedUp}" Value="True">
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#6C7783"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </DataTrigger>
                            <!-- Cancelled / returned records are more faded than completed (lighter gray, but still legible). -->
                            <DataTrigger Binding="{Binding IsRefunded}" Value="True">
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#98A1AB"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradientBrush}" Padding="20,13">
            <!-- Two columns rather than one cell with both children overlapping. That worked while
                 the left side was a single short name; the address underneath it is long enough to
                 run under the subtitle on the right, so the two now have their own space and the
                 address ellipsizes instead of colliding. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- The open shop's own name, in the current UI language. Falls back to the
                         Main.HeaderTitle string when no shop is open, so it never renders blank. -->
                    <TextBlock Text="{Binding Source={x:Static svc:ShopContext.Instance}, Path=CurrentName, Mode=OneWay}"
                               Foreground="White" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <!-- The address answers "which branch am I actually working in", which the name
                         alone does not when two branches read similarly. Hidden outright when the
                         shop has none: an empty line under the title would just look like a
                         rendering fault, and the address is an optional field. -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                Visibility="{Binding Source={x:Static svc:ShopContext.Instance}, Path=HasAddress, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE707;" FontSize="12"
                                   Foreground="{StaticResource TextOnHeaderSubtleBrush}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Source={x:Static svc:ShopContext.Instance}, Path=CurrentAddress, Mode=OneWay}"
                                   Foreground="{StaticResource TextOnHeaderSubtleBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Main.HeaderSubtitle], Mode=OneWay}"
                           Foreground="{StaticResource TextOnHeaderSubtleBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Status bar ──────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StatusBar.Label], Mode=OneWay}" Margin="4,0,8,0" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Margin="4,0"/>
            </StatusBarItem>
            <!-- Administrator only; hidden in code together with the Local Database and Import/Export menus.
                 It is the same information those menus act on, printed rather than clicked. -->
            <Separator x:Name="DataPathSeparator"/>
            <StatusBarItem x:Name="DataPathLabelItem">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataPath.Label], Mode=OneWay}" Margin="4,0,4,0" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem x:Name="DataPathValueItem">
                <TextBlock Text="{Binding DatabaseFilePath}" Margin="0,0,4,0" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── System bar ──────────────────────────────────────────────────
             SYSTEM concerns only. Everything that acts on an ORDER moved into the records panel
             below, next to the records it acts on. A Border + Grid rather than a ToolBar, because a
             ToolBar cannot right-align part of its content and adds an overflow chevron nobody
             asked for. -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="16,9">
            <!-- Laid out in COLUMNS rather than as a left/right pair of stacks, so the visual order
                 is set by Grid.Column and the Local Configuration block below can keep its place in the
                 while sitting second on screen. An Auto column collapses to nothing when its child
                 is hidden, so the language pair leaves no gap for the users who never see it.

                 Local Configuration sits well BEFORE Store Members, not last: its drop-down opens down-and-left from
                 the item, so the further right it sits the more it fights the window edge. Keeping
                 controls to its right leaves the menu room to open normally, which is why the
                 right-aligned menu variant this once needed could be dropped again. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" Margin="0,0,18,0">
                    <MenuItem Padding="10,4"
                              AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalConfig], Mode=OneWay}"
                              ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalConfig], Mode=OneWay}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalConfig], Mode=OneWay}" VerticalAlignment="Center"/>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                      Width="8" Height="4" Stretch="Fill" Margin="6,2,0,0" VerticalAlignment="Center"
                                      SnapsToDevicePixels="True"/>
                            </StackPanel>
                        </MenuItem.Header>
                        
                        <!-- Everyone may switch shop; the picker only lists the shops their
                             account is assigned to. -->
                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.SwitchShop], Mode=OneWay}" Click="OnSwitchShopClick"/>
                        <!-- Administrators and the shop's manager; hidden in code. Edits the OPEN
                             shop's name, language, currency and tax rules. -->
                        <MenuItem x:Name="ShopSettingsMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.ShopSettings], Mode=OneWay}" Click="OnShopSettingsClick"/>
                        <!-- Administrators only; accounts span every shop. -->
                        <MenuItem x:Name="UserManagementMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.UserManagement], Mode=OneWay}" Click="OnUserManagementClick"/>
                        <!-- Beside the accounts it governs: "who works here" and "what may they do"
                             are read together, and the shop picker offers the same pair. -->
                        <MenuItem x:Name="PermissionsMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Permissions], Mode=OneWay}" Click="OnPermissionsClick"/>
                        <Separator x:Name="ConfigSeparator"/>
                        <!-- Currency Setup used to sit here. The currency is now part of Shop Settings,
                             belongs — it is a property OF a shop, and two places to set one value is
                             one place too many. -->
                        <MenuItem x:Name="SettlementMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Settlement], Mode=OneWay}" Click="OnSettlementClick"/>
                        <MenuItem x:Name="MeasurementTermsMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.MeasurementTerms], Mode=OneWay}" Click="OnMeasurementTermsClick"/>
                        <!-- The shop's ready-made categories. Beside the measurement terms because
                             both answer "what does this branch sell and how is it described". -->
                        <MenuItem x:Name="ProductCatalogMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.ProductCatalog], Mode=OneWay}" Click="OnProductCatalogClick"/>
                        <!-- The shop's own deleted orders, so it sits with the shop's things rather
                             than with the installation-wide tools below. Its own capability: deleting
                             is reversible now and costs little, while this is where a record goes
                             beyond recovery — and where every order anyone has deleted can be read. -->
                        <MenuItem x:Name="RecycleBinMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.RecycleBin], Mode=OneWay}" Click="OnRecycleBinClick"/>
                        <MenuItem x:Name="PrintMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Print], Mode=OneWay}">
                            <!-- One order per printout: gated on exactly one selected row, the same
                                 rule the row context menu applies.

                                 The two measurement entries used to bind their own Visibility to
                                 SelectedOrder.HasCustomMadeService. They are set from code now
                                 (RefreshOrderActions) because there are two conditions — the order
                                 has measurements AND the user may print at all — and a code-set
                                 Visibility REPLACES a binding rather than combining with it, so the
                                 two rules would have silently taken turns. -->
                            <MenuItem x:Name="PrintReceiptMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintReceipt], Mode=OneWay}" Click="OnPrintReceiptClick"
                                      IsEnabled="{Binding HasSingleSelection}"/>
                            <MenuItem x:Name="PrintMeasurementsMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintMeasurements], Mode=OneWay}" Click="OnPrintMeasurementsClick"
                                      IsEnabled="{Binding HasSingleSelection}"/>
                            <MenuItem x:Name="PrintReceiptAndMeasurementsMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintReceiptAndMeasurements], Mode=OneWay}" Click="OnPrintReceiptAndMeasurementsClick"
                                      IsEnabled="{Binding HasSingleSelection}"/>
                            <!-- Staff print receipts but do not design them; hidden in code. -->
                            <MenuItem x:Name="HeaderFooterMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.HeaderFooter], Mode=OneWay}" Click="OnEditBrandingClick"/>
                        </MenuItem>
                        <!-- The next two act on the whole installation rather than on one shop, so
                             they are administrator-only; hidden in code.

                             Backup & Recovery lives INSIDE Local Database, at the top of it. Both
                             answer for the same thing — the file this installation keeps its data in
                             — and a top-level entry beside a submenu that also concerns the database
                             made "where do I go" a question with two plausible answers.

                             Its own capability still gates it (CanManageBackups, not CanUseDataTools),
                             so the parent has to be shown when EITHER is held and each child gated
                             separately; see ApplyRolePermissions. Nesting a differently-gated item is
                             what makes that necessary, and it is the part that would otherwise hide
                             this panel from exactly the person brought in to restore a backup. -->
                        <MenuItem x:Name="LocalDatabaseMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalDatabase], Mode=OneWay}">
                            <MenuItem x:Name="DataProtectionMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.DataProtection], Mode=OneWay}" Click="OnDataProtectionClick"/>
                            <Separator x:Name="DataPathToolsSeparator"/>
                            <MenuItem x:Name="CopyDataPathMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.CopyDataPath], Mode=OneWay}" Click="OnCopyDataPathClick"/>
                            <MenuItem x:Name="RevealDataFileMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.RevealDataFile], Mode=OneWay}" Click="OnRevealDataFileClick"/>
                            <MenuItem x:Name="OpenDataFolderMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.OpenDataFolder], Mode=OneWay}" Click="OnOpenDataFolderClick"/>
                        </MenuItem>
                        <MenuItem x:Name="ImportExportMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.ImportExport], Mode=OneWay}">
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.HeaderFooter], Mode=OneWay}">
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Import], Mode=OneWay}" Click="OnImportBrandingClick"/>
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Export], Mode=OneWay}" Click="OnExportBrandingClick"/>
                            </MenuItem>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.MeasurementTerms], Mode=OneWay}">
                                 <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Import], Mode=OneWay}" Click="OnImportMeasurementTermsClick"/>
                                 <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Export], Mode=OneWay}" Click="OnExportMeasurementTermsClick"/>
                            </MenuItem>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalDatabase], Mode=OneWay}">
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Import], Mode=OneWay}" Click="OnImportDatabaseClick"/>
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Export], Mode=OneWay}" Click="OnExportDatabaseClick"/>
                            </MenuItem>
                            <Separator/>
                            <!-- Everything at once: database + measurement terms + branding + currency + language. -->
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.GlobalSettings], Mode=OneWay}">
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Import], Mode=OneWay}" Click="OnImportGlobalSettingsClick"/>
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Export], Mode=OneWay}" Click="OnExportGlobalSettingsClick"/>
                            </MenuItem>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!-- The greeting leads: it names who is signed in, which is the first thing the bar
                     should answer. Everything after it is what you can do as that person. The
                     languages this branch runs in sit directly under it, in the same block, because
                     they are the same kind of fact — the standing state of the session, not an
                     action. Both are written from code, so both re-render on a language switch. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0"
                            HorizontalAlignment="Left">
                    <TextBlock x:Name="GreetingText"
                               Foreground="#4B5563" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="InstalledLanguagesText" Margin="0,1,0,0"
                               Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- The language pair is hidden in code whenever there is only ONE language to pick
                     from: the shop's installed set for a manager or staff member, every shipped
                     language for an administrator. -->
                <TextBlock x:Name="LanguageSwitchLabel" Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Language], Mode=OneWay}"
                           VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6B7280" FontSize="13"/>
                <ComboBox x:Name="LanguageSwitchBox" Grid.Column="3" Width="132" Margin="0,0,12,0" VerticalAlignment="Center"
                          SelectionChanged="OnLanguageChanged"/>
                <!-- The open shop's roster. Manager + administrator only; hidden in code. The glyph
                     is a vector rather than an image so it stays crisp at any DPI and needs no asset. -->
                <Button x:Name="StoreMembersButton" Grid.Column="4" Click="OnStoreMembersClick" Padding="12,7" Margin="0,0,10,0"
                        ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Title], Mode=OneWay}"
                        AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Title], Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Two people: one in front, one behind. -->
                        <Canvas Width="18" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse Canvas.Left="3.4" Canvas.Top="1.6" Width="5.8" Height="5.8"
                                     Stroke="#4F46E5" StrokeThickness="1.5"/>
                            <Path Stroke="#4F46E5" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 1.2 14.2 C 1.2 10.8 3.7 9.3 6.3 9.3 C 8.9 9.3 11.4 10.8 11.4 14.2"/>
                            <Ellipse Canvas.Left="11.2" Canvas.Top="3.2" Width="4.4" Height="4.4"
                                     Stroke="#7C3AED" StrokeThickness="1.3"/>
                            <Path Stroke="#7C3AED" StrokeThickness="1.3" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 12.9 9.5 C 15.3 9.8 16.8 11.3 16.8 14.2"/>
                        </Canvas>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Members.Title], Mode=OneWay}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Beside Sign Out, and before it: locking is the one you want several times a day
                     and signing out is the one you want at the end of a shift, so the frequent one
                     is nearer the content and the ending one sits at the edge. Both raise the same
                     panel; this button is the discoverable route to what ESC does. -->
                <Button Grid.Column="5" Click="OnLockClick" Padding="12,7" Margin="0,0,8,0"
                        ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LockHint], Mode=OneWay}"
                        AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Lock], Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <!-- A padlock: shackle over a closed body. -->
                        <Canvas Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Path Stroke="#4F46E5" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 5 7 L 5 4.8 C 5 3.1 6.3 1.8 8 1.8 C 9.7 1.8 11 3.1 11 4.8 L 11 7"/>
                            <Rectangle Canvas.Left="3.2" Canvas.Top="7" Width="9.6" Height="7.2"
                                       RadiusX="1.6" RadiusY="1.6" Stroke="#4F46E5" StrokeThickness="1.6"/>
                        </Canvas>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Lock], Mode=OneWay}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" Click="OnSignOutClick" Padding="12,7"
                        ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.SignOut], Mode=OneWay}"
                        AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.SignOut], Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Door with an arrow leaving it. -->
                        <Canvas Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Path Stroke="#B45309" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 9.5 2.5 L 3 2.5 L 3 13.5 L 9.5 13.5"/>
                            <Path Stroke="#B45309" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 7.5 8 L 14 8 M 11.2 5.2 L 14 8 L 11.2 10.8"/>
                        </Canvas>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.SignOut], Mode=OneWay}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Main area ───────────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="30*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="14,14,10,14">
                <Grid.RowDefinitions>
                    <!-- summary strip, records header, filters, list, paging -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── This month at a glance ───────────────────────────────────────────
                     The four figures a shop owner opens the application to see, over the period they
                     settle on. Every one of them comes from the SAME SettlementCalculator the report
                     window uses, so the strip and the report cannot disagree — the whole point of the
                     calculator being a pure function of the orders. Clicking it opens the full
                     report. Hidden until it has something to say. -->
                <Border x:Name="SummaryStrip" Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,10" Cursor="Hand"
                        MouseLeftButtonUp="OnSummaryClick" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,22,0">
                            <TextBlock x:Name="SummaryTitleText" FontSize="13" FontWeight="Bold" Foreground="#4F46E5"/>
                            <TextBlock x:Name="SummaryPeriodText" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ItemsControl Grid.Column="1" x:Name="SummaryMetricList" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,26,0">
                                        <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{Binding Accent}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Column="2" x:Name="SummaryOpenText" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#4F46E5" TextDecorations="Underline"/>
                    </Grid>
                </Border>

                <!-- ── Records: title, count, and the actions that act on a record ──────
                     These four used to live in the top toolbar, two panels away from the list they
                     operate on. They belong to the records, so they sit with the records. -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Main.Records], Mode=OneWay}"
                                       FontSize="15" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                            <Border CornerRadius="10" Background="#EEF2FF" Padding="9,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredCount}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#3730A3"/>
                            </Border>
                            <!-- Shown only while a BATCH is armed. The reach of Delete has to be on
                                 screen before it is pressed: rows selected with Ctrl+click can be
                                 scrolled out of sight, and the count is the only thing that says
                                 how many are still in. Deliberately the warning pair rather than the
                                 indigo of the count badge beside it — two identical badges read as
                                 two counts of the same thing. -->
                            <Border CornerRadius="10" Background="{StaticResource WarningSoftBrush}"
                                    Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasBatchSelection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectionSummary}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="NewOrderButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="18,8"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.NewOrder], Mode=OneWay}"
                                    Click="OnAddOrderClick"/>
                            <!-- Exactly one row, not "at least one": with a batch selected there is
                                 no single order for this button to open. -->
                            <Button x:Name="EditOrderButton" Margin="0,0,8,0"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.EditOrder], Mode=OneWay}"
                                    Click="OnEditOrderClick"
                                    IsEnabled="{Binding HasSingleSelection}"/>
                            <Button x:Name="DeleteOrderButton" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.DeleteOrder], Mode=OneWay}"
                                    Command="{Binding DeleteOrderCommand}"/>
                            <!-- Where Refresh used to be. Refresh is F5 now — a key every Windows
                                 user already tries — and this is the action that earns a place in a
                                 bar of five buttons. Tinted green: it neither creates nor destroys,
                                 so it should read as neither the primary action nor a dangerous one. -->
                            <Button x:Name="ExportCsvButton" Style="{StaticResource AccentGreenButton}"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Csv.Export.Action], Mode=OneWay}"
                                    ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Csv.Export.Hint], Mode=OneWay}"
                                    Click="OnExportCsvClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Two rows since v8.0. The search grew a FIELD selector and a date range, which one
                     row could not hold without either wrapping unpredictably or pushing the font
                     slider off the right of a narrow window. Row 0 is what the bar has always been;
                     row 1 is the narrowing that used not to exist. -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Search.Label], Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Named so it can be addressed directly. Reaching it as "the first TextBox
                             in the window" is fragile: a ComboBox template carries an internal
                             PART_EditableTextBox, so a control appearing earlier in the bar silently
                             becomes "the search box" to anything walking the visual tree. -->
                        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                 AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Search.Label], Mode=OneWay}"/>

                        <TextBlock Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Filter.Status.Label], Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Grid.Column="3" Width="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value, Converter={StaticResource OrderStatusToLocalizedTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="4" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.PageSize], Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox Grid.Column="5" Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                        <!-- Opens the second row. Its content is written from code, because it
                             carries three things at once: the label, a caret saying which way it will
                             go, and a mark when the row it hides holds an active filter — without
                             which a list narrowed by a collapsed date range looks broken. -->
                        <Button x:Name="AdvancedSearchButton" Grid.Column="6" Margin="16,0,0,0"
                                Padding="12,5" VerticalAlignment="Center"
                                Click="OnToggleAdvancedSearchClick"/>

                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Filter.RecordFontSize], Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <Slider x:Name="RecordFontSizeSlider" Width="150" VerticalAlignment="Center"
                                    Minimum="12" Maximum="40" Value="18"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    SmallChange="1" LargeChange="2"/>
                            <TextBlock Text="{Binding Value, ElementName=RecordFontSizeSlider, StringFormat={}{0:0}px}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Where to look, and over what period. Collapsed until Advanced search is
                         opened: a shop looking somebody up types a name and presses nothing else, and
                         four more controls on permanent display are four the everyday case has to
                         read past. -->
                    <Grid x:Name="AdvancedFilterPanel" Grid.Row="1" Margin="0,10,0,0"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Search.Field.Label], Mode=OneWay}"/>
                        <ComboBox x:Name="SearchFieldBox" Grid.Column="1" Width="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding SearchFieldOptions}"
                                  SelectedItem="{Binding SearchField}"
                                  AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Search.Field.Label], Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SearchFieldName}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Settlement.Period.From], Mode=OneWay}"/>
                        <!-- No Width: the drop-down calendar is floored at the box's width, so a box
                             pinned narrower than the calendar needs leaves it hanging off. The floor
                             lives in the themed picker; a call site only has to not override it. -->
                        <DatePicker x:Name="FromDatePicker" Grid.Column="3" VerticalAlignment="Center"
                                    SelectedDate="{Binding FromDate}"/>

                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,8,0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Settlement.Period.To], Mode=OneWay}"/>
                        <DatePicker x:Name="ToDatePicker" Grid.Column="5" VerticalAlignment="Center"
                                    SelectedDate="{Binding ToDate}"/>

                        <!-- Tinted rather than plain. It shipped as a bare themed Button and read as
                             one more input in a row of inputs; it is the only control here that ACTS,
                             so it takes the theme's indigo tint — the same one the administrator
                             tools use — and stops looking like a fourth filter. -->
                        <Button x:Name="ClearFiltersButton" Grid.Column="6" Margin="16,0,0,0" Padding="12,5"
                                VerticalAlignment="Center"
                                Style="{StaticResource AccentIndigoButton}"
                                IsEnabled="{Binding HasQuery}"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Search.Clear], Mode=OneWay}"
                                Click="OnClearFiltersClick"/>

                    </Grid>
                  </Grid>
                </Border>

                <!-- Both scrollbars are Auto. Nothing in a row wraps, so a window too narrow for the
                     columns can only be answered by scrolling to them — Disabled left the rightmost
                     columns clipped with no way to reach them.

                     SelectionMode is Extended, not Multiple: a plain click still selects one row,
                     which is what this list has always done, and Ctrl+click adds or removes one.
                     Multiple would turn every plain click into a toggle. Extended is also what
                     gives Ctrl+A for nothing — ListBox enables its own SelectAll command binding in
                     this mode alone — and SelectAll reaches the loaded items, which IS the current
                     page, because paging happens in the view model. -->
                <ListView Grid.Row="3"
                          x:Name="OrdersListView"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          MouseDoubleClick="OnOrderRowDoubleClick"
                          KeyDown="OnOrderRowKeyDown"
                          SizeChanged="OnOrdersListSizeChanged"
                          GridViewColumnHeader.Click="OnOrderColumnHeaderClick"
                          SelectionChanged="OnOrdersSelectionChanged"
                          SelectionMode="Extended"
                          ctrl:CopyPasteBinding.Surface="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                          ItemContainerStyle="{StaticResource OrderListItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          BorderBrush="#DDD" BorderThickness="1">
                    <ListView.ContextMenu>
                        <!-- Copy and Delete act on the WHOLE selection and stay enabled for a batch.
                             Everything else here opens or prints "the" order, which a multiple
                             selection has no answer to, so each is gated on HasSingleSelection. -->
                        <ContextMenu>
                            <MenuItem x:Name="EditContextMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.EditOrder], Mode=OneWay}" Click="OnContextEditClick"
                                      IsEnabled="{Binding HasSingleSelection}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70F;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CopyContextMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.CopyOrder], Mode=OneWay}" Click="OnContextCopyClick">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="DeleteContextMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.DeleteOrder], Mode=OneWay}" Click="OnContextDeleteClick" Style="{StaticResource DangerMenuItem}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" Foreground="{StaticResource DangerBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="PrintContextSeparator"/>
                            <MenuItem x:Name="PrintReceiptContextMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintReceipt], Mode=OneWay}" Click="OnContextPrintClick"
                                      IsEnabled="{Binding HasSingleSelection}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE749;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="PrintMeasurementsContextMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintMeasurements], Mode=OneWay}" Click="OnContextPrintMeasurementsClick"
                                      IsEnabled="{Binding HasSingleSelection}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE1D3;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="PrintBothContextMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintReceiptAndMeasurements], Mode=OneWay}" Click="OnContextPrintReceiptAndMeasurementsClick"
                                      IsEnabled="{Binding HasSingleSelection}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE749;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource OrderListHeaderStyle}">
                            <GridViewColumn local:OrderColumnSort.SortKey="OrderNumber" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderNumber], Mode=OneWay}" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource NumericCellText}" Text="{Binding OrderNumber}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- A CellTemplate rather than DisplayMemberBinding, here and on the two
                                 columns below. DisplayMemberBinding generates a bare TextBlock that
                                 cannot be styled, so an over-long value is CLIPPED mid-glyph with no
                                 ellipsis and no way to read the rest. -->
                            <GridViewColumn local:OrderColumnSort.SortKey="CustomerName" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.CustomerName], Mode=OneWay}" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource ListCellText}" Text="{Binding CustomerName}"
                                                   ToolTip="{Binding CustomerName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn local:OrderColumnSort.SortKey="PhoneNumber" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PhoneNumber], Mode=OneWay}" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource NumericCellText}" Text="{Binding PhoneNumber}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- 165, not 130: these widths have to hold the LONGEST language's header,
                                 and French runs about a quarter longer than English — "Date de la
                                  commande" against the English "Order Date". Sized for French rather
                                 than for whichever language happened to be open when it was set. -->
                            <GridViewColumn local:OrderColumnSort.SortKey="OrderDate" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderDate], Mode=OneWay}" Width="165">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- OrderDateLocal, not OrderDate: the column stores UTC and a
                                             shop east of Greenwich would read a morning order as the
                                             day before. -->
                                        <TextBlock Style="{StaticResource NumericCellText}" Text="{Binding OrderDateLocal, StringFormat=yyyy-MM-dd}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- The day the list is ORDERED by and coloured by, so it has to be on
                                 screen: a row tinted red beside no date at all reads as a fault.
                                 Blank for every order taken before the field existed. -->
                            <GridViewColumn local:OrderColumnSort.SortKey="ExpectedPickupDate" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ExpectedPickupDate], Mode=OneWay}" Width="165">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource NumericCellText}" Text="{Binding ExpectedPickupDateLocal, StringFormat=yyyy-MM-dd}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn local:OrderColumnSort.SortKey="Status" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Status], Mode=OneWay}" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource ListCellText}"
                                                   Text="{Binding Status, Converter={StaticResource OrderStatusToLocalizedTextConverter}}"
                                                   ToolTip="{Binding Status, Converter={StaticResource OrderStatusToLocalizedTextConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn local:OrderColumnSort.SortKey="TotalAmount" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TotalAmount], Mode=OneWay}" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource NumericCellText}" FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                    <Binding Path="TotalAmount"/>
                                                    <Binding Path="CurrencyType"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn local:OrderColumnSort.SortKey="BalanceStatus" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.BalanceStatus], Mode=OneWay}" Width="270">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource ListCellText}"
                                                   Text="{Binding Converter={StaticResource OrderPaymentSummaryConverter}, ConverterParameter=Status}"
                                                   ToolTip="{Binding Converter={StaticResource OrderPaymentSummaryConverter}, ConverterParameter=Status}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- 195 for the same reason: "Service sur mesure" is the longest of the
                                 three headers this column carries. -->
                            <GridViewColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.CustomMadeFlag], Mode=OneWay}" Width="195">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Two lines: the flag, and the garments under it. Rows stay
                                             level because the second line is one line ALWAYS — its row
                                             is a fixed height that stands whether the names show or
                                             not, and the names themselves are trimmed rather than
                                             wrapped. An earlier version let them wrap freely, which
                                             made a row with several garments taller than its
                                             neighbours; that is what the fixed row height prevents,
                                             and both lines fit inside the row's existing MinHeight of
                                             54 so no row grew.

                                             The star COLUMN is what makes the ellipsis work: without a
                                             width imposed from outside, the names would never know
                                             they had overflowed and TextTrimming would never fire. -->
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="15"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Style="{StaticResource ListCellText}"
                                                       Text="{Binding Converter={StaticResource CustomMadeServiceFlagConverter}, ConverterParameter=Flag}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Style="{StaticResource ListCellText}"
                                                       Text="{Binding Converter={StaticResource CustomMadeServiceFlagConverter}, ConverterParameter=Names}"
                                                       ToolTip="{Binding Converter={StaticResource CustomMadeServiceFlagConverter}, ConverterParameter=Names}"
                                                       Visibility="{Binding Converter={StaticResource CustomMadeServiceFlagConverter}, ConverterParameter=NamesVisibility}"
                                                       FontSize="11" Foreground="#666"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                    <!-- LiveSetting=Polite: a screen reader announces the new "page 2 of 5, 87 records"
                         when paging happens, which is the only feedback a non-sighted user gets that
                         the arrow key did anything. Raised from code-behind on each change. -->
                    <TextBlock x:Name="PageSummaryText" Text="{Binding PageSummary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.Previous], Mode=OneWay}"
                                Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" Padding="10,4"
                                ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.PreviousHint], Mode=OneWay}"
                                AutomationProperties.HelpText="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.PreviousHint], Mode=OneWay}"/>
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.Next], Mode=OneWay}"
                                Command="{Binding NextPageCommand}" Padding="10,4"
                                ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.NextHint], Mode=OneWay}"
                                AutomationProperties.HelpText="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.NextHint], Mode=OneWay}"/>
                    </StackPanel>
                </DockPanel>

                <!-- LAST child and spanning every row, so it covers the whole records column: the
                     filters and the action bar have to be unreachable while the list under them is
                     being rewritten, or a second Delete lands on rows that are already going.
                     It hides itself; nothing needs to set its Visibility. -->
                <ctrl:BusyOverlay Grid.Row="0" Grid.RowSpan="5" Tracker="{Binding Busy}"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- Detail panel (visible only when an order is selected) -->
            <ScrollViewer Grid.Column="2" Margin="0,8,8,8"
                          VerticalScrollBarVisibility="Auto"
                          Background="#F9FAFB"
                          Visibility="{Binding SelectedOrder, Converter={StaticResource NullToVisibility}}">
                <Border Background="White" CornerRadius="10" Margin="6" Padding="20"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <Border Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="#4F46E5" BorderThickness="0,0,0,2">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.Title], Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#4F46E5"/>
                    </Border>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderNumber], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.OrderNumber}"   Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.CustomerName], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.CustomerName}"  Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PhoneNumber], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.PhoneNumber}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Email], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Email}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Address], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Address}" Margin="0,2,0,10" FontSize="13" TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderDate], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <!-- The DAY, with no time: the order form records a date, so an order backdated to
                         last Monday would otherwise read "00:00" here and look like missing data. When
                         it was SAVED is the line below, and that one is a real timestamp. -->
                    <TextBlock Text="{Binding SelectedOrder.OrderDateLocal, StringFormat=yyyy-MM-dd}"
                               Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ExpectedPickupDate], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.ExpectedPickupDateLocal, StringFormat=yyyy-MM-dd}"
                               Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.LastModifiedDate], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.LastModifiedDate, StringFormat='yyyy-MM-dd  HH:mm'}"
                               Margin="0,2,0,10" FontSize="13"/>

                    <!-- Who served the order, beside when it was last saved — the two answer one
                         question together. Label and value share a panel so they hide as a pair:
                         every order saved before this column existed has no name, and a label with
                         nothing under it reads as a value that failed to load. The receipt omits
                         the same line for the same reason. -->
                    <StackPanel Visibility="{Binding SelectedOrder.LastModifiedBy, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.LastModifiedBy], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedOrder.LastModifiedBy}" Margin="0,2,0,10" FontSize="13"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Status], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Status, Converter={StaticResource OrderStatusToLocalizedTextConverter}}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ServiceType], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder, Converter={StaticResource OrderServicesSummaryConverter}}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TotalAmount], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Margin="0,2,0,10" FontSize="15" FontWeight="Bold" Foreground="#047857">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                <Binding Path="SelectedOrder.TotalAmount"/>
                                <Binding Path="SelectedOrder.CurrencyType"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Deposit pair: nominal deposit + actually received deposit (incl. card tax). -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Downpayment], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#047857">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.TotalDownpayment"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ReceivedDownpayment], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#047857">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ReceivedDownpayment"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Final balance pair: outstanding residual + actually received balance (incl. card tax). -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.FinalBalance], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.FinalBalance"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ReceivedFinalBalance], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#047857">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ReceivedFinalBalance"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.BalanceStatus], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder, Converter={StaticResource OrderPaymentSummaryConverter}, ConverterParameter=Status}" Foreground="{Binding SelectedOrder, Converter={StaticResource BalanceStatusColorConverter}}" Margin="0,2,0,10" FontSize="13" FontWeight="SemiBold"/>

                    <!-- Payment breakdown: only meaningful for orders that still owe/collect money.
                         Cancelled/returned orders show the cancellation/return reason instead. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOrder.IsRefunded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PaymentBreakdown], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedOrder, Converter={StaticResource OrderPaymentSummaryConverter}}" Margin="0,2,0,10" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedOrder.IsRefunded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.StatusReason], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                        <TextBlock Margin="0,2,0,10" FontSize="13" TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ReturnReasonSummaryConverter}">
                                    <Binding Path="SelectedOrder.StatusReasonCategory"/>
                                    <Binding Path="SelectedOrder.StatusReason"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Notes], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Notes}"         Margin="0,2,0,10"
                               FontSize="13" TextWrapping="Wrap"/>

                    <Border BorderBrush="#8A929B" BorderThickness="0,0,0,2" Margin="0,10,0,10"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.OrderItems], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Alterations service -->
                    <Border Style="{StaticResource DetailSectionCard}" Visibility="{Binding SelectedOrder.AlterationAddedToReceipt, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.Alterations], Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#4F46E5" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding SelectedOrder.ServiceDetails, Converter={StaticResource LocalizationLookupConverter}, ConverterParameter=Alteration.Category}" FontSize="12" TextWrapping="Wrap"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Subtotal], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                                <TextBlock Grid.Column="1" FontSize="12">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                            <Binding Path="SelectedOrder.AlterationSubtotal"/>
                                            <Binding Path="SelectedOrder.CurrencyType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,2,0,0" Visibility="{Binding SelectedOrder.AlterationTax, Converter={StaticResource PositiveAmountToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Bound to the ORDER, not to its PricesIncludeTax flag: where the tax is
                                     already in the price this line names the tax and its rate, which a bool
                                     cannot carry. See TaxLabelConverter. -->
                                <TextBlock Text="{Binding SelectedOrder, Converter={StaticResource TaxLabel}}" FontSize="12" Foreground="#666"/>
                                <TextBlock Grid.Column="1" FontSize="12">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                            <Binding Path="SelectedOrder.AlterationTax"/>
                                            <Binding Path="SelectedOrder.CurrencyType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Receipt.SectionTotal], Mode=OneWay}" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                            <Binding Path="SelectedOrder.AlterationTotal"/>
                                            <Binding Path="SelectedOrder.CurrencyType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Ready-made clothing / accessory -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DetailSectionCard}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOrder.ClothingAddedToReceipt}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.ReadyMade], Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#4F46E5" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" Padding="0,8">
                                    <Border.BorderThickness>
                                        <MultiBinding Converter="{StaticResource LastItemBorderThickness}">
                                            <Binding/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Items"/>
                                        </MultiBinding>
                                    </Border.BorderThickness>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName, Converter={StaticResource LocalizationLookupConverter}, ConverterParameter=ClothingItem}" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="#666">
                                                <Run Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.QuantityPrefix], Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Quantity}"/>
                                                <Run Text="  ×  "/>
                                                <Run>
                                                    <Run.Text>
                                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                            <Binding Path="EffectiveUnitPrice" Mode="OneWay"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedOrder.CurrencyType"/>
                                                        </MultiBinding>
                                                    </Run.Text>
                                                </Run>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock FontWeight="Bold">
                                                <Run>
                                                    <Run.Text>
                                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                            <Binding Path="TotalPrice" Mode="OneWay"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedOrder.CurrencyType"/>
                                                        </MultiBinding>
                                                    </Run.Text>
                                                </Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Subtotal], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ClothingSubtotal"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,2,0,0" Visibility="{Binding SelectedOrder.ClothingTax, Converter={StaticResource PositiveAmountToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TaxAmount], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ClothingTax"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Receipt.SectionTotal], Mode=OneWay}" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ClothingTotal"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Custom-made service -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DetailSectionCard}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOrder.CustomMadeAddedToReceipt}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.CustomMadeRecords], Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#4F46E5" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding SelectedOrder.CustomMadeRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" Padding="0,8">
                                    <Border.BorderThickness>
                                        <MultiBinding Converter="{StaticResource LastItemBorderThickness}">
                                            <Binding/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Items"/>
                                        </MultiBinding>
                                    </Border.BorderThickness>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Converter={StaticResource CustomMadeRecordSummaryConverter}}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold">
                                            <Run>
                                                <Run.Text>
                                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                        <Binding Path="SumTotal" Mode="OneWay"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedOrder.CurrencyType"/>
                                                    </MultiBinding>
                                                </Run.Text>
                                            </Run>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        <Grid Margin="0,6,0,0" Visibility="{Binding SelectedOrder.CustomMadeTax, Converter={StaticResource PositiveAmountToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TaxAmount], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.CustomMadeTax"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Receipt.SectionTotal], Mode=OneWay}" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.CustomMadeTotal"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</Window>
