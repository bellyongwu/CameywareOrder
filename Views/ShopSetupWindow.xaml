<Window x:Class="CameywareOrder.Views.ShopSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.CreateTitle], Mode=OneWay}"
        SizeToContent="Height"
        Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F6F9">
    <!-- Creates a shop, and edits one (本地配置 → 店铺设置). Both modes write the same four
         fields, so they share one window rather than drifting apart as two. -->
    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" Foreground="#1F2937"
                       Margin="0,0,0,16"/>

            <!-- ── Name, one box per installed language ────────────────────── -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Name], Mode=OneWay}"
                       Style="{StaticResource SectionLabelStyle}"/>
            <ItemsControl x:Name="NameItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LanguageName}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#4B5563"/>
                            <!-- PropertyChanged, not the default LostFocus: Save must see what is on
                                 screen even when the box still has focus. -->
                            <TextBox Grid.Column="1" Padding="7,5" FontSize="13"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.NameHint], Mode=OneWay}"
                       Style="{StaticResource HintStyle}" Margin="0,2,0,16"/>

            <!-- ── Preferred language ──────────────────────────────────────── -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.PreferredLanguage], Mode=OneWay}"
                       Style="{StaticResource SectionLabelStyle}"/>
            <ComboBox x:Name="LanguageBox" Padding="7,5" FontSize="13"/>
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.PreferredLanguageHint], Mode=OneWay}"
                       Style="{StaticResource HintStyle}" Margin="0,4,0,16"/>

            <!-- ── Currency ────────────────────────────────────────────────── -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Currency], Mode=OneWay}"
                       Style="{StaticResource SectionLabelStyle}"/>
            <ComboBox x:Name="CurrencyBox" Padding="7,5" FontSize="13" Margin="0,0,0,16"/>

            <!-- ── Measurement terms (creation only) ───────────────────────── -->
            <StackPanel x:Name="TermsSection">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.MeasurementTerms], Mode=OneWay}"
                           Style="{StaticResource SectionLabelStyle}"/>
                <RadioButton x:Name="SeedDefaultsRadio" GroupName="Terms" IsChecked="True" Margin="0,0,0,6"
                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.SeedDefaults], Mode=OneWay}"
                             Checked="OnTermsSourceChanged"/>
                <RadioButton x:Name="CopyFromRadio" GroupName="Terms"
                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.CopyFrom], Mode=OneWay}"
                             Checked="OnTermsSourceChanged"/>
                <ComboBox x:Name="CopySourceBox" Padding="7,5" FontSize="13" Margin="20,6,0,0" IsEnabled="False"/>
                <CheckBox x:Name="ConfigureNowCheck" Margin="0,12,0,0"
                          Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.ConfigureNow], Mode=OneWay}"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,14,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Cancel], Mode=OneWay}"
                        Padding="18,7" Margin="0,0,10,0" Click="OnCancelClick" IsCancel="True"/>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Save], Mode=OneWay}"
                        Padding="24,7" Background="#2980B9" Foreground="White" FontWeight="SemiBold"
                        Click="OnSaveClick" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
