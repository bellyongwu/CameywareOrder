<Window x:Class="CameywareOrder.Views.ShopSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.CreateTitle], Mode=OneWay}"
        Height="840" Width="820"
        MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBackgroundBrush}">
    <!-- Creates a shop, and edits one (Local Configuration → Shop Settings). Both modes write the same
         they share one window rather than drifting apart as two. Everything here is per shop: two
         branches can charge different tax on the same payment method and number their receipts
         differently. -->
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Coloured rule down the left of a card heading; the same accent language the order
             editor's payment cards use. -->
        <Style x:Key="AccentBarStyle" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PickerStyle" TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- One language's row of a per-language text field. Shared by the shop-name and address
             editors rather than written twice, so the two cannot drift apart; both bind the same
             LocalizedTextEntry. -->
        <DataTemplate x:Key="LocalizedFieldRow">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LanguageName}" VerticalAlignment="Center"
                           FontSize="12" Foreground="#4B5563"/>
                <!-- PropertyChanged, not the default LostFocus: Save must see what is on
                     screen even when the box still has focus. -->
                <TextBox Grid.Column="1" Style="{StaticResource InputStyle}"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="ModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="26,8"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#42505E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C3CCD6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title band ──────────────────────────────────────────────────────
             The same gradient every other top-level screen wears, so Shop Settings reads as part of the
             application rather than as a dialog that escaped it. -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="26,20">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Subtitle], Mode=OneWay}"
                           FontSize="13" Foreground="{StaticResource TextOnHeaderSubtleBrush}"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,0">
            <StackPanel>

                <!-- ── Shop identity ───────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource AccentBarStyle}"/>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.IdentitySection], Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Name, one box per installed language -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Name], Mode=OneWay}"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsControl x:Name="NameItems" ItemTemplate="{StaticResource LocalizedFieldRow}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.NameHint], Mode=OneWay}"
                                   Style="{StaticResource HintStyle}" Margin="0,2,0,16"/>

                        <!-- Address sits directly beneath the name and repeats its shape exactly: it
                             is per language for the same reason the name is — an address is prose,
                             and a receipt printed in one language should not carry the other's
                             wording. Phone / email / website below are NOT per language; they are
                             identifiers, identical whoever reads them. -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Address], Mode=OneWay}"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsControl x:Name="AddressItems" ItemTemplate="{StaticResource LocalizedFieldRow}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.AddressHint], Mode=OneWay}"
                                   Style="{StaticResource HintStyle}" Margin="0,2,0,16"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Phone], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <TextBox x:Name="PhoneBox" Style="{StaticResource InputStyle}" MaxLength="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Email], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <TextBox x:Name="EmailBox" Style="{StaticResource InputStyle}" MaxLength="120"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Website], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <TextBox x:Name="WebsiteBox" Style="{StaticResource InputStyle}" MaxLength="200"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.ContactHint], Mode=OneWay}"
                                   Style="{StaticResource HintStyle}" Margin="0,2,0,14"/>

                        <!-- The registration number identifies the BUSINESS, so it belongs to the
                             shop rather than to the receipt design. The header/footer editor carries
                             one too and overrides this where both are set — see Shop.TaxRegistrationNumber. -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.TaxNumber], Mode=OneWay}"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBox x:Name="TaxNumberBox" Style="{StaticResource InputStyle}" MaxLength="40"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.TaxNumberHint], Mode=OneWay}"
                                   Style="{StaticResource HintStyle}" Margin="0,2,0,16"/>

                        <!-- Which languages this branch runs in. A checkbox per shipped language
                             rather than a multi-select list: the whole set is three or four items
                             and every one of them has to be readable at a glance, since this is
                             what decides whether the branch's staff get a language toggle at all.
                             Generated from the shipped languages, so dropping a new *.lang.xml in
                             needs no change here. -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.InstalledLanguages], Mode=OneWay}"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsControl x:Name="InstalledLanguageItems" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsInstalled}"
                                              Margin="0,0,20,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.InstalledLanguagesHint], Mode=OneWay}"
                                   Style="{StaticResource HintStyle}" Margin="0,2,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Offers only the languages ticked above: the language a shop opens in
                                 has to be one it actually runs in, and enforcing that by what the
                                 picker CONTAINS beats validating it afterwards. -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.PreferredLanguage], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox x:Name="LanguageBox" Style="{StaticResource PickerStyle}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.PreferredLanguageHint], Mode=OneWay}"
                                           Style="{StaticResource HintStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Currency], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox x:Name="CurrencyBox" Style="{StaticResource PickerStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Payment methods & tax ───────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource AccentBarStyle}" Background="#047857"/>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Tax.Section], Mode=OneWay}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Tax.SectionHint], Mode=OneWay}"
                                   Style="{StaticResource HintStyle}" Margin="13,0,0,14"/>

                        <!-- Column captions; the row template below repeats this geometry exactly. -->
                        <Grid Margin="13,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="210"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeaderStyle}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Tax.MethodColumn], Mode=OneWay}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Tax.FreeColumn], Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Tax.RateColumn], Mode=OneWay}"/>
                        </Grid>

                        <!-- Rows are generated from PaymentTaxRules.ConfigurableMethods, so adding a
                             payment method later needs no XAML change. -->
                        <ItemsControl x:Name="PaymentTaxItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" CornerRadius="8" BorderBrush="#E8EDF3" BorderThickness="1"
                                            Padding="0,0,12,0" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="210"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="4" CornerRadius="8,0,0,8" Background="{Binding AccentColor}"/>

                                            <StackPanel Grid.Column="1" Margin="9,12,0,12">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                                                <TextBlock Text="{Binding StateSummary}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <RadioButton Grid.Column="2" GroupName="{Binding GroupName}" VerticalAlignment="Center"
                                                         IsChecked="{Binding IsTaxFree, Mode=TwoWay}"
                                                         Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Tax.Free], Mode=OneWay}"/>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton GroupName="{Binding GroupName}" VerticalAlignment="Center"
                                                             IsChecked="{Binding IsTaxable, Mode=TwoWay}"
                                                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Tax.Charge], Mode=OneWay}"/>
                                                <TextBox Width="66" Margin="10,0,0,0" Padding="6,4" FontSize="13" BorderBrush="#E5E7EB"
                                                         TextAlignment="Right" VerticalContentAlignment="Center"
                                                         IsEnabled="{Binding IsTaxable}"
                                                         Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#4B5563"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Receipt / order numbering ───────────────────────────── -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource AccentBarStyle}" Background="#D4AC0D"/>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.Section], Mode=OneWay}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.SectionHint], Mode=OneWay}"
                                   Style="{StaticResource HintStyle}" Margin="13,0,0,14"/>

                        <Grid Margin="13,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.Prefix], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <TextBox x:Name="PrefixBox" Style="{StaticResource InputStyle}" MaxLength="20"
                                         TextChanged="OnReceiptFormatChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.Padding], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox x:Name="PaddingBox" Style="{StaticResource PickerStyle}"
                                          SelectionChanged="OnReceiptFormatSelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.NextNumber], Mode=OneWay}"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <TextBox x:Name="NextNumberBox" Style="{StaticResource InputStyle}" MaxLength="9"
                                         TextChanged="OnReceiptFormatChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.Mode], Mode=OneWay}"
                                   Style="{StaticResource SectionLabelStyle}" Margin="13,16,0,8"/>
                        <StackPanel Margin="13,0,0,0">
                            <RadioButton x:Name="TimestampModeRadio" GroupName="OrderNumberMode" Style="{StaticResource ModeRadioStyle}"
                                         Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.ModeTimestamp], Mode=OneWay}"
                                         Checked="OnReceiptModeChanged"/>
                            <RadioButton x:Name="SequentialModeRadio" GroupName="OrderNumberMode" Style="{StaticResource ModeRadioStyle}"
                                         Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.ModeSequential], Mode=OneWay}"
                                         Checked="OnReceiptModeChanged"/>
                            <RadioButton x:Name="DailyModeRadio" GroupName="OrderNumberMode" Style="{StaticResource ModeRadioStyle}"
                                         Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.ModeDaily], Mode=OneWay}"
                                         Checked="OnReceiptModeChanged"/>
                            <RadioButton x:Name="YearlyModeRadio" GroupName="OrderNumberMode" Style="{StaticResource ModeRadioStyle}"
                                         Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.ModeYearly], Mode=OneWay}"
                                         Checked="OnReceiptModeChanged"/>
                        </StackPanel>

                        <Border Background="#F9FAFB" BorderBrush="#CFE3F0" BorderThickness="1" CornerRadius="8"
                                Padding="14,10" Margin="13,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Receipt.Preview], Mode=OneWay}"
                                           Foreground="#5A6773" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ReceiptPreviewText" Margin="10,0,0,0" FontSize="15" FontWeight="Bold"
                                           Foreground="#4338CA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Measurement terms (creation only) ───────────────────── -->
                <Border x:Name="TermsSection" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource AccentBarStyle}" Background="#8E7CC3"/>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.MeasurementTerms], Mode=OneWay}"/>
                        </StackPanel>
                        <RadioButton x:Name="SeedDefaultsRadio" GroupName="Terms" IsChecked="True" Margin="13,0,0,8"
                                     Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.SeedDefaults], Mode=OneWay}"
                                     Checked="OnTermsSourceChanged"/>
                        <RadioButton x:Name="CopyFromRadio" GroupName="Terms" Margin="13,0,0,0"
                                     Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.CopyFrom], Mode=OneWay}"
                                     Checked="OnTermsSourceChanged"/>
                        <ComboBox x:Name="CopySourceBox" Style="{StaticResource PickerStyle}" Margin="33,6,0,0" IsEnabled="False"/>
                        <CheckBox x:Name="ConfigureNowCheck" Margin="13,12,0,0"
                                  Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.ConfigureNow], Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Actions ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorText" Grid.Column="0" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" IsCancel="True"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Cancel], Mode=OneWay}"
                            Click="OnCancelClick"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Setup.Save], Mode=OneWay}"
                            Click="OnSaveClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
