<Window x:Class="CameywareOrder.Views.ProductCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.Title], Mode=OneWay}"
        Height="620" Width="720"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBackgroundBrush}">
    <!-- The ready-made categories this shop offers in an order's clothing rows. Per shop, seeded
         from the shipped defaults — see ProductCatalogService. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="26,20">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.Title], Mode=OneWay}"
                           FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.Subtitle], Mode=OneWay}"
                           FontSize="13" Foreground="{StaticResource TextOnHeaderSubtleBrush}"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- A predefined category's name comes from the string table, so
                                         it is translated for every language the app ships and is not
                                         the shop's to rename. The badge says why Rename is disabled. -->
                                    <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                            Visibility="{Binding PresetVisibility}">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MeasureTerms.Preset], Mode=OneWay}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               FontSize="14" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyText" Margin="20" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.Empty], Mode=OneWay}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" MinWidth="150">
                <Button x:Name="AddButton" Style="{StaticResource ThemedButton}" Margin="0,0,0,8" Click="OnAddClick"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.Add], Mode=OneWay}"/>
                <Button x:Name="RenameButton" Style="{StaticResource ThemedButton}" Margin="0,0,0,8" Click="OnRenameClick"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.Rename], Mode=OneWay}"/>
                <Button x:Name="RemoveButton" Style="{StaticResource DangerButton}" Margin="0,0,0,18" Click="OnRemoveClick"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.Remove], Mode=OneWay}"/>

                <Button x:Name="MoveUpButton" Style="{StaticResource ThemedButton}" Margin="0,0,0,8" Click="OnMoveUpClick"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.MoveUp], Mode=OneWay}"/>
                <Button x:Name="MoveDownButton" Style="{StaticResource ThemedButton}" Margin="0,0,0,18" Click="OnMoveDownClick"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.MoveDown], Mode=OneWay}"/>

                <Button x:Name="RestoreButton" Style="{StaticResource ThemedButton}" Click="OnRestoreClick"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProductCatalog.RestoreDefault], Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14" Margin="0,18,0,0">
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True"
                    MinWidth="110" Padding="18,8" Click="OnCloseClick"
                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MeasureTerms.Done], Mode=OneWay}"/>
        </Border>
    </Grid>
</Window>
