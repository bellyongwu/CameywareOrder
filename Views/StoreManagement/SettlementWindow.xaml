<Window x:Class="CameywareOrder.Views.SettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:ctrl="clr-namespace:CameywareOrder.Controls"
        xmlns:charts="clr-namespace:CameywareOrder.Controls.Charts"
        Height="900" Width="1280"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6FA">
    <Window.Resources>
        <!-- The report's own language, so a shop can read August in French without moving the whole
             application into French — and so the PDF can be produced in it. See LocalizationScope. -->
        <loc:LocalizationScope x:Key="Scope"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#4F46E5" BlurRadius="16" ShadowDepth="0" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- One KPI: a caption over a number. The number is the thing being read, so it carries the
             weight and the caption stays quiet above it. -->
        <DataTemplate x:Key="MetricTemplate">
            <!-- Equal margins in both directions, and that is the whole point. These sit in a
                 WrapPanel: a right margin alone spaces the cards across while letting the ROWS touch
                 as soon as they wrap, which is exactly what the Orders and Payments cards do at six
                 items. The gap has to read the same horizontally and vertically or the block stops
                 looking like a grid. -->
            <Border Background="{Binding Background}" CornerRadius="10" Padding="14,12" Margin="0,0,12,12" MinWidth="150">
                <StackPanel>
                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One row of the per-service table. Fixed widths rather than a Grid with shared sizes: the
             header above it uses the same numbers, and there are five columns, not fifty. -->
        <DataTemplate x:Key="LineRowTemplate">
            <Border BorderBrush="#F1F3F7" BorderThickness="0,0,0,1" Padding="0,9">
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding Name}" Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Orders}" Width="80" VerticalAlignment="Center" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding PreTax}" Width="120" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Tax}" Width="110" VerticalAlignment="Center" TextAlignment="Right" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding PostTax}" Width="130" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Received}" Width="120" VerticalAlignment="Center" TextAlignment="Right" Foreground="#15803D"/>
                    <TextBlock Text="{Binding Outstanding}" Width="120" VerticalAlignment="Center" TextAlignment="Right" Foreground="#B45309"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Period chip. Same shape as the gender filter in Measurement Terms, deliberately: the two
             are the same gesture and should not look like two different controls. -->
        <Style x:Key="PeriodChip" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradientBrush}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#DDD6FE" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ctrl:LanguageScopeSelector x:Name="PreviewLanguageSelector" Scope="{StaticResource Scope}"
                                                VerticalAlignment="Center" Margin="0,0,14,0"
                                                Foreground="#DDD6FE"/>
                    <Button x:Name="PrintButton" Padding="16,8" Click="OnPrintClick" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Period filter -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="22,12">
            <!-- A DockPanel so the date range can take the room the fixed controls leave. In a
                 horizontal StackPanel every child is measured against infinite width, so a star
                 column inside one never grows and a "stretch" date box stays at its minimum. -->
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <RadioButton x:Name="DayChip" DockPanel.Dock="Left" Style="{StaticResource PeriodChip}" GroupName="Period" Checked="OnPeriodKindChanged"/>
                <RadioButton x:Name="MonthChip" DockPanel.Dock="Left" Style="{StaticResource PeriodChip}" GroupName="Period" Checked="OnPeriodKindChanged"/>
                <RadioButton x:Name="YearChip" DockPanel.Dock="Left" Style="{StaticResource PeriodChip}" GroupName="Period" Checked="OnPeriodKindChanged"/>
                <RadioButton x:Name="CustomChip" DockPanel.Dock="Left" Style="{StaticResource PeriodChip}" GroupName="Period" Checked="OnPeriodKindChanged"/>

                <Border DockPanel.Dock="Left" Width="1" Background="#E5E7EB" Margin="10,2" VerticalAlignment="Stretch"/>

                <Button x:Name="PreviousButton" DockPanel.Dock="Left" Padding="10,6" Margin="0,0,6,0" Click="OnPreviousClick" Cursor="Hand"/>
                <Button x:Name="NextButton" DockPanel.Dock="Left" Padding="10,6" Margin="0,0,12,0" Click="OnNextClick" Cursor="Hand"/>

                <!-- The period is a BUTTON, not a caption. Previous / Next walk one step at a time,
                     which is fine for last month and useless for last March — reaching it took a
                     dozen clicks and there was no other way to get there. Clicking the period opens
                     a calendar in the mode that matches the chip: a day grid for Day, the twelve
                     months for Month, a decade for Year. -->
                <Button x:Name="PeriodButton" DockPanel.Dock="Right" Click="OnPeriodPickerClick"
                        Padding="12,6" Margin="12,0,0,0" Cursor="Hand" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PeriodText" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="#111827"/>
                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#6B7280" Width="8" Height="4"
                              Stretch="Fill" VerticalAlignment="Center" Margin="9,2,0,0"/>
                    </StackPanel>
                </Button>

                <Popup x:Name="PeriodPopup" PlacementTarget="{Binding ElementName=PeriodButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade" HorizontalOffset="-40">
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="10" Padding="6" Margin="0,6,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Color="#111827"/>
                        </Border.Effect>
                        <!-- One Calendar for all three kinds. DisplayMode is set from the chip, and
                             the two coarse modes are read from DisplayModeChanged rather than from a
                             selection: a Calendar in Year or Decade mode DRILLS DOWN when a cell is
                             clicked instead of selecting, so the drill-down IS the choice. -->
                        <Calendar x:Name="PeriodCalendar"
                                  SelectedDatesChanged="OnPeriodCalendarSelected"
                                  DisplayModeChanged="OnPeriodCalendarDisplayModeChanged"/>
                    </Border>
                </Popup>

                <!-- Last child, so it fills what the chips and buttons leave: the two date boxes take
                     half the remaining width each and grow with the window, rather than sitting at a
                     fixed 150 with a drop-down almost three times wider hanging off them. -->
                <Grid x:Name="CustomRangePanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FromLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6B7280"/>
                    <DatePicker x:Name="FromPicker" Grid.Column="1" Margin="0,0,12,0" SelectedDateChanged="OnCustomRangeChanged"/>
                    <TextBlock x:Name="ToLabel" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6B7280"/>
                    <DatePicker x:Name="ToPicker" Grid.Column="3" SelectedDateChanged="OnCustomRangeChanged"/>
                </Grid>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel x:Name="ReportRoot">
                <!-- Headline figures -->
                <ItemsControl x:Name="MetricList" ItemTemplate="{StaticResource MetricTemplate}" Margin="0,0,-12,-12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Charts -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="ServiceChartTitle" Style="{StaticResource CardTitle}"/>
                            <charts:PieChart x:Name="ServicePie" Height="220"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="MethodChartTitle" Style="{StaticResource CardTitle}"/>
                            <charts:BarChart x:Name="MethodBars" Height="220"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Per-service table -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ServicesTitle" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="19"/>
                            <TextBlock x:Name="HeadName" Style="{StaticResource ColumnHead}" Width="150"/>
                            <TextBlock x:Name="HeadOrders" Style="{StaticResource ColumnHead}" Width="80"/>
                            <TextBlock x:Name="HeadPreTax" Style="{StaticResource ColumnHead}" Width="120" TextAlignment="Right"/>
                            <TextBlock x:Name="HeadTax" Style="{StaticResource ColumnHead}" Width="110" TextAlignment="Right"/>
                            <TextBlock x:Name="HeadPostTax" Style="{StaticResource ColumnHead}" Width="130" TextAlignment="Right"/>
                            <TextBlock x:Name="HeadReceived" Style="{StaticResource ColumnHead}" Width="120" TextAlignment="Right"/>
                            <TextBlock x:Name="HeadOutstanding" Style="{StaticResource ColumnHead}" Width="120" TextAlignment="Right"/>
                        </StackPanel>
                        <ItemsControl x:Name="LineList" ItemTemplate="{StaticResource LineRowTemplate}"/>
                        <Border BorderBrush="#111827" BorderThickness="0,2,0,0" Margin="0,6,0,0" Padding="0,9,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="19"/>
                                <TextBlock x:Name="TotalName" Width="150" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TotalOrders" Width="80" VerticalAlignment="Center" Foreground="#6B7280"/>
                                <TextBlock x:Name="TotalPreTax" Width="120" TextAlignment="Right" FontWeight="Bold"/>
                                <TextBlock x:Name="TotalTax" Width="110" TextAlignment="Right" FontWeight="Bold" Foreground="#6B7280"/>
                                <TextBlock x:Name="TotalPostTax" Width="130" TextAlignment="Right" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="TotalReceived" Width="120" TextAlignment="Right" FontWeight="Bold" Foreground="#15803D"/>
                                <TextBlock x:Name="TotalOutstanding" Width="120" TextAlignment="Right" FontWeight="Bold" Foreground="#B45309"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Orders and payments -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="OrdersTitle" Style="{StaticResource CardTitle}"/>
                            <ItemsControl x:Name="CountList" ItemTemplate="{StaticResource MetricTemplate}" Margin="0,0,-12,-12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="PaymentsTitle" Style="{StaticResource CardTitle}"/>
                            <ItemsControl x:Name="PaymentList" ItemTemplate="{StaticResource MetricTemplate}" Margin="0,0,-12,-12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="EmptyText" Foreground="#9CA3AF" TextAlignment="Center" Margin="0,40"
                           FontSize="14" Visibility="Collapsed"/>
                <TextBlock x:Name="GeneratedText" Foreground="#C6CBD4" FontSize="11" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
