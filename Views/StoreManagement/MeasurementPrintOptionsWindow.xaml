<Window x:Class="CameywareOrder.Views.MeasurementPrintOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MeasurePrint.Title], Mode=OneWay}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F6F9">
    <Border Padding="24" MinWidth="360">
        <StackPanel>
            <!-- Prompt and options are hidden together when the shop runs in a single language:
                 asking which of one language to print in is not a question. Both are named so the
                 code-behind can collapse the pair. -->
            <TextBlock x:Name="LanguagePromptText"
                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MeasurePrint.LanguagePrompt], Mode=OneWay}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
            <StackPanel x:Name="LanguageOptionsPanel" Margin="4,0,0,16"/>

            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MeasurePrint.UnitPrompt], Mode=OneWay}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                <RadioButton x:Name="CmRadio" GroupName="MeasurePrintUnit" IsChecked="True" Margin="0,0,24,0"
                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Measure.Unit.Cm], Mode=OneWay}"/>
                <RadioButton x:Name="InchRadio" GroupName="MeasurePrintUnit"
                             Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Measure.Unit.Inch], Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MeasurePrint.Cancel], Mode=OneWay}"
                        Padding="18,7" Margin="0,0,10,0" Click="OnCancelClick" IsCancel="True"/>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[MeasurePrint.Print], Mode=OneWay}"
                        Padding="22,7" Background="#4F46E5" Foreground="White" FontWeight="SemiBold"
                        Click="OnPrintClick" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
