<Window x:Class="CameywareOrder.Views.RecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.Title], Mode=OneWay}"
        Height="720" Width="1000"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="{StaticResource PageBackgroundBrush}">
    <!-- Deleted orders, and the two things that can be done with one: put it back, or finish the job.
         Every colour and every style comes from Themes/AppTheme.xaml — the gradient header, the card
         borders, DangerButton — so this reads as the same application as Store Management, which it
         is deliberately shaped after.

         The list is Extended, like every other multi-record list here, and both actions read the
         whole selection. Only the destructive one goes through ConfirmDestructiveWindow. -->
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="BinCardContainer" TargetType="ListBoxItem" BasedOn="{StaticResource RosterCardContainer}">
                <Setter Property="Margin" Value="0,0,0,9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" CornerRadius="10" Background="White"
                                    BorderBrush="#E5E7EB" BorderThickness="1"
                                    Padding="16,13" SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#A5B4FC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#4F46E5"/>
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Card" Property="Background" Value="#EEF2FF"/>
                                    <Setter TargetName="Card" Property="Padding" Value="15,12"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#6B7280"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.Title], Mode=OneWay}"
                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                <!-- Set in code: it interleaves the retention window, which is a number the
                     installation chose, into a translated sentence. -->
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#DDD6FE"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="SelectionSummary" FontSize="12" Foreground="#374151"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SelectAllButton" Padding="12,5" Margin="0,0,8,0" FontSize="12"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Store.Manage.SelectAll], Mode=OneWay}"
                                Click="OnSelectAllClick"/>
                        <Button x:Name="ClearSelectionButton" Padding="12,5" FontSize="12"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Store.Manage.ClearSelection], Mode=OneWay}"
                                Click="OnClearSelectionClick"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E5E7EB"
                        BorderThickness="1" Padding="14">
                    <Grid>
                        <ListBox x:Name="BinList" SelectionMode="Extended"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource BinCardContainer}"
                                 SelectionChanged="OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <!-- One line each, ellipsized: the bin is read by scanning
                                                 down it, the same rule the orders list follows. -->
                                            <TextBlock Text="{Binding Headline}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#6B7280"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Amber while it can still be recovered; red once the next
                                             purge will take it. The colour says how long is left,
                                             which is the only question this list has to answer. -->
                                        <Border Grid.Column="1" CornerRadius="11" Padding="11,4"
                                                Background="{Binding RemainingBackground}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RemainingText}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{Binding RemainingForeground}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.Empty], Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" MaxWidth="340"
                                   TextAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1"
                            Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ActionCaption}"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.RestoreSection], Mode=OneWay}"/>
                            <Button x:Name="RestoreButton" Padding="12,8" IsEnabled="False"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.Restore], Mode=OneWay}"
                                    Click="OnRestoreClick"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.RestoreHint], Mode=OneWay}"
                                       FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF2F2" CornerRadius="10" BorderBrush="#FECACA" BorderThickness="1"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ActionCaption}" Foreground="#B91C1C"
                                       Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Store.Manage.DangerSection], Mode=OneWay}"/>
                            <Button x:Name="DeleteForeverButton" Style="{StaticResource DangerButton}"
                                    Margin="0,0,0,8" Padding="12,8" IsEnabled="False"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.DeleteForever], Mode=OneWay}"
                                    Click="OnDeleteForeverClick"/>
                            <Button x:Name="EmptyBinButton" Style="{StaticResource DangerButton}" Padding="12,8"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.EmptyBin], Mode=OneWay}"
                                    Click="OnEmptyBinClick"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[RecycleBin.DangerHint], Mode=OneWay}"
                                       FontSize="11" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" MaxWidth="620"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" Padding="16,7" IsCancel="True"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Store.Manage.Close], Mode=OneWay}"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
