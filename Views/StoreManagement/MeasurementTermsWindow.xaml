<Window x:Class="CameywareOrder.Views.MeasurementTermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        xmlns:ctrl="clr-namespace:CameywareOrder.Controls"
        Height="760" Width="1120"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F9FAFB">
    <Window.Resources>
        <!-- This panel's OWN language, independent of the application's. Everything below binds to it
             instead of to LocalizationService.Instance, which is the whole of what makes the preview
             picker in the header work — see LocalizationScope.

             Declared FIRST because the templates further down resolve it by StaticResource. The
             window's Title cannot be bound to it at all (a Window's own properties are set before its
             Resources exist, so the lookup would fail); the code-behind sets the Title instead. -->
        <loc:LocalizationScope x:Key="Scope"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Column container card -->
        <Style x:Key="ColumnCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#4F46E5" BlurRadius="14" ShadowDepth="0" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Transparent glyph icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Add button (accent, pill) -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#EAF2FB"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8E8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-shaped filter chip (gender filter radio buttons) -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#F9FAFB" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3E9EE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Garment list row -->
        <Style x:Key="GarmentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#F9FAFB" CornerRadius="8" BorderThickness="1" BorderBrush="#E7ECF1" Padding="10,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDF3F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Draggable measurement chip (right column) -->
        <DataTemplate x:Key="TermRowTemplate">
            <Border x:Name="Chip" Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                    Padding="10,7" Margin="0,0,0,6" Cursor="SizeAll"
                    PreviewMouseLeftButtonDown="OnTermPreviewMouseDown"
                    PreviewMouseMove="OnTermPreviewMouseMove">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFontFamily}" Text="&#xE700;" FontSize="13"
                               Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Gender badge -->
                        <TextBlock FontSize="13" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{Binding GenderGlyph}"
                                   Visibility="{Binding ShowGenderGlyph, Converter={StaticResource BoolToVis}}"
                                   ToolTip="{Binding GenderTooltip}"/>
                        <!-- Preset lock -->
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE72E;" FontSize="13" Foreground="#D1D5DB"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPredefined, Converter={StaticResource BoolToVis}}"
                                   ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Preset], Mode=OneWay}"/>
                        <!-- Custom actions -->
                        <Button Style="{StaticResource IconButton}" Click="OnTermEditClick" Tag="{Binding}"
                                Visibility="{Binding ShowEditButton, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Edit], Mode=OneWay}">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE70F;" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnTermSaveClick" Tag="{Binding}"
                                Foreground="#4F46E5"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Save], Mode=OneWay}">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE73E;" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnTermAltLanguageClick" Tag="{Binding}"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.ViewAltLanguage], Mode=OneWay}">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xF2B7;" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnTermDeleteClick" Tag="{Binding}"
                                Foreground="#B91C1C"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Delete], Mode=OneWay}">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE74D;" FontSize="13"/>
                        </Button>
                    </StackPanel>

                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#4F46E5" VerticalAlignment="Center"
                                   Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" BorderBrush="#4F46E5" BorderThickness="1"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Assigned measurement chip (center column) -->
        <DataTemplate x:Key="AssignedRowTemplate">
            <Border Background="#EAF3FB" CornerRadius="8" BorderBrush="#CBE1F5" BorderThickness="1"
                    Padding="10,7" Margin="0,0,0,6">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFontFamily}" Text="&#xF0E2;" FontSize="13"
                               Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFontFamily}" Text="&#xE72E;" FontSize="12"
                               Foreground="#9FB4C6" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                               ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Preset], Mode=OneWay}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Foreground="#B91C1C"
                            Click="OnAssignedRemoveClick" Tag="{Binding}"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Remove], Mode=OneWay}">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE711;" FontSize="13"/>
                    </Button>
                    <TextBlock Text="{Binding Name}" Foreground="#1F5F8B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE9D9;" FontSize="22" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Title], Mode=OneWay}"
                               FontSize="22" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Subtitle], Mode=OneWay}"
                           Foreground="#9CA3AF" Margin="36,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Reads the terms and garments in another language without moving the application into
                 it. Top-right and outside the three columns: it describes the whole panel, and every
                 column re-renders when it moves. -->
            <ctrl:LanguageScopeSelector Grid.Column="1" x:Name="PreviewLanguageSelector"
                                        Scope="{StaticResource Scope}" VerticalAlignment="Top"
                                        Margin="16,2,0,0"/>
        </Grid>

        <!-- Three columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Left: garments -->
            <Border Grid.Column="0" Style="{StaticResource ColumnCard}" Margin="0,0,9,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE7F6;" FontSize="15" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource ColumnTitle}" Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Garments], Mode=OneWay}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="GarmentList" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource GarmentItemStyle}"
                                 SelectionChanged="OnGarmentSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFontFamily}" Text="&#xEA8C;" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE72E;" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
                                                       Visibility="{Binding IsPredefined, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource IconButton}" Click="OnGarmentAltLanguageClick" Tag="{Binding}"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.ViewAltLanguage], Mode=OneWay}">
                                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xF2B7;" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Click="OnGarmentDeleteClick" Tag="{Binding}"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Delete], Mode=OneWay}">
                                                <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE74D;" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <Button Grid.Row="2" Style="{StaticResource AddButton}" Margin="0,12,0,0" Click="OnAddGarmentClick" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE710;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.AddGarment], Mode=OneWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Center: assigned measurements (drop target) -->
            <Border Grid.Column="1" x:Name="AssignedDropZone" Style="{StaticResource ColumnCard}" Margin="9,0,9,0"
                    AllowDrop="True" DragOver="OnAssignedDragOver" Drop="OnAssignedDrop">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE9D2;" FontSize="15" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource ColumnTitle}" Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Assigned], Mode=OneWay}"/>
                        <TextBlock x:Name="AssignedGarmentText" Style="{StaticResource ColumnTitle}" Foreground="#4F46E5" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Default-vs-customized mode switch: only shown for predefined garments, since
                         user-added garments are already fully editable with no locked default set. -->
                    <Border Grid.Row="1" x:Name="MeasurementModePanel" Background="#F9FAFB" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MeasurementModeStatusText" Foreground="#6B7280" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" x:Name="MeasurementModeActionButton" Style="{StaticResource AddButton}" Click="OnMeasurementModeActionClick"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AssignedList" ItemTemplate="{StaticResource AssignedRowTemplate}"/>
                        </ScrollViewer>
                        <StackPanel x:Name="AssignedHintPanel" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE896;" FontSize="22" Foreground="#C6D2DE" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="AssignedHintText" Foreground="#D1D5DB" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: all measurements -->
            <Border Grid.Column="2" Style="{StaticResource ColumnCard}" Margin="9,0,0,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE71D;" FontSize="15" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource ColumnTitle}" Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.AllProps], Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Gender filter: Common terms always show; Male/Female narrows to that gender's specific terms too -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="GenderFilterAllRadio" Style="{StaticResource FilterChip}" GroupName="TermGenderFilter" Checked="OnTermGenderFilterChanged"
                                     Content="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.FilterAll], Mode=OneWay}"/>
                        <RadioButton x:Name="GenderFilterMaleRadio" Style="{StaticResource FilterChip}" GroupName="TermGenderFilter" Checked="OnTermGenderFilterChanged"
                                     Content="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.FilterMale], Mode=OneWay}"/>
                        <RadioButton x:Name="GenderFilterFemaleRadio" Style="{StaticResource FilterChip}" GroupName="TermGenderFilter" Checked="OnTermGenderFilterChanged"
                                     Content="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.FilterFemale], Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Search box -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="AllTermsSearchBox" Padding="8,6" BorderBrush="#CBD3DA" BorderThickness="1" TextChanged="OnTermSearchTextChanged"/>
                        <TextBlock x:Name="AllTermsSearchHint" IsHitTestVisible="False" Foreground="#D1D5DB" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.SearchPlaceholder], Mode=OneWay}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AllTermsList" ItemTemplate="{StaticResource TermRowTemplate}"/>
                    </ScrollViewer>
                    <Button Grid.Row="4" Style="{StaticResource AddButton}" Margin="0,12,0,0" Click="OnAddPropClick" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE710;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.AddProp], Mode=OneWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Source={StaticResource Scope}, Path=[MeasureTerms.Done], Mode=OneWay}"
                    Width="110" Height="34" IsDefault="True" IsCancel="True" Click="OnDoneClick"
                    Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
