<Window x:Class="CameywareOrder.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.UserManagement], Mode=OneWay}"
        Height="720" Width="1020"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/ICONS/app-icon.ico"
        Background="#F4F5F9">
    <!-- Administrator-only. Reached from the shop picker (选择店铺) and from 本地配置 → 用户管理.
         Accounts live in credentials.json, outside the database, but the SHOPS they are assigned to
         are read from it — hence the scope factory. -->
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,8"/>
        </Style>

        <!-- Deleting an account is the one irreversible action here, so it is the one control that
             does not look like the others. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Account rows are cards, so the whole row is the hit target and the selected one reads
             as an accent rather than the system highlight colour. -->
        <Style x:Key="UserCardContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" CornerRadius="8" Background="White"
                                BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="11,9" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Card" Property="Padding" Value="10,8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header band ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.UserManagement], Mode=OneWay}"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Subtitle], Mode=OneWay}"
                           Foreground="#DDD6FE" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Body: account list | detail ─────────────────────────────── -->
        <Grid Grid.Row="1" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource CardHeading}"
                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Accounts], Mode=OneWay}"/>

                    <!-- Watermark: WPF has no placeholder, so the caption sits behind the box and
                         hides as soon as anything is typed. -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}"
                                 TextChanged="OnSearchTextChanged"
                                 ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Search], Mode=OneWay}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Search], Mode=OneWay}"
                                   IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="#9CA3AF" FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="UserList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource UserCardContainer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnUserSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserName}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#6B7280"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3" Background="#E0E7FF"
                                            VerticalAlignment="Center" Visibility="{Binding AdminBadgeVisibility}">
                                        <TextBlock Text="{Binding AdminBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#3730A3"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" x:Name="AddUserButton" Style="{StaticResource RoundedButton}"
                            Margin="0,12,0,0" HorizontalAlignment="Stretch"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Add], Mode=OneWay}"
                            Click="OnAddUserClick"/>
                </Grid>
            </Border>

            <!-- Detail: exactly one of these three panels is visible at a time. -->
            <Grid Grid.Column="1" Margin="18,0,0,0">
                <!-- Nothing selected -->
                <TextBlock x:Name="EmptySelectionText"
                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.SelectPrompt], Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" MaxWidth="320"
                           TextAlignment="Center"/>

                <!-- Create -->
                <Border x:Name="CreatePanel" Style="{StaticResource CardBorder}" VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeading}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NewUser], Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.UserName], Mode=OneWay}"/>
                        <TextBox x:Name="NewUserNameBox" Style="{StaticResource InputBox}" MaxWidth="360"
                                 HorizontalAlignment="Left" Width="360" Margin="0,0,0,14"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Password], Mode=OneWay}"/>
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource InputBox}"
                                     HorizontalAlignment="Left" Width="360" Margin="0,0,0,14"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ConfirmPassword], Mode=OneWay}"/>
                        <PasswordBox x:Name="NewPasswordConfirmBox" Style="{StaticResource InputBox}"
                                     HorizontalAlignment="Left" Width="360" Margin="0,0,0,6"/>

                        <TextBlock x:Name="CreateErrorText" Foreground="#B91C1C" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Create], Mode=OneWay}"
                                    Click="OnCreateConfirmClick"/>
                            <Button Style="{StaticResource RoundedButton}"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Cancel], Mode=OneWay}"
                                    Click="OnCreateCancelClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Edit -->
                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Identity -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="46" CornerRadius="23"
                                        Background="{Binding ElementName=UserList, Path=SelectedItem.AvatarBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ElementName=UserList, Path=SelectedItem.Initial}"
                                               Foreground="White" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailUserNameText" FontSize="18" FontWeight="Bold"
                                               Foreground="#111827"/>
                                    <TextBlock x:Name="DetailSummaryText" FontSize="12" Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Shown instead of the assignment matrix for the locked administrator. -->
                        <Border x:Name="AdminNoticePanel" CornerRadius="10" Background="#EEF2FF"
                                BorderBrush="#C7D2FE" BorderThickness="1" Padding="16,14"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.AdminNotice], Mode=OneWay}"
                                       Foreground="#3730A3" FontSize="12.5" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Password -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeading}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Login.Password], Mode=OneWay}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NewPassword], Mode=OneWay}"/>
                                        <PasswordBox x:Name="ResetPasswordBox" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ConfirmPassword], Mode=OneWay}"/>
                                        <PasswordBox x:Name="ResetPasswordConfirmBox" Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.PasswordHint], Mode=OneWay}"
                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Shop × role matrix -->
                        <Border x:Name="AssignmentsPanel" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeading}"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Assignments], Mode=OneWay}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.AssignmentsHint], Mode=OneWay}"
                                           FontSize="11.5" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- Column captions. Widths are repeated on the rows below; keep the
                                     two in step or the ticks stop lining up under their labels. -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="2,0,0,0"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.ShopColumn], Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Role.Manager], Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"
                                               Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Shop.Role.Staff], Mode=OneWay}"/>
                                </Grid>

                                <ItemsControl x:Name="AssignmentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="104"/>
                                                        <ColumnDefinition Width="104"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,10,0">
                                                        <TextBlock Text="{Binding ShopName}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="#111827"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ShopDetails}" FontSize="11"
                                                                   Foreground="#9CA3AF" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsManager, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsStaff, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoShopsText"
                                           Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.NoShops], Mode=OneWay}"
                                           FontSize="12.5" Foreground="#9CA3AF" Visibility="Collapsed"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="24,13" Margin="0,18,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="DeleteUserButton" Style="{StaticResource DangerButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Delete], Mode=OneWay}"
                            Click="OnDeleteUserClick"/>
                    <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="#047857" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Save], Mode=OneWay}"
                            Click="OnSaveClick"/>
                    <Button Style="{StaticResource RoundedButton}"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Users.Close], Mode=OneWay}"
                            Click="OnCloseClick" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
