<Window x:Class="CameywareOrder.Views.ReceiptBrandingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Title], Mode=OneWay}"
        Height="880" Width="1080"
        MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F6F9">
    <Window.Resources>
        <!-- Formatting ribbon toggle/command buttons -->
        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4DAE1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF1F8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B8C2CC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#42505E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C3CCD6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Title], Mode=OneWay}"
                       FontSize="18" FontWeight="Bold" Foreground="#25313C"/>
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Description], Mode=OneWay}"
                       FontSize="13" Foreground="#7A8794" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Logo -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#E2E7EC" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Border Width="120" Height="72" CornerRadius="6" Background="#F1F4F7" BorderBrush="#DCE1E7" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="NoLogoText" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.NoLogo], Mode=OneWay}"
                                   Foreground="#9AA6B2" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                        <Image x:Name="LogoPreview" Stretch="Uniform" Margin="6" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Logo], Mode=OneWay}"
                               FontWeight="SemiBold" Foreground="#33414D" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,6"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.ChooseLogo], Mode=OneWay}"
                                Click="OnChooseLogoClick"/>
                        <Button x:Name="RemoveLogoButton" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                                Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.RemoveLogo], Mode=OneWay}"
                                Click="OnRemoveLogoClick"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.LogoPlacement], Mode=OneWay}"
                                   VerticalAlignment="Center" Foreground="#5A6773" Margin="0,0,10,0"/>
                        <RadioButton x:Name="PlacementLeftRadio" GroupName="LogoPlacement" VerticalContentAlignment="Center" Margin="0,0,12,0"
                                     Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.PlacementLeft], Mode=OneWay}"/>
                        <RadioButton x:Name="PlacementCenterRadio" GroupName="LogoPlacement" VerticalContentAlignment="Center" Margin="0,0,12,0"
                                     Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.PlacementCenter], Mode=OneWay}"/>
                        <RadioButton x:Name="PlacementRightRadio" GroupName="LogoPlacement" VerticalContentAlignment="Center"
                                     Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.PlacementRight], Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Formatting ribbon -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,0,14" BorderBrush="#E2E7EC" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource RibbonButtonStyle}" Click="OnBoldClick" ToolTip="Bold">
                    <TextBlock Text="B" FontWeight="Bold"/>
                </Button>
                <Button Style="{StaticResource RibbonButtonStyle}" Click="OnItalicClick" ToolTip="Italic">
                    <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/>
                </Button>
                <Button Style="{StaticResource RibbonButtonStyle}" Click="OnUnderlineClick" ToolTip="Underline">
                    <TextBlock Text="U" TextDecorations="Underline"/>
                </Button>

                <Border Width="1" Background="#E2E7EC" Margin="8,2"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.FontSize], Mode=OneWay}"
                           VerticalAlignment="Center" Foreground="#5A6773" Margin="2,0,6,0"/>
                <ComboBox x:Name="FontSizeBox" Width="66" Height="30" IsEditable="True"
                          VerticalContentAlignment="Center" SelectionChanged="OnFontSizeChanged"/>

                <Border Width="1" Background="#E2E7EC" Margin="8,2"/>

                <Button Style="{StaticResource RibbonButtonStyle}" Click="OnAlignLeftClick" ToolTip="Align left">
                    <TextBlock Text="&#x2261;" FontSize="18"/>
                </Button>
                <Button Style="{StaticResource RibbonButtonStyle}" Click="OnAlignCenterClick" ToolTip="Align center">
                    <TextBlock Text="&#x2263;" FontSize="18"/>
                </Button>
                <Button Style="{StaticResource RibbonButtonStyle}" Click="OnAlignRightClick" ToolTip="Align right">
                    <TextBlock Text="&#x2261;" FontSize="18" FlowDirection="RightToLeft"/>
                </Button>

                <Border Width="1" Background="#E2E7EC" Margin="8,2"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Color], Mode=OneWay}"
                           VerticalAlignment="Center" Foreground="#5A6773" Margin="2,0,6,0"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#000000" Tag="#000000" Click="OnColorSwatchClick"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#9CA3AF" Tag="#9CA3AF" Click="OnColorSwatchClick"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#B91C1C" Tag="#B91C1C" Click="OnColorSwatchClick"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#4F46E5" Tag="#4F46E5" Click="OnColorSwatchClick"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#047857" Tag="#047857" Click="OnColorSwatchClick"/>
                <Button Style="{StaticResource ColorSwatchStyle}" Background="#D4AC0D" Tag="#D4AC0D" Click="OnColorSwatchClick"/>
            </StackPanel>
        </Border>

        <!-- Per-language header / footer editors (tabs generated in code-behind) -->
        <TabControl x:Name="LanguageTabs" Grid.Row="3" Background="Transparent" BorderThickness="0"/>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#047857" Margin="0,0,16,0"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Cancel], Mode=OneWay}"
                    Click="OnCancelClick"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Save], Mode=OneWay}"
                    Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
