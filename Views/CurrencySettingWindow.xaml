<Window x:Class="LeeYongeOrdering.Views.CurrencySettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LeeYongeOrdering.Localization"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Currency.Title], Mode=OneWay}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F6F9">
    <Border Padding="24" MinWidth="360">
        <StackPanel>
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Currency.Prompt], Mode=OneWay}"
                       FontSize="13" Foreground="#333" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <ComboBox x:Name="CurrencyBox" Padding="8,6" FontSize="14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Cancel], Mode=OneWay}"
                        Padding="18,7" Margin="0,0,10,0" Click="OnCancelClick" IsCancel="True"/>
                <Button x:Name="SaveButton"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Branding.Save], Mode=OneWay}"
                        Padding="22,7" Background="#2980B9" Foreground="White" FontWeight="SemiBold"
                        Click="OnSaveClick" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
