<Window x:Class="CameywareOrder.Views.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameywareOrder.Localization"
        Height="1040" Width="1100"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileNameText" Grid.Row="0" Foreground="White" FontSize="14"
                   Margin="16,12" TextTrimming="CharacterEllipsis"/>

        <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,16,14">
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Cancel], Mode=OneWay}"
                    Width="90" Height="30" IsCancel="True" IsDefault="True" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
