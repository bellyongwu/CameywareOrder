<Window x:Class="LeeYongeOrdering.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:LeeYongeOrdering.Converters"
        xmlns:loc="clr-namespace:LeeYongeOrdering.Localization"
        xmlns:local="clr-namespace:LeeYongeOrdering"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.MainTitle], Mode=OneWay}"
        Height="1440" Width="2560"
        MinHeight="720" MinWidth="1180"
        Icon="/Assets/ICONS/app-icon.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:OrderStatusToLocalizedTextConverter x:Key="OrderStatusToLocalizedTextConverter"/>
        <conv:LocalizationLookupConverter x:Key="LocalizationLookupConverter"/>
        <conv:CustomMadeRecordSummaryConverter x:Key="CustomMadeRecordSummaryConverter"/>
        <conv:CurrencyAmountConverter x:Key="CurrencyAmountConverter"/>
        <conv:OrderPaymentSummaryConverter x:Key="OrderPaymentSummaryConverter"/>
        <conv:LastItemBorderThicknessConverter x:Key="LastItemBorderThickness"/>
        <conv:OrderServicesSummaryConverter x:Key="OrderServicesSummaryConverter"/>
        <conv:PositiveAmountToVisibilityConverter x:Key="PositiveAmountToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Right-click context menu styling -->
        <Style x:Key="OrderContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DCE1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
        <Style x:Key="OrderMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Card container used to lift the detail sections off the flat background -->
        <Style x:Key="DetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Column header styling for the orders ListView/GridView -->
        <Style x:Key="OrderListHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#22303C"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#9FD0FF"
                                       Text="{Binding Column.(local:OrderColumnSort.SortGlyph), RelativeSource={RelativeSource AncestorType=GridViewColumnHeader}}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Orders row: taller rows, hover, animated selection highlight, gray-out completed -->
        <Style x:Key="OrderListItemStyle" TargetType="ListViewItem">
            <Setter Property="FontSize" Value="{Binding Value, ElementName=RecordFontSizeSlider}"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnOrderRowRightClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#ECEFF2" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Selection/focus color that fades in and out (Requirement D) -->
                                <Border x:Name="Highlight" Background="#D6E9F8" Opacity="0" SnapsToDevicePixels="True"/>
                                <Border x:Name="Accent" Width="4" HorizontalAlignment="Left" Background="#2980B9" Opacity="0"/>
                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                      Columns="{TemplateBinding GridView.ColumnCollection}"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F7FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.30"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30"/>
                                            <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Gray out completed records; shipped counts as completed/picked up (Accessibility B) -->
                            <DataTrigger Binding="{Binding IsPickedUp}" Value="True">
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#9AA3AB"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="16,10">
            <Grid>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Main.HeaderTitle], Mode=OneWay}" Foreground="White"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Main.HeaderSubtitle], Mode=OneWay}" Foreground="#7F8C8D"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Status bar ──────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Background="#ECF0F1">
            <StatusBarItem>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[StatusBar.Label], Mode=OneWay}" Margin="4,0,8,0" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Margin="4,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DataPath.Label], Mode=OneWay}" Margin="4,0,4,0" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding DatabaseFilePath}" Margin="0,0,4,0" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Toolbar ─────────────────────────────────────────────────── -->
        <ToolBar DockPanel.Dock="Top" Background="#F5F6FA">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.NewOrder], Mode=OneWay}" Click="OnAddOrderClick"   Padding="10,4" Margin="2"/>
                <Button x:Name="EditOrderButton" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.EditOrder], Mode=OneWay}" Click="OnEditOrderClick"  Padding="10,4" Margin="2"
                    IsEnabled="{Binding SelectedOrder, Converter={StaticResource NullToVisibility},
                                        ConverterParameter=NotNull}"/>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.DeleteOrder], Mode=OneWay}" Command="{Binding DeleteOrderCommand}" Padding="10,4" Margin="2"/>
            <Separator/>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Padding="10,4"
                              AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalConfig], Mode=OneWay}"
                              ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalConfig], Mode=OneWay}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalConfig], Mode=OneWay}" VerticalAlignment="Center"/>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                      Width="8" Height="4" Stretch="Fill" Margin="6,2,0,0" VerticalAlignment="Center"
                                      SnapsToDevicePixels="True"/>
                            </StackPanel>
                        </MenuItem.Header>
                        
                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.CurrencySetting], Mode=OneWay}" Click="OnCurrencySettingClick"/>
                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Print], Mode=OneWay}">
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintReceipt], Mode=OneWay}" Click="OnPrintReceiptClick"
                                      IsEnabled="{Binding SelectedOrder, Converter={StaticResource NullToVisibility}, ConverterParameter=NotNull}"/>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.HeaderFooter], Mode=OneWay}" Click="OnEditBrandingClick"/>
                        </MenuItem>
                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.LocalDatabase], Mode=OneWay}">
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.CopyDataPath], Mode=OneWay}" Click="OnCopyDataPathClick"/>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.RevealDataFile], Mode=OneWay}" Click="OnRevealDataFileClick"/>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.OpenDataFolder], Mode=OneWay}" Click="OnOpenDataFolderClick"/>
                        </MenuItem>
                    </MenuItem>
                </Menu>
            <Separator/>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Refresh], Mode=OneWay}" Command="{Binding LoadOrdersCommand}"  Padding="10,4" Margin="2"/>
            <Separator/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.Language], Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox x:Name="LanguageSwitchBox" Width="130" Margin="2" VerticalAlignment="Center" SelectionChanged="OnLanguageChanged"/>
        </ToolBar>

        <!-- ── Main area ───────────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="35*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#D9DCE1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Search.Label], Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                        <TextBlock Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Filter.Status.Label], Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Grid.Column="3" Width="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value, Converter={StaticResource OrderStatusToLocalizedTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="4" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.PageSize], Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox Grid.Column="5" Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Filter.RecordFontSize], Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <Slider x:Name="RecordFontSizeSlider" Width="150" VerticalAlignment="Center"
                                    Minimum="12" Maximum="40" Value="20"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    SmallChange="1" LargeChange="2"/>
                            <TextBlock Text="{Binding Value, ElementName=RecordFontSizeSlider, StringFormat={}{0:0}px}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListView Grid.Row="1"
                          x:Name="OrdersListView"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          MouseDoubleClick="OnOrderRowDoubleClick"
                          KeyDown="OnOrderRowKeyDown"
                          SizeChanged="OnOrdersListSizeChanged"
                          GridViewColumnHeader.Click="OnOrderColumnHeaderClick"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource OrderListItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          BorderBrush="#DDD" BorderThickness="1">
                    <ListView.ContextMenu>
                        <ContextMenu Style="{StaticResource OrderContextMenuStyle}">
                            <MenuItem x:Name="EditContextMenuItem" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.EditOrder], Mode=OneWay}" Click="OnContextEditClick" Style="{StaticResource OrderMenuItemStyle}">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="13" Foreground="#2980B9"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.CopyOrder], Mode=OneWay}" Click="OnContextCopyClick" Style="{StaticResource OrderMenuItemStyle}">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="13" Foreground="#2980B9"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.DeleteOrder], Mode=OneWay}" Click="OnContextDeleteClick" Style="{StaticResource OrderMenuItemStyle}">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="13" Foreground="#C0392B"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Toolbar.PrintReceipt], Mode=OneWay}" Click="OnContextPrintClick" Style="{StaticResource OrderMenuItemStyle}">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" FontSize="13" Foreground="#2980B9"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource OrderListHeaderStyle}">
                            <GridViewColumn local:OrderColumnSort.SortKey="OrderNumber" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderNumber], Mode=OneWay}" Width="150" DisplayMemberBinding="{Binding OrderNumber}"/>
                            <GridViewColumn local:OrderColumnSort.SortKey="CustomerName" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.CustomerName], Mode=OneWay}" Width="170" DisplayMemberBinding="{Binding CustomerName}"/>
                            <GridViewColumn local:OrderColumnSort.SortKey="PhoneNumber" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PhoneNumber], Mode=OneWay}" Width="150" DisplayMemberBinding="{Binding PhoneNumber}"/>
                            <GridViewColumn local:OrderColumnSort.SortKey="OrderDate" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderDate], Mode=OneWay}" Width="130" DisplayMemberBinding="{Binding OrderDate, StringFormat=yyyy-MM-dd}"/>
                            <GridViewColumn local:OrderColumnSort.SortKey="Status" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Status], Mode=OneWay}" Width="110" DisplayMemberBinding="{Binding Status, Converter={StaticResource OrderStatusToLocalizedTextConverter}}"/>
                            <GridViewColumn local:OrderColumnSort.SortKey="TotalAmount" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TotalAmount], Mode=OneWay}" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                    <Binding Path="TotalAmount"/>
                                                    <Binding Path="CurrencyType"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn local:OrderColumnSort.SortKey="BalanceStatus" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.BalanceStatus], Mode=OneWay}" Width="140" DisplayMemberBinding="{Binding Converter={StaticResource OrderPaymentSummaryConverter}, ConverterParameter=Status}"/>
                            <GridViewColumn local:OrderColumnSort.SortKey="LastModifiedDate" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.LastModifiedDate], Mode=OneWay}" Width="170" DisplayMemberBinding="{Binding LastModifiedDate, StringFormat=yyyy-MM-dd HH:mm}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.Previous], Mode=OneWay}" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" Padding="10,4"/>
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Paging.Next], Mode=OneWay}" Command="{Binding NextPageCommand}" Padding="10,4"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- Detail panel (visible only when an order is selected) -->
            <ScrollViewer Grid.Column="2" Margin="0,8,8,8"
                          VerticalScrollBarVisibility="Auto"
                          Background="#EDF1F5"
                          Visibility="{Binding SelectedOrder, Converter={StaticResource NullToVisibility}}">
                <Border Background="White" CornerRadius="10" Margin="6" Padding="20"
                        BorderBrush="#E1E5EA" BorderThickness="1">
                <StackPanel>
                    <Border Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="#2980B9" BorderThickness="0,0,0,2">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.Title], Mode=OneWay}" FontSize="17" FontWeight="Bold" Foreground="#2C3E50"/>
                    </Border>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderNumber], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.OrderNumber}"   Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.CustomerName], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.CustomerName}"  Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PhoneNumber], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.PhoneNumber}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Email], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Email}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Address], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Address}" Margin="0,2,0,10" FontSize="13" TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.OrderDate], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.OrderDate, StringFormat='yyyy-MM-dd  HH:mm'}"
                               Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Status], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Status, Converter={StaticResource OrderStatusToLocalizedTextConverter}}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ServiceType], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder, Converter={StaticResource OrderServicesSummaryConverter}}" Margin="0,2,0,10" FontSize="13"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TotalAmount], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Margin="0,2,0,10" FontSize="14" FontWeight="Bold" Foreground="#27AE60">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                <Binding Path="SelectedOrder.TotalAmount"/>
                                <Binding Path="SelectedOrder.CurrencyType"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Deposit pair: nominal deposit + actually received deposit (incl. card tax). -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Downpayment], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#27AE60">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.TotalDownpayment"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ReceivedDownpayment], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#27AE60">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ReceivedDownpayment"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Final balance pair: outstanding residual + actually received balance (incl. card tax). -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.FinalBalance], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#C0392B">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.FinalBalance"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.ReceivedFinalBalance], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#27AE60">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ReceivedFinalBalance"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.BalanceStatus], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder, Converter={StaticResource OrderPaymentSummaryConverter}, ConverterParameter=Status}" Margin="0,2,0,10" FontSize="13" FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.PaymentBreakdown], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder, Converter={StaticResource OrderPaymentSummaryConverter}}" Margin="0,2,0,10" FontSize="12" TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Notes], Mode=OneWay}" Foreground="#777" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedOrder.Notes}"         Margin="0,2,0,10"
                               FontSize="13" TextWrapping="Wrap"/>

                    <Border BorderBrush="#8A929B" BorderThickness="0,0,0,2" Margin="0,10,0,10"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.OrderItems], Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Alterations service -->
                    <Border Style="{StaticResource DetailSectionCard}" Visibility="{Binding SelectedOrder.AlterationAddedToReceipt, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.Alterations], Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding SelectedOrder.ServiceDetails, Converter={StaticResource LocalizationLookupConverter}, ConverterParameter=Alteration.Category}" FontSize="12" TextWrapping="Wrap"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Subtotal], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                                <TextBlock Grid.Column="1" FontSize="12">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                            <Binding Path="SelectedOrder.AlterationSubtotal"/>
                                            <Binding Path="SelectedOrder.CurrencyType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,2,0,0" Visibility="{Binding SelectedOrder.AlterationTax, Converter={StaticResource PositiveAmountToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TaxAmount], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                                <TextBlock Grid.Column="1" FontSize="12">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                            <Binding Path="SelectedOrder.AlterationTax"/>
                                            <Binding Path="SelectedOrder.CurrencyType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Receipt.SectionTotal], Mode=OneWay}" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                            <Binding Path="SelectedOrder.AlterationTotal"/>
                                            <Binding Path="SelectedOrder.CurrencyType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Ready-made clothing / accessory -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DetailSectionCard}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOrder.ClothingAddedToReceipt}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OrderEdit.Panel.ReadyMade], Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" Padding="0,8">
                                    <Border.BorderThickness>
                                        <MultiBinding Converter="{StaticResource LastItemBorderThickness}">
                                            <Binding/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Items"/>
                                        </MultiBinding>
                                    </Border.BorderThickness>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName, Converter={StaticResource LocalizationLookupConverter}, ConverterParameter=ClothingItem}" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="#666">
                                                <Run Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.QuantityPrefix], Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Quantity}"/>
                                                <Run Text="  ×  "/>
                                                <Run>
                                                    <Run.Text>
                                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                            <Binding Path="EffectiveUnitPrice" Mode="OneWay"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedOrder.CurrencyType"/>
                                                        </MultiBinding>
                                                    </Run.Text>
                                                </Run>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock FontWeight="Bold">
                                                <Run>
                                                    <Run.Text>
                                                        <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                            <Binding Path="TotalPrice" Mode="OneWay"/>
                                                            <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedOrder.CurrencyType"/>
                                                        </MultiBinding>
                                                    </Run.Text>
                                                </Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.Subtotal], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ClothingSubtotal"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,2,0,0" Visibility="{Binding SelectedOrder.ClothingTax, Converter={StaticResource PositiveAmountToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TaxAmount], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ClothingTax"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Receipt.SectionTotal], Mode=OneWay}" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.ClothingTotal"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Custom-made service -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DetailSectionCard}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOrder.CustomMadeAddedToReceipt}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Detail.CustomMadeRecords], Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding SelectedOrder.CustomMadeRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" Padding="0,8">
                                    <Border.BorderThickness>
                                        <MultiBinding Converter="{StaticResource LastItemBorderThickness}">
                                            <Binding/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="Items"/>
                                        </MultiBinding>
                                    </Border.BorderThickness>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Converter={StaticResource CustomMadeRecordSummaryConverter}}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold">
                                            <Run>
                                                <Run.Text>
                                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                        <Binding Path="SumTotal" Mode="OneWay"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.SelectedOrder.CurrencyType"/>
                                                    </MultiBinding>
                                                </Run.Text>
                                            </Run>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        <Grid Margin="0,6,0,0" Visibility="{Binding SelectedOrder.CustomMadeTax, Converter={StaticResource PositiveAmountToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Order.Fields.TaxAmount], Mode=OneWay}" FontSize="12" Foreground="#666"/>
                            <TextBlock Grid.Column="1" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.CustomMadeTax"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Receipt.SectionTotal], Mode=OneWay}" FontSize="12" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                        <Binding Path="SelectedOrder.CustomMadeTotal"/>
                                        <Binding Path="SelectedOrder.CurrencyType"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</Window>
