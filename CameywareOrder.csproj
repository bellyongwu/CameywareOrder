<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\ICONS\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required to embed an ASP.NET Core (Kestrel) host inside WPF -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The assertion harnesses live in Tests/ and must NOT be compiled into the application.

      This project sits at the repository root and the SDK globs **/*.cs from there, so without these
      removals every harness — with its own Main, its reflection into private methods and its
      fixture data — would be swept into the shipped executable. It would not even fail to build
      loudly: it would produce an app with several entry points and a compiler error about which one
      to use, which reads as a project-file problem rather than what it is.
    -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <Resource Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="13.9.14" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="13.9.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="QuestPDF" Version="2024.7.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped configuration: the per-language string tables and the system defaults. A glob
         rather than a list of files, so adding a language is dropping zh-TW.lang.xml into
         Settings/System/Languages with no project edit — which is the point of the folder.
         Read-only at runtime; anything the application writes lives under %LOCALAPPDATA%. -->
    <None Update="Settings\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ICONS\app-icon.ico" />
    <Resource Include="Assets\WELCOME PANEL\welcome_header_enter_system.jpg" />
  </ItemGroup>

</Project>
