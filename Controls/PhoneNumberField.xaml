<UserControl x:Class="CameywareOrder.Controls.PhoneNumberField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A phone field that says which country the number is from: the dial code in front, in a picker
         showing each country's flag, and the national number beside it.

         The picker is per-NUMBER, not per-shop. The shop's location only decides what it OPENS on —
         a Toronto shop takes a visiting customer's Shanghai mobile, and a control that could only be
         Canadian would refuse a correct number. Everything else about the behaviour is in the
         code-behind, which owns the one rule; see PhoneNumberField.xaml.cs. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Wide enough for the longest dial code beside the widest Country.* name. -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="CountryBox" Grid.Column="0" MinWidth="112" Margin="0,0,8,0"
                  VerticalContentAlignment="Center" SelectionChanged="OnCountryChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <!-- The border is what makes a white-heavy flag (Japan) read as a flag rather
                             than as a gap in the row. -->
                        <Border BorderBrush="#D8DEE6" BorderThickness="1" SnapsToDevicePixels="True"
                                VerticalAlignment="Center" Margin="0,0,7,0">
                            <Image Source="{Binding Flag}" Width="20" Height="14" Stretch="Fill"/>
                        </Border>
                        <TextBlock Text="{Binding DialCode}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox x:Name="NumberBox" Grid.Column="1" TextChanged="OnNumberChanged" LostFocus="OnNumberLostFocus"
                 PreviewKeyDown="OnNumberPreviewKeyDown"/>
    </Grid>
</UserControl>
